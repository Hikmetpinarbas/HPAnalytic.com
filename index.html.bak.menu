<script id="preloader-count-script">
(function(){
  var el = document.querySelector('.pre-count');
  if (el) {
    var t0 = performance.now();
    setTimeout(function(){
      requestAnimationFrame(function tick(now){
        var p = Math.min((now - t0) / 1200, 1);
        el.textContent = Math.round(p * 100) + '%';
        if (p < 1) requestAnimationFrame(tick);
      });
    }, 250);
  }
  setTimeout(function(){
    var pre = document.getElementById('preloader');
    if (pre) pre.remove();
  }, 2500);
})();
</script>
