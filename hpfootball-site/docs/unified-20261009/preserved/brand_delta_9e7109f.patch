 .prose > * { max-width: 100%; }
+
+/* Brand/Product candidate: let an admitted article show its actual evidence object. */
+.featured-evidence-object{
+  width:min(100%,580px);margin:28px 0 4px;
+  border:1px solid rgba(200,149,69,.24);
+  background:linear-gradient(145deg,rgba(240,201,119,.055),#08090a 54%);
+  overflow:hidden;
+}
+.featured-evidence-object img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:contain}
+.featured-evidence-object figcaption{
+  display:grid;gap:7px;padding:14px 18px;
+  border-top:1px solid var(--line);color:var(--muted);
+  font-size:12px;line-height:1.5;overflow-wrap:anywhere;
+}
+.featured-evidence-object figcaption b{font-size:12px;letter-spacing:.15em;color:var(--gold-2)}
+@media(max-width:560px){
+  .featured-evidence-object{margin:22px 0 2px}
+  .featured-evidence-object figcaption{padding:12px 14px}
+}
diff --git a/hpfootball-site/tests/home-featured-evidence-object.test.mjs b/hpfootball-site/tests/home-featured-evidence-object.test.mjs
new file mode 100644
index 0000000..7bb6270
--- /dev/null
+++ b/hpfootball-site/tests/home-featured-evidence-object.test.mjs
@@ -0,0 +1,20 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const home = readFileSync(new URL('../src/pages/index.astro', import.meta.url), 'utf8');
+const css = readFileSync(new URL('../src/styles/global.css', import.meta.url), 'utf8');
+
+test('featured approved event-data article exposes its existing conceptual evidence object', () => {
+  assert.match(home, /featuredStory\.id === 'event-only-boundary'/);
+  assert.match(home, /class="featured-evidence-object"/);
+  assert.match(home, /\/visuals\/event-data\/evidence-surfaces\.svg/);
+  assert.match(home, /KAVRAMSAL ŞEMA/);
+  assert.match(home, /GERÇEK MAÇ VERİSİ DEĞİL/);
+});
+
+test('featured evidence object is responsive, legible, and bounded', () => {
+  assert.match(css, /\.featured-evidence-object\{/);
+  assert.match(css, /\.featured-evidence-object img\{/);
+  assert.match(css, /@media\(max-width:560px\)[\s\S]*\.featured-evidence-object/);
+});
