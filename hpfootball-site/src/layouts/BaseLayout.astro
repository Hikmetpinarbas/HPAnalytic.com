---
import { isPublic } from '../lib/public-content.mjs';
import { isPublicEditorialItem } from '../lib/site-editorial-status.mjs';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { buildVisibleNavigation, buildUtilityNavigation, currentState, SECTION_ROUTES } from '../lib/site-surfaces.mjs';
import MobileNavigation from '../components/MobileNavigation.astro';
import Logo from '../components/Logo.astro';
import EditorialHeader from '../components/layout/EditorialHeader.astro';
import NavigationIcon from '../components/NavigationIcon.astro';
import { canonicalPath } from '../lib/canonical-path.mjs';

interface Props {
  title?: string;
  description?: string;
  section?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}

const SITE_NAME = 'HPAnalytic';
const {
  title = 'HPAnalytic — Futbol Analizi ve Kanıt',
  description = 'HPAnalytic: Hikmet Pınarbaş tarafından futbolu mekanizma, kanıt ve bağlam üzerinden okuyan bağımsız analiz ve araştırma yayını.',
  section,
  ogType = 'website',
  publishedTime,
  noindex = false,
} = Astro.props as Props;

const articles = (await getCollection('articles', isPublic)).filter((entry) => isPublicEditorialItem(entry.data));
const research = (await getCollection('research', isPublic)).filter((entry) => isPublicEditorialItem(entry.data));
const visuals = (await getCollection('visuals', isPublic)).filter((entry) => isPublicEditorialItem(entry.data));

const articleSections: Record<string, number> = {};
for (const article of articles) {
  const articleSection = article.data.section;
  articleSections[articleSection] = (articleSections[articleSection] || 0) + 1;
}

const pathname = Astro.url.pathname;
const sectionRoute = section ? SECTION_ROUTES[section as keyof typeof SECTION_ROUTES] : undefined;
const withCurrent = (items: { href: string; label: string }[]) =>
  items.map((item) => ({
    ...item,
    current: (currentState(item.href, pathname) ?? (item.href === sectionRoute ? 'true' : undefined)) as 'page' | 'true' | undefined,
  }));

const navigation = withCurrent(buildVisibleNavigation({
  articleSections,
  researchCount: research.length,
  visualCount: visuals.length,
}));
const utility = withCurrent(buildUtilityNavigation({ articleCount: articles.length }));
const archiveLink = utility.find((item) => item.href === '/archive');
const searchLink = utility.find((item) => item.href === '/search');
const canonical = new URL(canonicalPath(pathname), Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="tr" class="no-js">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<script is:inline>document.documentElement.classList.replace('no-js','js');</script>
<script is:inline>
{
  const url = new URL(window.location.href);
  const removable = [...url.searchParams.keys()].filter((key) =>
    key.toLowerCase().startsWith('utm_') || ['fbclid','gclid','dclid','msclkid'].includes(key.toLowerCase())
  );
  if (removable.length) {
    removable.forEach((key) => url.searchParams.delete(key));
    history.replaceState(history.state, '', url.pathname + (url.search ? url.search : '') + url.hash);
  }
}
</script>
<title>{title}</title>
<meta name="description" content={description}/>
<link rel="canonical" href={canonical}/>
{noindex && <meta name="robots" content="noindex"/>}
<meta property="og:site_name" content={SITE_NAME}/>
<meta property="og:type" content={ogType}/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={canonical}/>
<meta property="og:locale" content="tr_TR"/>
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()}/>}
<meta property="og:image" content={new URL("/social-card.png", Astro.site ?? Astro.url).href}/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content="HPAnalytic — Evidence Made Visible"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:image" content={new URL("/social-card.png", Astro.site ?? Astro.url).href}/>
<meta name="theme-color" content="#F5F1E8"/>
<meta name="application-name" content="HPAnalytic"/>
<meta name="mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-title" content="HPAnalytic"/>
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="manifest" href="/manifest.webmanifest"/>
<link rel="apple-touch-icon" href="/icons/hp-192.png"/>
<slot name="head"/>
<script is:inline>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
  });
}
</script>
</head>
<body>
<a class="skip-link" href="#main-content">İçeriğe geç</a>
<div class="grain" aria-hidden="true"></div>
<EditorialHeader>
  <div class="header-actions">
    {searchLink && <a class="icon-link" href={searchLink.href} aria-current={searchLink.current} aria-label="Ara">ARA</a>}
    <MobileNavigation navigation={archiveLink ? [...navigation, archiveLink] : navigation} />
  </div>
</EditorialHeader>
<main id="main-content" tabindex="-1"><slot/></main>
<footer class="site-footer">
  <div class="footer-grid">
    <div><Logo /><p class="footer-statement">Skoru değil, skoru üreten mekanizmayı okuruz. Kanıtın taşıyabildiğinden güçlü konuşmayız.</p></div>
    <nav class="footer-nav" aria-label="Site bölümleri"><h2>BÖLÜMLER</h2><ul>{[...navigation].map(item=><li><a href={item.href}>{item.label}</a></li>)}</ul></nav>
    {utility.length > 0 && (<nav class="footer-nav" aria-label="Site araçları"><h2>ARAÇLAR</h2><ul>{utility.map(item=><li><a href={item.href}>{item.label}</a></li>)}</ul></nav>)}
  </div>
  <div class="footer-base"><span>© {new Date().getFullYear()} Hikmet Pınarbaş · HPAnalytic</span><span>Güvenden önce kanıt.</span></div>
</footer>
<script is:inline>
/* HPAnalytic motion: finite, one-shot effects. No polling and no background loops. */
(() => {
  if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const targets = document.querySelectorAll('.featured-analysis,.research-spotlight,.scouting-spotlight,.mechanism-card,.section-heading');
  const observer = new IntersectionObserver((entries, self) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      entry.target.classList.add('hp-motion-observed');
      self.unobserve(entry.target);
    }
  }, { rootMargin: '0px 0px -32px 0px', threshold: 0.06 });
  for (const el of targets) observer.observe(el);
})();
</script>
</body>
</html>
