---
import { isPublic } from '../lib/public-content.mjs';
import { isPublicEditorialItem } from '../lib/site-editorial-status.mjs';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { buildVisibleNavigation, buildUtilityNavigation, currentState, SECTION_ROUTES } from '../lib/site-surfaces.mjs';
import MobileNavigation from '../components/MobileNavigation.astro';
import Logo from '../components/Logo.astro';
import EditorialHeader from '../components/EditorialHeader.astro';
import NavigationIcon from '../components/NavigationIcon.astro';
import { canonicalPath } from '../lib/canonical-path.mjs';
import { MOBILE_MENU } from '../lib/site-menu.mjs';

interface Props {
  title?: string;
  description?: string;
  section?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
  club?: 'fenerbahce' | 'galatasaray' | 'besiktas' | 'trabzonspor';
}

const SITE_NAME = 'HPAnalytic';
const {
  title = 'HPAnalytic — Futbol Analizi ve Kanıt',
  description = 'HPAnalytic: Hikmet Pınarbaş tarafından futbolu mekanizma, kanıt ve bağlam üzerinden okuyan bağımsız analiz ve araştırma yayını.',
  section,
  ogType = 'website',
  publishedTime,
  noindex = false,
  club,
} = Astro.props as Props;

const articles = (await getCollection('articles', isPublic)).filter((entry) => isPublicEditorialItem(entry.data));
const research = (await getCollection('research', isPublic)).filter((entry) => isPublicEditorialItem(entry.data));
const visuals = (await getCollection('visuals', isPublic)).filter((entry) => isPublicEditorialItem(entry.data));

const articleSections: Record<string, number> = {};
for (const article of articles) {
  const articleSection = article.data.section;
  articleSections[articleSection] = (articleSections[articleSection] || 0) + 1;
}

const pathname = Astro.url.pathname;
const sectionRoute = section ? SECTION_ROUTES[section as keyof typeof SECTION_ROUTES] : undefined;
const withCurrent = <T extends { href: string; label: string }>(items: T[]) =>
  items.map((item) => ({
    ...item,
    current: (currentState(item.href, pathname) ?? (item.href === sectionRoute ? 'true' : undefined)) as 'page' | 'true' | undefined,
  }));

const navigation = withCurrent(buildVisibleNavigation({
  articleSections,
  researchCount: research.length,
  visualCount: visuals.length,
}));
const utility = withCurrent(buildUtilityNavigation({ articleCount: articles.length }));
const archiveLink = utility.find((item) => item.href === '/archive');
const NAV_ITEMS = MOBILE_MENU.map((item) => ({ label: item.label, href: item.href, text: item.text }));
const editorialNavigation = withCurrent(NAV_ITEMS);

const searchLink = utility.find((item) => item.href === '/search');
const canonical = new URL(canonicalPath(pathname), Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="tr" class="no-js">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<script is:inline>document.documentElement.classList.replace('no-js','js');</script>
<script is:inline>
{
  const url = new URL(window.location.href);
  const removable = [...url.searchParams.keys()].filter((key) =>
    key.toLowerCase().startsWith('utm_') || ['fbclid','gclid','dclid','msclkid'].includes(key.toLowerCase())
  );
  if (removable.length) {
    removable.forEach((key) => url.searchParams.delete(key));
    history.replaceState(history.state, '', url.pathname + (url.search ? url.search : '') + url.hash);
  }
}
</script>
<title>{title}</title>
<meta name="description" content={description}/>
<link rel="canonical" href={canonical}/>
{noindex && <meta name="robots" content="noindex"/>}
<meta property="og:site_name" content={SITE_NAME}/>
<meta property="og:type" content={ogType}/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={canonical}/>
<meta property="og:locale" content="tr_TR"/>
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()}/>}
<meta property="og:image" content={new URL("/social-card.png", Astro.site ?? Astro.url).href}/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content="HPAnalytic — Evidence Made Visible"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:image" content={new URL("/social-card.png", Astro.site ?? Astro.url).href}/>
<meta name="theme-color" content={club === 'fenerbahce' ? '#06112A' : '#08090B'}/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500&family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=IBM+Plex+Mono:wght@400;500&display=swap"/>
<meta name="application-name" content="HPAnalytic"/>
<meta name="mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-title" content="HPAnalytic"/>
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="manifest" href="/manifest.webmanifest"/>
<link rel="apple-touch-icon" href="/icons/hp-192.png"/>
<slot name="head"/>
<script is:inline>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
  });
}
</script>
</head>
<body data-club={club}>
<a class="skip-link" href="#main-content">İçeriğe geç</a>
<EditorialHeader navigation={editorialNavigation}>
  <div class="header-actions">
    <MobileNavigation navigation={editorialNavigation} />
  </div>
</EditorialHeader>
<main id="main-content" tabindex="-1"><slot/></main>
<footer class="site-footer">
  <div class="footer-grid">
    <div><Logo variant="footer" /><p class="footer-statement">Skoru değil, skoru üreten mekanizmayı okuruz. Kanıtın taşıyabildiğinden güçlü konuşmayız.</p></div>
    <nav class="footer-nav" aria-label="Site bölümleri"><h2>Bölümler</h2><ul>{[...navigation, {href:'/monographs',label:'MONOGRAFİLER'}].map(item=><li><a href={item.href}>{item.label}</a></li>)}</ul></nav>
    {utility.length > 0 && (<nav class="footer-nav" aria-label="Site araçları"><h2>Araçlar</h2><ul>{utility.map(item=><li><a href={item.href}>{item.label}</a></li>)}<li><a href="/reading-list">OKUMA LİSTESİ</a></li></ul></nav>)}
  </div>
  <div class="footer-base"><span>© {new Date().getFullYear()} Hikmet Pınarbaş · HPAnalytic</span><span>Güvenden önce kanıt.</span></div>
</footer>
<script is:inline>
/* HPAnalytic motion: one-shot reveals. Content is visible at rest; this only adds an entrance. */
(() => {
  const targets = document.querySelectorAll('.reveal');
  const show = (el) => el.classList.add('is-in');
  if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) { targets.forEach(show); return; }
  const observer = new IntersectionObserver((entries, self) => {
    for (const entry of entries) { if (!entry.isIntersecting) continue; show(entry.target); self.unobserve(entry.target); }
  }, { rootMargin: '0px 0px -24px 0px', threshold: 0.04 });
  targets.forEach((el) => observer.observe(el));
  window.setTimeout(() => targets.forEach(show), 2500);
})();
</script>
</body>
</html>
