---
import {getCollection,render} from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import EvidenceBadge from '../../components/EvidenceBadge.astro';
export async function getStaticPaths(){const items=await getCollection('articles');return items.map(a=>({params:{id:a.id},props:{a}}))}
const {a}=Astro.props; const {Content}=await render(a);
---
<BaseLayout title={a.data.title+' — HP Football'} description={a.data.description}><main class="article-page"><p class="kicker">{a.data.section.toUpperCase()}</p><h1>{a.data.title}</h1><p class="standfirst">{a.data.description}</p><EvidenceBadge evidenceClass={a.data.evidenceClass} claimCeiling={a.data.claimCeiling}/><article class="prose"><Content/></article></main></BaseLayout>