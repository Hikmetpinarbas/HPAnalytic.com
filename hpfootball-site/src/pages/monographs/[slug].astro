---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection, render} from 'astro:content';
export const prerender = true;
export async function getStaticPaths(){
  const items=await getCollection('monographs',({data})=>!data.draft);
  return items.map(item=>({params:{slug:item.id},props:{item}}));
}
const {item}=Astro.props;
const {Content}=await render(item);
---
<BaseLayout title={`${item.data.title} — HPAnalytic`} description={item.data.description}>
  <article class="monograph-reading">
    <p class="kicker">MONOGRAFİ · {item.data.category}</p>
    <h1>{item.data.title}</h1>
    {item.data.subtitle && <p class="monograph-subtitle">{item.data.subtitle}</p>}
    <p class="monograph-meta">{item.data.author} · {item.data.readingTime} · {item.data.date.toLocaleDateString('tr-TR')}</p>
    <p class="monograph-evidence">{item.data.evidenceLevel} · {item.data.claimCeiling}</p>
    <div class="monograph-body"><Content /></div>
  </article>
</BaseLayout>
<style>
.monograph-reading{max-width:820px;margin:0 auto;padding:clamp(30px,6vw,80px) 20px}
.monograph-reading h1{font:500 clamp(30px,4vw,54px)/1.15 Newsreader,Georgia,serif}
.monograph-subtitle{font:italic 22px/1.4 Newsreader,Georgia,serif}
.monograph-meta,.monograph-evidence{font:12px/1.7 "IBM Plex Mono",monospace;color:#4A554E}
.monograph-evidence{border-block:1px solid #8EA58B;padding:10px 0}
.monograph-body{font:18px/1.8 Georgia,serif}
</style>
