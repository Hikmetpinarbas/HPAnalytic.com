---
import BaseLayout from '../layouts/BaseLayout.astro';
import TacticalCanvas from '../components/TacticalCanvas.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Button from '../components/Button.astro';
import { getCollection } from 'astro:content';
export const prerender = true;

const articles = (await getCollection('articles')).sort((a, b) => +b.data.date - +a.data.date);
const hasAnalysis = articles.some((a) => a.data.section === 'analysis');
const pipeline = [
  ['HPA', 'OPERATIONAL EVIDENCE'],
  ['HPFA', 'EVIDENCE AUTHORITY'],
  ['HIO', 'MECHANISM LENS'],
  ['YELL', 'SAFE FINDING'],
];
---
<BaseLayout title="HPAnalytic — Football Intelligence by Hikmet Pınarbaş">
<section class="hero" aria-labelledby="hero-title">
  <div>
    <p class="kicker">FOOTBALL INTELLIGENCE BY HİKMET PINARBAŞ</p>
    <h1 id="hero-title">STRUCTURE.<br/><em>RELATION.</em><br/>DECISION.</h1>
    <p class="lead">Futbolu skorun öncesinde kurulan ilişkiler, mekanizmalar, zaman ve bağlam üzerinden okuyan bağımsız analiz platformu.</p>
    {articles.length > 0 && (
      <div class="button-row">
        {hasAnalysis && <Button href="/analysis" variant="primary">READ ANALYSIS</Button>}
        <Button href="/archive" variant={hasAnalysis ? 'secondary' : 'primary'}>EXPLORE ARCHIVE</Button>
      </div>
    )}
  </div>
  <TacticalCanvas id="hero-diagram" />
</section>
<ul class="principles" aria-label="İlkeler">
  <li>FOOTBALL FIRST</li>
  <li>EVIDENCE BEFORE CONFIDENCE</li>
  <li>MECHANISM BEFORE METRIC</li>
  <li>CONTEXT BEFORE VERDICT</li>
</ul>
<section class="section" aria-labelledby="pipeline-title">
  <div class="section-head">
    <p class="kicker">CURRENT INTELLIGENCE</p>
    <h2 id="pipeline-title">Postmatch first.</h2>
    <p class="intro">Ciddi analiz doğrudan metne dönüşmez. HPA operasyonel yüzeyi kurar; HPFA claim sınırını denetler; HIO mekanizma katmanını zorlar; YELL güvenli bulguyu insan diline taşır.</p>
  </div>
  <ol class="pipeline">
    {pipeline.map(([name, role]) => <li><b>{name}</b><span>{role}</span></li>)}
  </ol>
</section>
{articles.length > 0 && (
  <section class="section" aria-labelledby="latest-title">
    <div class="section-head">
      <p class="kicker">LATEST</p>
      <h2 id="latest-title">Living football archive.</h2>
    </div>
    <ul class="card-grid">
      {articles.slice(0, 6).map((a) => (
        <li><ArticleCard id={a.id} {...a.data} /></li>
      ))}
    </ul>
    <div class="section-foot"><Button href="/archive" variant="quiet">FULL ARCHIVE</Button></div>
  </section>
)}
</BaseLayout>
