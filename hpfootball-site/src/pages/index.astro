---
import { isPublic } from '../lib/public-content.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCartography from '../components/HeroCartography.astro';
import InteractiveHeroRail from '../components/InteractiveHeroRail.astro';
import MethodologyTrinity from '../components/MethodologyTrinity.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import {getCollection} from 'astro:content';
import {isPublicEditorialItem} from '../lib/site-editorial-status.mjs';
import {getUpcomingMatches, FOOTBALL_SCOPE} from '../lib/football-data.mjs';
import {validMatchRows, shouldShowMatchCentre, heroPrimaryCta, launchDirectoryLinks} from '../lib/home-surfaces.mjs';
export const prerender = true;

const featuredMonographs=(await getCollection('monographs',isPublic)).sort((a,b)=>+b.data.date-+a.data.date).slice(0,3);
const articles=(await getCollection('articles',isPublic)).filter(entry=>isPublicEditorialItem(entry.data)).sort((a,b)=>+b.data.date-+a.data.date);
const hikmetEditorial=articles.find(a=>a.data.section==='culture');
const readingDesk=articles.filter(a=>a.data.section==='analysis' || a.data.section==='scouting' || a.data.section==='culture').slice(0,3);
const featuredStory=articles.find(a=>a.data.section==='analysis' && a.data.featured) ?? articles.find(a=>a.data.featured) ?? articles[0];
const footballToken=import.meta.env.HPA_FOOTBALL_DATA_TOKEN;
const matchCentre=await getUpcomingMatches({token:footballToken});
type MatchCentreItem={competition:string;utcDate:string;home:string;away:string;status:string};
const matchRows=validMatchRows(matchCentre) as MatchCentreItem[];
const showMatchCentre=shouldShowMatchCentre(matchCentre);
const publicAnalysisCount=articles.filter(a=>a.data.section==='analysis').length;
const primaryCta=heroPrimaryCta(publicAnalysisCount);
const directoryLinks=launchDirectoryLinks(publicAnalysisCount);
const matchTime=(utcDate:string)=>new Intl.DateTimeFormat('tr-TR',{timeZone:'Europe/Istanbul',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}).format(new Date(utcDate));
---
<BaseLayout title="HPAnalytic — Hikmet Pınarbaş Futbol Analizi" description="Hikmet Pınarbaş'tan kanıt, mekanizma ve bağlam temelli bağımsız futbol analizi.">
<div class="editorial-home-stage"><HeroCartography/><MethodologyTrinity/></div>
<InteractiveHeroRail />
<section class="analysis-rail" aria-labelledby="analysis-rail-title">
  <p class="kicker">HPANALYTIC · EVIDENCE LAB</p>
  <h2 id="analysis-rail-title" class="analysis-rail__heading">ARAŞTIRMA VİTRİNİ</h2>
  <div class="analysis-rail__track" tabindex="0" aria-label="Yatay kaydırılabilir araştırma kartları">
    {featuredMonographs.filter(item => item.id.startsWith('g01-') || item.id.startsWith('g02-')).map(item => <article class="analysis-rail__card">
      <span class="analysis-rail__meta">{item.id.startsWith('g01-') ? 'MEKÂNSAL ANALİZ' : 'YÖNTEMSEL ÇERÇEVE'} · {item.data.readingTime}</span>
      <h3>{item.id.startsWith('g01-') ? 'Bakıyorlar Ama Görmüyorlar (Olay Verisinde Algı Körlüğü)' : 'Israrla Görmezden Gelme (Spatiotemporal Mekanik)'}</h3>
      <p>{item.data.subtitle ?? item.data.description}</p>
      <a href={`/monographs/${item.id}`}>ARAŞTIRMAYI OKU →</a>
    </article>)}
    <article class="analysis-rail__card">
      <span class="analysis-rail__meta">EDİTORYAL ÖNERİ · YAYIN BEKLİYOR</span>
      <h3>Halkın Metrikleri: xG ve xT Neyi Gizler?</h3>
      <p>Araştırma sorusu kayıtlıdır; doğrulanmış monografi metni ve kaynak incelemesi henüz bulunmadığından yayın bağlantısı ve okuma süresi sunulmaz.</p>
    </article>
  </div>
</section>

{featuredMonographs.length > 0 && <section class="reading-desk" aria-labelledby="monographs-title">
  <header class="reading-desk-head"><div><p class="kicker">ARAŞTIRMA · MONOGRAFİLER</p><h2 id="monographs-title">ÖNE ÇIKAN ARAŞTIRMALAR</h2></div></header>
  <div class="reading-desk-grid">{featuredMonographs.map((item)=><article class="reading-desk-item">
    <span class="reading-desk-number">{item.data.category} · {item.data.readingTime}</span>
    <h3><a href={`/monographs/${item.id}`}>{item.data.title}</a></h3>
    <p>{item.data.subtitle ?? item.data.description}</p>
    <small>{item.data.author} · {item.data.evidenceLevel}</small>
  </article>)}</div>
</section>}
{readingDesk.length > 0 && <section class="reading-desk" aria-labelledby="reading-desk-title">
  <header class="reading-desk-head"><div><p class="kicker">OKUMA MASASI · GÜNCEL SEÇKİ</p><h2 id="reading-desk-title">BUGÜN NEYİ ANLAMAYA DEĞER?</h2><p>Yeni bir iddia üretmeden, yayımlanmış ve editoryal kabulden geçmiş dosyalardan seçki.</p></div><a href="/archive" class="story-link">TÜM DOSYALAR →</a></header>
  <div class="reading-desk-grid">{readingDesk.map((item,i)=><article class="reading-desk-item"><span class="reading-desk-number">{String(i+1).padStart(2,'0')} / {item.data.section.toUpperCase()}</span><h3><a href={`/articles/${item.id}`}>{item.data.title}</a></h3><p>{item.data.description}</p><small>{item.data.date.toLocaleDateString('tr-TR')}</small></article>)}</div>
</section>}

{featuredStory && <section class="featured-analysis" aria-labelledby="featured-title">
  <div class="featured-index"><span>01</span><p>YENİ · KANIT NESNESİ</p></div>
  <div class="featured-story">
    <EvidenceBadge evidenceClass={featuredStory.data.evidenceClass} claimCeiling={featuredStory.data.claimCeiling}/>
    <p class="featured-meta">{featuredStory.data.section.toUpperCase()} · {featuredStory.data.date.toLocaleDateString('tr-TR')}</p>
    <h2 id="featured-title">{featuredStory.data.title}</h2>
    <p>{featuredStory.data.description}</p>
    <a href={`/articles/${featuredStory.id}`} class="story-link">YAZIYI VE KANITI AÇ <span aria-hidden="true">→</span></a>
  </div>
  <aside class="featured-question"><small>OYUNUN ANAHTARI</small><p>Bir aksiyonun değeri, öncesiyle ve sonrasıyla kurduğu ilişkide saklıdır.</p></aside>
</section>}

{hikmetEditorial && <section class="hikmet-spotlight" aria-labelledby="hikmet-spotlight-title">
  <div class="hikmet-spotlight__meta"><p class="kicker">HİKMET’TEN · OYUN KÜLTÜRÜ</p><span>EDİTORYAL BAKIŞ</span></div>
  <div class="hikmet-spotlight__body"><h2 id="hikmet-spotlight-title">{hikmetEditorial.data.title}</h2><p class="hikmet-statement">{hikmetEditorial.data.description}</p><a class="story-link" href={`/articles/${hikmetEditorial.id}`}>YAZIYI OKU <span aria-hidden="true">→</span></a></div>
</section>}
<section class="launch-directory" aria-labelledby="launch-directory-title">
  <div class="launch-directory__intro"><p class="kicker">HPANALYTIC · KEŞİF</p><h2 id="launch-directory-title">FUTBOLU BİR SORUDAN OKUMAYA BAŞLA.</h2><p>{publicAnalysisCount > 0 ? 'Yayımlanmış analizden arşive, araştırma ve karar destek laboratuvarı yöntem notlarına geç.' : 'Yayımlanmış dosyalardan arşive, araştırma ve karar destek laboratuvarı yöntem notlarına geç.'}</p></div>
  <nav class="launch-directory__links" aria-label="İçeriği keşfet">
    {directoryLinks.map(link=><a href={link.href}><span>{link.index} / {link.kind}</span><b>{link.title}</b><small>{link.note}</small><span aria-hidden="true">↗</span></a>)}
  </nav>
</section>
{showMatchCentre && <section class="match-centre" aria-labelledby="match-centre-title">
  <header class="match-centre-head"><div><p class="kicker">MAÇ MERKEZİ · 7 GÜNLÜK PENCERE</p><h2 id="match-centre-title">GELECEK MAÇLAR</h2><p>Beş Büyük Lig + UEFA + Türkiye kapsamındaki yakın futbol takvimi. Yalnız doğrulanmış kaynak verisi gösterilir.</p></div><div class="match-source"><span class="source-ready">KAYNAK HAZIR</span><small>{matchCentre.source} · Europe/Istanbul</small></div></header>
  <div class="scope-strip" aria-label="HPAnalytic futbol kapsamı">{FOOTBALL_SCOPE.labels.map(label=><span>{label}</span>)}</div>
  <div class="fixture-list">{matchRows.map((m:MatchCentreItem,i:number)=><article class="fixture-row"><span class="fixture-index">{String(i+1).padStart(2,'0')}</span><div class="fixture-meta"><small>{m.competition}</small><time datetime={m.utcDate}>{matchTime(m.utcDate)}</time></div><div class="fixture-teams"><b>{m.home}</b><span>—</span><b>{m.away}</b></div><span class="fixture-status">{m.status}</span></article>)}</div>
</section>}
<section class="evidence-bridge" aria-labelledby="evidence-bridge-title">
  <div class="evidence-bridge__head">
    <p class="kicker">KANITTAN AÇIKLAMAYA</p>
    <h2 id="evidence-bridge-title">AKSİYONU GÖR.<br/><em>MEKANİZMAYI ÇÖZ.</em></h2>
    <p>HPAnalytic bir futbol sorusunu bağlam, aksiyon, süreç ve rakip yanıtı üzerinden inceler.</p>
  </div>
  <div class="evidence-bridge__flow" aria-label="HPAnalytic kanıt sunum modeli">
    <div><span>01</span><b>BAĞLAM</b><p>Maçın ve aksiyonun hangi koşulda oluştuğu.</p></div>
    <div><span>02</span><b>GÖZLENEN</b><p>Veri veya görüntünün gerçekten taşıdığı bulgu.</p></div>
    <div><span>03</span><b>MEKANİZMA?</b><p>Kanıtın desteklediği açıklama; otomatik hüküm değil.</p></div>
    <div><span>04</span><b>KARŞI KANIT</b><p>İlk açıklamayı zayıflatan veya başka yöne açan bulgu.</p></div>
    <div><span>05</span><b>ANALİST YORUMU</b><p>Bulgunun oyuna ve karar süreçlerine anlamı.</p></div>
  </div>
</section>
<section class="research-spotlight" aria-labelledby="research-title">
  <div class="research-intro">
    <p class="kicker">ARAŞTIRMA · KANIT MASASI</p>
    <h2 id="research-title">ARAŞTIRMA<br/>MASASI</h2>
    <p>Bir iddiayı güçlendirmek için daha çok veri değil, doğru kanıt gerekir. HPAnalytic araştırmayı cevaptan değil sorudan başlatır.</p>
    <a href="/research" class="story-link">ARAŞTIRMA YAKLAŞIMINI GÖR <span aria-hidden="true">→</span></a>
  </div>
  <div class="research-method" aria-label="HPAnalytic araştırma yöntemi">
    <div><span>01</span><b>SORU</b><p>Önce gerçekten cevaplanması gereken futbol problemi tanımlanır.</p></div>
    <div><span>02</span><b>KANIT</b><p>Kaynak, iddianın taşıyabileceği güven düzeyine göre seçilir.</p></div>
    <div><span>03</span><b>KARŞI-KANIT</b><p>İlk açıklamayı bozan veya sınırlandıran veri özellikle aranır.</p></div>
    <div><span>04</span><b>SINIR</b><p>Kanıtın söylemediği şey, söylediği şey kadar görünür tutulur.</p></div>
  </div>
</section>
<section class="scouting-spotlight" aria-labelledby="scouting-title">
<div class="scouting-copy"><p class="kicker">SCOUTING · KARAR DİSİPLİNİ</p><h2 id="scouting-title">OYUNCU BULMAK DEĞİL.<br/><em>KARAR RİSKİNİ</em> AZALTMAK.</h2><p>Scouting, iyi oyuncu listesi değildir. Rolün, bağlamın ve transfer edilebilir özelliklerin aynı karar problemi içinde sınanmasıdır.</p><a href="/scouting" class="story-link">SCOUTING YAKLAŞIMINI GÖR →</a></div>
<div class="scouting-lenses"><div><span>01</span><b>ROL</b><p>Oyuncunun etiketi değil, takım içindeki fonksiyonu.</p></div><div><span>02</span><b>BAĞLAM</b><p>Lig, takım, partner, rakip ve oyun durumu etkisi.</p></div><div><span>03</span><b>TAŞINABİLİRLİK</b><p>Gözlenen niteliğin yeni sisteme taşınabilirliği.</p></div><div><span>04</span><b>KARŞI-KANIT</b><p>Kararı zayıflatabilecek bulguların özellikle aranması.</p></div></div></section>
<div class="principles"><span>ÖNCE FUTBOL</span><span>GÜVENDEN ÖNCE KANIT</span><span>METRİKTEN ÖNCE MEKANİZMA</span><span>HÜKÜMDEN ÖNCE BAĞLAM</span></div>
</BaseLayout>

<style>.editorial-home-stage{max-width:1440px;margin-inline:auto;padding-inline:clamp(16px,2vw,28px)}</style>
