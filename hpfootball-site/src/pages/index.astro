---
import { isPublic } from '../lib/public-content.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isPublicEditorialItem } from '../lib/site-editorial-status.mjs';
import { SECTION_LABELS } from '../lib/site-surfaces.mjs';
import { featuredMatch } from '../data/match-previews.mjs';
import { featuredPremier } from '../data/premier-features.mjs';
export const prerender = true;

const monographs = (await getCollection('monographs', isPublic)).sort((a, b) => +b.data.date - +a.data.date);
const articles = (await getCollection('articles', isPublic)).filter((entry) => isPublicEditorialItem(entry.data)).sort((a, b) => +b.data.date - +a.data.date);
const match = featuredMatch();
const premier = featuredPremier();
const dateTr = (d: Date) => d.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const steps = [
  { key: 'yapi', label: 'Yapı', text: 'Önce oyunun iskeleti: alan, zaman, rol ve rakip. Skor bu yapının en son katmanıdır.' },
  { key: 'iliski', label: 'İlişki', text: 'Sonra bağlar: hangi aksiyon hangisini doğurdu, hangi kayıp hangi fırsatı açtı.' },
  { key: 'karar', label: 'Karar', text: 'En son hüküm, ama kanıtın taşıyabildiği kadar. Bilmediğimizi bilmiyoruz diye yazarız.' },
];
---
<BaseLayout title="HPAnalytic — Hikmet Pınarbaş Futbol Analizi" description="Hikmet Pınarbaş'tan kanıt, mekanizma ve bağlam temelli bağımsız futbol analizi.">

<section id="premier-feature" class="hpa-premier" aria-labelledby="premier-title" data-club="galatasaray">
  <div class="hpa-premier__inner">
    <div class="hpa-premier__overline"><span>HPANALYTIC / PREMIER</span><span>BAŞ ANALİZ · EDITOR'S PICK</span></div>
    {premier && <>
      <p class="hpa-premier__eyebrow">{premier.category} · {premier.team}</p>
      <h2 id="premier-title">{premier.title}</h2>
      <p>{premier.description}</p>
      <a class="hpa-premier__link" href={premier.href} aria-label={premier.title + ' premier analizini oku'}>PREMIER DOSYASINI KEŞFET <span aria-hidden="true">↗</span></a>
    </>}
  </div>
</section>
<style>
.hpa-premier{position:relative;isolation:isolate;background:linear-gradient(124deg,#120707 0%,#350B16 48%,#711523 78%,#8B451C 100%);color:#F6F1E8;border-block:1px solid #F2B705}
.hpa-premier::before{content:"";position:absolute;inset:0;z-index:-1;background:repeating-linear-gradient(90deg,transparent 0,transparent calc(33.333% - 1px),rgba(255,221,162,.12) 33.333%)}
.hpa-premier__inner{width:min(1200px,calc(100% - 36px));margin:auto;padding:clamp(36px,6vw,78px) 0}
.hpa-premier__overline{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;border-bottom:1px solid rgba(255,255,255,.28);padding-bottom:13px;font-size:.72rem;font-weight:700;letter-spacing:.15em;color:#FFD24D}
.hpa-premier__eyebrow{color:#F9CB7B;font-size:.78rem;letter-spacing:.1em;margin-top:24px}
.hpa-premier h2{font-size:clamp(2rem,5vw,4.5rem);line-height:1.08;max-width:900px;margin:13px 0 20px;letter-spacing:-.045em}
.hpa-premier__inner>p:not(.hpa-premier__eyebrow){max-width:650px;color:#D5DEE2;line-height:1.65}
.hpa-premier__link{display:inline-flex;gap:18px;align-items:center;margin-top:24px;color:#2A0705;background:#F2B705;text-decoration:none;padding:15px 20px;min-height:48px;font-weight:800;font-size:.82rem;letter-spacing:.05em;border-radius:4px}
.hpa-premier__link:focus-visible{outline:3px solid #FFF;outline-offset:4px}
</style>

<section class="home-hero" aria-labelledby="hero-title">
  <canvas class="home-hero__canvas" aria-hidden="true" data-threads></canvas>
  <div class="home-hero__inner">
    <p class="kicker">HPANALYTIC · FUTBOL · ARAŞTIRMA · SCOUTING</p>
    <h1 id="hero-title">Oyunu sonuçtan <em>önce</em> oku.</h1>
    <p class="home-hero__sub">Skoru değil, skoru üreten mekanizmayı okuyan bağımsız futbol analizi. Her iddia kendi kanıt sınıfını ve sınırını taşır.</p>
    <div class="home-hero__actions">
      {match && <a class="button button-primary" href={match.href}>Bu haftanın dosyası <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a>}
    </div>
    <div class="steps" data-steps>
      <div class="steps__rail"><span class="steps__bar" aria-hidden="true"></span>
      <ol class="steps__track" role="tablist" aria-label="Okuma sırası">
        {steps.map((s, i) => <li role="presentation"><button type="button" role="tab" id={`step-${s.key}`} aria-controls={`panel-${s.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.label}</button></li>)}
      </ol></div>
      {steps.map((s, i) => <p class="steps__panel" role="tabpanel" id={`panel-${s.key}`} aria-labelledby={`step-${s.key}`} hidden={i !== 0}>{s.text}</p>)}
    </div>
  </div>
</section>

{match && (
<section class="feature-band" data-club={match.club} aria-labelledby="feature-title">
  <div class="feature-band__inner">
    <div class="feature-band__copy reveal">
      <p class="kicker">{match.kind} · {match.competition}</p>
      <h2 id="feature-title"><span>{match.home}</span><span style="color:var(--ink-2)">– {match.away}</span></h2>
      <p class="lead">{match.description}</p>
      <div class="feature-band__meta"><span>{new Date(match.kickoff).toLocaleString("tr-TR",{day:"numeric",month:"long",hour:"2-digit",minute:"2-digit",timeZone:"Europe/Istanbul"})} TSİ</span><span>{match.evidence}</span></div>
      <div class="button-row"><a class="button button-primary" href={match.href}>Dosyayı aç <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a></div>
    </div>
    <div class="feature-panel reveal" aria-label="Dosyadan üç sayı">
      {match.stats.map((st) => <div class="stat-pair"><span>{st.label}</span><b>{st.value}</b><small>{st.note}</small></div>)}
    </div>
  </div>
</section>
)}

{monographs.length > 0 && (
<section class="rail-section" aria-labelledby="mono-title">
  <div class="rail-head">
    <div>
      <p class="kicker">Araştırma · Monografiler</p>
      <h2 id="mono-title">Uzun soluklu okumalar</h2>
      <p>Futbolun görünmeyen tarafına tek bir soruyla giren araştırmalar. Her biri kendi iddia sınırıyla.</p>
    </div>
    <div class="rail-controls" data-rail-controls="mono-rail">
      <button type="button" data-dir="-1" aria-label="Önceki monografiler"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
      <button type="button" data-dir="1" aria-label="Sonraki monografiler"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
    </div>
  </div>
  <div class="rail" id="mono-rail" tabindex="0" role="region" aria-label="Monografiler, yatay kaydırılabilir">
    {monographs.map((m) => (
      <article class="rail-card">
        <div class="rail-card__meta"><span>{m.data.category ?? 'Monografi'}</span><span>{m.data.readingTime}</span></div>
        <h3><a href={`/monographs/${m.id}`}>{m.data.title}</a></h3>
        <p>{m.data.subtitle ?? m.data.description}</p>
        <div class="rail-card__foot"><span>OKU</span><span aria-hidden="true">→</span></div>
      </article>
    ))}
  </div>
</section>
)}

{articles.length > 0 && (
<section class="rail-section" aria-labelledby="analysis-title">
  <div class="rail-head">
    <div>
      <p class="kicker">Analiz · Yöntem</p>
      <h2 id="analysis-title">Mekanizma kütüphanesi</h2>
      <p>Bir futbol kavramını parçalarına ayıran kısa analizler: ne görülür, ne görülmez, ne ölçülür.</p>
    </div>
    <a class="button" href="/analysis">Tüm analizler</a>
  </div>
  <div class="bento">
    {articles.slice(0, 4).map((a, i) => (
      <article class:list={['tile', 'reveal', i === 0 ? 'tile--wide' : i === 1 ? 'tile--narrow' : 'tile--half']}>
        <div class="card-meta"><span class="section-name">{SECTION_LABELS[a.data.section as keyof typeof SECTION_LABELS] ?? a.data.section}</span><time datetime={a.data.date.toISOString().slice(0, 10)}>{dateTr(a.data.date)}</time></div>
        <h3><a href={`/articles/${a.id}`}>{a.data.title}</a></h3>
        <p>{a.data.description}</p>
      </article>
    ))}
  </div>
</section>
)}

<section class="method" aria-labelledby="method-title">
  <div class="rail-head" style="padding:0;margin:0">
    <div>
      <p class="kicker">Nasıl çalışıyoruz</p>
      <h2 id="method-title">Önce soru. Sonra kanıt. Sınır hep görünür.</h2>
    </div>
  </div>
  <ol class="method__grid">
    <li><span>01</span><b>Soru</b><p>Önce gerçekten cevaplanması gereken futbol problemi tanımlanır.</p></li>
    <li><span>02</span><b>Kanıt</b><p>Kaynak, iddianın taşıyabileceği güven düzeyine göre seçilir.</p></li>
    <li><span>03</span><b>Karşı kanıt</b><p>İlk açıklamayı bozan ya da sınırlayan veri özellikle aranır.</p></li>
    <li><span>04</span><b>Sınır</b><p>Kanıtın söylemediği şey, söylediği şey kadar görünür tutulur.</p></li>
  </ol>
  <div class="evidence-legend" aria-label="Kanıt sınıfları">
    <span><i style="background:var(--amber)"></i>GÖZLENEN</span>
    <span><i style="background:var(--context)"></i>MODEL</span>
    <span><i style="background:var(--amber-2)"></i>TÜRETİLMİŞ</span>
    <span><i style="background:var(--ink-2)"></i>HİPOTEZ</span>
    <span><i style="background:var(--breach)"></i>KANIT İHLALİ</span>
  </div>
</section>

<script>
  // Steps carousel: Yapı → İlişki → Karar. Auto-advances only while the hero is visible and untouched.
  const root = document.querySelector<HTMLElement>('[data-steps]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const bar = root.querySelector<HTMLElement>('.steps__bar');
    let index = 0; let timer: number | undefined; let touched = false;
    const select = (i: number, focus = false) => {
      index = (i + tabs.length) % tabs.length;
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === index)); t.tabIndex = k === index ? 0 : -1; });
      panels.forEach((p, k) => { p.hidden = k !== index; });
      if (bar) bar.style.width = `${(index * 2 + 1) / (tabs.length * 2) * 100}%`;
      if (focus) tabs[index].focus();
    };
    tabs.forEach((t, k) => {
      t.addEventListener('click', () => { touched = true; select(k); });
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { touched = true; select(index + 1, true); }
        if (e.key === 'ArrowLeft') { touched = true; select(index - 1, true); }
      });
    });
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) timer = window.setInterval(() => { if (!touched && !document.hidden) select(index + 1); }, 5200);
    root.addEventListener('pointerenter', () => { touched = true; });
    select(0);
  }

  // Rail controls
  document.querySelectorAll<HTMLElement>('[data-rail-controls]').forEach((controls) => {
    const rail = document.getElementById(controls.dataset.railControls || '');
    if (!rail) return;
    const [prev, next] = controls.querySelectorAll<HTMLButtonElement>('button');
    const update = () => {
      prev.disabled = rail.scrollLeft < 8;
      next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 8;
    };
    controls.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
      const card = rail.querySelector<HTMLElement>('.rail-card');
      const step = card ? card.offsetWidth + 14 : rail.clientWidth * .8;
      rail.scrollBy({ left: Number(b.dataset.dir) * step, behavior: 'smooth' });
    }));
    rail.addEventListener('scroll', update, { passive: true });
    update();
  });

  // Hero threads: decorative light lines drifting across the field. Not data.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-threads]');
  if (canvas && canvas.getContext) {
    const ctx = canvas.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const amber = getComputedStyle(document.documentElement).getPropertyValue('--amber').trim() || '#F2A33A';
    let w = 0, h = 0, dpr = 1, raf = 0, t0 = performance.now();
    const nodes = Array.from({ length: 26 }, (_, i) => ({ x: Math.random(), y: .25 + Math.random() * .7, vx: (Math.random() - .5) * .00006, vy: (Math.random() - .5) * .00004, hot: i % 5 === 0 }));
    const size = () => { dpr = Math.min(2, window.devicePixelRatio || 1); w = canvas.clientWidth; h = canvas.clientHeight; canvas.width = w * dpr; canvas.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); };
    const draw = (now: number) => {
      const dt = Math.min(48, now - t0); t0 = now;
      ctx.clearRect(0, 0, w, h);
      // long floodlight streaks
      for (let k = 0; k < 5; k++) {
        const phase = now * .00005 + k * 1.3;
        ctx.beginPath();
        for (let x = -20; x <= w + 20; x += 24) {
          const y = h * (.62 + k * .07) + Math.sin(x * .004 + phase) * h * .06 - x * .12;
          x === -20 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        }
        ctx.strokeStyle = `rgba(242,163,58,${.05 + k * .025})`; ctx.lineWidth = 1; ctx.stroke();
      }
      for (const n of nodes) { n.x += n.vx * dt; n.y += n.vy * dt; if (n.x < 0 || n.x > 1) n.vx *= -1; if (n.y < .2 || n.y > 1) n.vy *= -1; }
      for (let i = 0; i < nodes.length; i++) for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i], b = nodes[j]; const dx = (a.x - b.x) * w, dy = (a.y - b.y) * h; const d = Math.hypot(dx, dy);
        if (d < 170) { ctx.strokeStyle = (a.hot || b.hot) ? `rgba(242,163,58,${.32 * (1 - d / 170)})` : `rgba(242,238,230,${.09 * (1 - d / 170)})`; ctx.beginPath(); ctx.moveTo(a.x * w, a.y * h); ctx.lineTo(b.x * w, b.y * h); ctx.stroke(); }
      }
      for (const n of nodes) { ctx.beginPath(); ctx.arc(n.x * w, n.y * h, n.hot ? 2.2 : 1.2, 0, Math.PI * 2); ctx.fillStyle = n.hot ? amber : 'rgba(242,238,230,.5)'; ctx.fill(); }
      if (!reduce) raf = requestAnimationFrame(draw);
    };
    size(); draw(performance.now());
    window.addEventListener('resize', () => { size(); if (reduce) draw(performance.now()); });
    document.addEventListener('visibilitychange', () => { if (document.hidden) cancelAnimationFrame(raf); else if (!reduce) raf = requestAnimationFrame(draw); });
  }
</script>
</BaseLayout>
