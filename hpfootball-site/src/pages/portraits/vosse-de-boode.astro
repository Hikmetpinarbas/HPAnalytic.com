---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EndnoteLinks from '../../components/editorial/EndnoteLinks.astro';
import {serializeJsonLd} from '../../lib/json-ld.mjs';
import article from '../../components/vosse/article.json';
import '../../styles/portrait-p0.css';
export const prerender=true;
const wordCount=article.blocks.flatMap(b=>b.paragraphs).join(' ').split(/\s+/).length;
const photoReview=import.meta.env.DEV && import.meta.env.HPA_PHOTO_REVIEW==='1';
---
<BaseLayout systemFonts title="Vosse de Boode — Laboratuvarın kapısı sahaya açılır | HPAnalytic" description="Ajax’tan AusCycling’e: Vosse de Boode’un hareketi anlamak, doğru soruyu sormak ve bilgiyi oyuncuya geri vermek üzerine bilimsel portresi." ogType="article" image="/editorial/20261028/vosse-portrait-p0.png" imageAlt="Vosse de Boode — HPAnalytic bilimsel portre">
<script slot="head" type="application/ld+json" set:html={serializeJsonLd({'@context':'https://schema.org','@type':'Article',headline:'Vosse de Boode — Laboratuvarın kapısı sahaya açılır',datePublished:'2026-10-28',dateModified:'2026-10-28',inLanguage:'tr',author:{'@type':'Person',name:'Hikmet Pınarbaş'},publisher:{'@type':'Organization',name:'HPAnalytic'},image:'https://www.hpanalytic.com/editorial/20261028/vosse-portrait-p0.png',mainEntityOfPage:'https://www.hpanalytic.com/portraits/vosse-de-boode/'})}/>
<article class="portrait-editorial">
<header class="portrait-cover" id="portrait-top"><div class="portrait-overline"><span>BİLİMDEN OYUNA / PORTRE 01</span><span>HPANALYTIC</span></div><div class="portrait-cover-grid"><div><p class="portrait-kicker">Bir hareketi ölçmek başka.<br/><em>O hareketi anlamak başka.</em></p><h1>Vosse<br/>de Boode<span>.</span></h1><p class="portrait-deck">Laboratuvarın kapısı sahaya açılır.</p></div><div class="portrait-cover-aside">{photoReview?<figure class="portrait-photo"><img src="/@fs/home/userland/HPAnalytic/projects/codex-editorial-p0-20261028/hpfootball-site/private/editorial-photo-review/vosse-barcelona.jpg" width="1200" height="750" alt="Vosse de Boode, Ajax döneminden arşiv portresi" fetchpriority="high"/><figcaption>Vosse de Boode · Sports Technology Symposium 2017. <a href="https://www.fcbarcelona.com/en/card/762723/vosse-de-boode">Kaynak: FC Barcelona ↗</a></figcaption></figure>:<><figure class="portrait-context-hero"><img src="https://images.unsplash.com/photo-1767731154269-904a69c11fe4?fm=jpg&w=1200&q=80" width="1200" height="800" alt="Futbolcuların saha çalışması; Vosse de Boode'u göstermeyen bağlamsal fotoğraf" fetchpriority="high"/><figcaption>SAHA / BİLİMİN UYGULAMA ALANI · Bağlamsal fotoğraf; Vosse de Boode değildir. Fotoğraf: <a href="https://unsplash.com/@elevantarts">christopher lemercier</a> · <a href="https://unsplash.com/photos/BZGIyawVX0s">Unsplash lisansı</a>.</figcaption></figure><a href="https://www.sloansportsconference.com/people/vosse-de-boode">Vosse de Boode’u resmî konuşmacı profilinde gör ↗</a></>}</div></div><div class="portrait-meta"><span>Hikmet Pınarbaş</span><span>28 Ekim 2026</span><span>{Math.ceil(wordCount/200)} dk okuma</span><a href="#portrait-sources">Kaynaklar ve araştırma notları ↓</a></div></header>
<nav class="portrait-contents" aria-label="Portre içindekiler">{article.blocks.map((b,i)=><a href={'#portrait-'+i}><span>0{i+1}</span>{b.title}</a>)}</nav>
<div class="portrait-body">
{article.blocks.map((block,i)=><section class="portrait-chapter" id={'portrait-'+i} aria-labelledby={'portrait-heading-'+i}><header><span>0{i+1}</span><h2 id={'portrait-heading-'+i}>{block.title}</h2></header><div class="portrait-prose" data-source-block={i}>{block.paragraphs.map(p=><p set:html={p}/>)}</div>
{i===1&&<aside class="portrait-career" aria-label="Doğrulanmış kariyer dönüm noktaları"><div><time>2011</time><span>Ajax’a katılış</span></div><div><time>2023</time><span>Futbol analitiği yöneticiliği</span></div><div><time>2025</time><span>AusCycling · Veri ve İçgörü</span></div></aside>}
{i===2&&<figure class="portrait-context-inline"><img src="https://images.unsplash.com/photo-1767731325176-1b4c774bd3d3?fm=jpg&w=1200&q=80" width="1200" height="800" loading="lazy" decoding="async" alt="Futbol takımının antrenman anı, araştırmacının kendi çalışması değil"/><figcaption>Futbolda ölçümün sahayla buluştuğu ortamı gösteren temsili fotoğraf; araştırmacı veya çalıştığı kulüp değildir. Fotoğraf: <a href="https://unsplash.com/@elevantarts">christopher lemercier</a> / <a href="https://unsplash.com/photos/BGZptDyKtB0">Unsplash lisansı</a>.</figcaption></figure>}
{i===3&&<figure class="portrait-study"><figcaption><span>ARAŞTIRMA / KURTARIŞ MEKANİĞİ</span><h3>İtiş değiştiğinde.</h3><p>11 kaleci · 12 hafta · ortalama değişim</p></figcaption><div class="portrait-study-pair"><div><strong>+0,82 <small>m/s</small></strong><p>Yatay kütle merkezi hızı</p><small>%95 GA: 0,62–1,02 m/s</small></div><div><strong>+523 <small>W</small></strong><p>Karşı bacağın güç üretimi</p><small>%95 GA: 313–732 W</small></div></div><p class="portrait-caption">Kontrollü müdahale; maçta kurtarılan gol sayısı ölçülmedi. <a href="https://doi.org/10.1080/14763141.2022.2099966">Araştırma ↗</a></p></figure>}
{i===4&&<figure class="portrait-study" data-gaze-comparison><figcaption><span>ARAŞTIRMA / VURUŞ ÖNCESİ BAKIŞ</span><h3>Göz hangi bilgiyi arıyor?</h3><p>14 oyuncu · 220 deneme · kaleci yok</p></figcaption><div class="portrait-study-controls" role="group" aria-label="Bakışın yöneldiği nesne"><button type="button" data-gaze-focus="target" aria-pressed="true">Hedef</button><button type="button" data-gaze-focus="ball" aria-pressed="false">Top</button></div><div class="portrait-bars" role="img" aria-label="Hedefe ortalama bakış: isabetli 886, isabetsiz 488 milisaniye"><div><span>İsabetli denemeler</span><b data-gaze-hit>886 ms</b><i data-gaze-hit-bar style="--duration:88.6%"></i></div><div><span>İsabetsiz denemeler</span><b data-gaze-miss>488 ms</b><i data-gaze-miss-bar style="--duration:48.8%"></i></div></div><p class="portrait-caption">Ortalama sabit bakış süresi · 0–1000 ms ortak ölçek. İlişki nedensellik değildir. <a href="https://doi.org/10.1177/1747954120943067">Araştırma ↗</a></p><details><summary>Dört değeri tablo olarak karşılaştır</summary><table><caption>Ortalama sabit bakış süreleri (ms)</caption><thead><tr><th scope="col">Bakış</th><th scope="col">İsabetli</th><th scope="col">İsabetsiz</th></tr></thead><tbody><tr><th scope="row">Hedef</th><td>886</td><td>488</td></tr><tr><th scope="row">Top</th><td>627</td><td>513</td></tr></tbody></table></details></figure>}
{[3,4,5].includes(i)&&<figure class="portrait-concept-figure"><img src={'/editorial/20261028/vosse-research/'+({3:'keeper',4:'gaze',5:'player-data'} as Record<number,string>)[i]+'.svg'} loading="lazy" decoding="async" width="800" height="460" alt={({3:'Kaleci dalışının dört kavramsal aşamasını gösteren açıklayıcı şema; gerçek hareket verisi değil',4:'Serbest vuruş öncesi oyuncunun hedef ve topa bakışını gösteren temsili şema; ölçülen göz izi değildir',5:'Oyuncu, veri, analiz ve geri bildirim döngüsünü gösteren kavramsal diyagram; gerçek Ajax sistemi ekranı değildir'} as Record<number,string>)[i]}/><figcaption>HPAnalytic · Telefona aktarılan Vosse araştırma paketinden alınan kavramsal çizim. Gerçek hareket, göz takibi ya da yazılım mimarisi kaydı değildir.</figcaption></figure>}
</section>)}
<section class="portrait-endnotes" id="portrait-sources"><h2>Kaynaklar ve araştırma notları</h2><details><summary>Kaynakça · 14 başvuru</summary><ol>{article.sources.map((s,i)=><li id={'source-'+(i+1)}><a href={s.url}>{s.label} ↗</a></li>)}</ol></details><details><summary>Araştırmaların kapsamı ve sınırları</summary><p>Akademik çalışmalar ortak yazarlıdır. 2019 kaleci çalışmasında 10, eklem kinetiği çalışmasında 7 kaleci incelendi. 2022 müdahalesinin 42 cm kapsama hesabı bir penaltı senaryosunun modelidir; gerçek maçta gözlenen ek erişim değildir.</p><p>2024 konferans çalışmasında 5 kadın kalecide geniş başlangıç duruşunun dalış süresini iyileştirdiğine ilişkin anlamlı sonuç bulunmadı. Küçük ve farklı örneklemler doğrudan çürütme iddiasına izin vermez. Ayak bileği araştırması 190 erkek futbolcuyu, 45 ilk burkulmayı kapsar; bireysel sakatlık tahmin sistemi değildir [13, 14].</p><p>NRC aktarımı kamuya açık röportaj tanıtımlarıyla sınırlıdır; ücretli röportajın tamamı görülmedi. AusCycling’in görev duyurusu 3 Nisan 2025, Training Ground Guru’nun geçiş haberi 13 Mayıs 2025 tarihlidir. Çocukluk ve aile hayatına ilişkin doğrulanmamış anlatılar kullanılmadı.</p></details><details><summary>Fotoğraf ve görsel hakları</summary><p>MIT Sloan, FC Barcelona ve diğer resmî profillerde gerçek fotoğraf adayları bulundu. {photoReview?'Bu özel önizlemede FC Barcelona’nın 2017 etkinlik portresi gösterilir. Fotoğrafın yeniden yayın lisansı henüz doğrulanmış değildir.':'Yeniden yayım lisansı doğrulanmadığından bu sayfaya kopyalanmadı. Yukarıdaki bağlantı, gerçek kişiyi gösteren resmî profile gider. Kapaktaki geometrik kompozisyon HPAnalytic’in özgün çalışmasıdır; bir insan portresi veya ölçüm kaydı değildir.'}</p></details><p>Yazar: Hikmet Pınarbaş · Araştırma ve düzenleme: 28 Ekim 2026.</p></section>
<footer class="portrait-close"><p>Veri insandan çıkar.<br/><em>Bilgi insana geri döner.</em></p><a href="#portrait-top">Başa dön ↑</a></footer>
</div></article>
<EndnoteLinks/>
</BaseLayout>
<script>
for(const root of document.querySelectorAll<HTMLElement>('[data-gaze-comparison]')){root.querySelectorAll<HTMLButtonElement>('[data-gaze-focus]').forEach(button=>button.addEventListener('click',()=>{const ball=button.dataset.gazeFocus==='ball';const hit=ball?627:886,miss=ball?513:488;root.querySelectorAll<HTMLButtonElement>('[data-gaze-focus]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));root.querySelector('[data-gaze-hit]')!.textContent=hit+' ms';root.querySelector('[data-gaze-miss]')!.textContent=miss+' ms';(root.querySelector('[data-gaze-hit-bar]') as HTMLElement).style.setProperty('--duration',hit/10+'%');(root.querySelector('[data-gaze-miss-bar]') as HTMLElement).style.setProperty('--duration',miss/10+'%');root.querySelector('.portrait-bars')!.setAttribute('aria-label',(ball?'Topa':'Hedefe')+' ortalama bakış: isabetli '+hit+', isabetsiz '+miss+' milisaniye');}));}
</script>
