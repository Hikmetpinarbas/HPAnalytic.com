---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender=true;
const coaches=['Antonio Conte','José Luis Mendilibar','Răzvan Lucescu','Mattia Croci-Torti','Julian Nagelsmann'];
---
<BaseLayout title="Beş Hoca, Beş Ayrı Risk ve Ödül — HPAnalytic" description="Fenerbahçe için beş futbol modelinin hücum ve savunma organizasyonu.">
<main class="five">
<header><p class="kicker">HPANALYTIC · TAKTİK ARAŞTIRMA · 29 EKİM 2026</p><h1>Beş hoca.<br><em>Beş ayrı risk.</em><br>Beş ayrı ödül.</h1><p>Fenerbahçe hangi teknik direktörü değil, hangi oyun modelini seçiyor? Önce bedeli; sonra aynı futbolun sağlayabileceği kazanımları inceliyoruz.</p></header>
<section class="essay"><p class="kicker">01 / RİSK</p><h2>İyi bir fikir yanlış koşullarda kötü bir karara dönüşür.</h2><p>Conte’nin koordinasyonu doğru oyuncular olmadan katılaşabilir. Mendilibar’ın presi kırıldığında gerisinde büyük boşluk bırakabilir. Lucescu’nun merkezi kontrol etme çabası yaratıcı temposunu kaybedebilir. Croci-Torti’nin rol değişimleri takımın güvenli mesafelerini bozabilir. Nagelsmann’ın çok katmanlı planı oyuncuların karar yükünü artırabilir.</p><p>Kulübün çözmesi gereken soru şudur: Teknik direktörün getireceği yeni kuralları, oyuncu profili ve yönetim düzeniyle birlikte taşıyabilecek mi?</p></section>
<section class="essay alt"><p class="kicker">02 / ÖDÜL</p><h2>Peki, her şey yolunda giderse?</h2><p>İlk bölümün anlattığı riskler, aslında tam da başarıyı mümkün kılan prensiplerin maliyetidir. Conte takımın tek vücut halinde hareket etmesini sağlayabilir; Mendilibar rakip yarıda tekrar tekrar top kazanan bir baskı kültürü kurabilir; Lucescu maçın ritmini yöneten bir yapı oluşturabilir; Croci-Torti aynı oyuncularla farklı savunma problemlerine yeni çözümler getirebilir; Nagelsmann rakibin planına uyum sağlayan çok yönlü bir hücum dili yaratabilir.</p><p>Ödül yalnızca üç puan değildir. Kulübün her hafta yeniden üretebildiği futbol davranışıdır.</p></section>
<section class="lab"><p class="kicker">TAKTİK LABORATUVARI</p><h2>Beş model. İki oyun evresi.</h2><div class="controls"><label for="coach">Teknik direktör</label><select id="coach">{coaches.map((c,i)=><option value={i}>{c}</option>)}</select><fieldset><legend>Oyun evresi</legend><label><input type="radio" name="phase" value="attack" checked/> Hücum</label><label><input type="radio" name="phase" value="defence"/> Savunma</label></fieldset><button id="again" type="button">Yeniden oynat</button></div>
<svg id="ground" viewBox="0 0 840 520" role="img" aria-label="Seçilen oyun modelinin yönlü hareket canlandırması"><rect x="18" y="18" width="804" height="484" fill="#163b30" stroke="#b7ccc2" stroke-width="2"/><path d="M420 18V502 M18 163H146V357H18 M822 163H694V357H822" fill="none" stroke="#b7ccc2" stroke-width="2"/><circle cx="420" cy="260" r="69" fill="none" stroke="#b7ccc2" stroke-width="2"/><g id="dots"></g><g id="routes"></g></svg>
<h3 id="readout" aria-live="polite"></h3><p class="note">Saha görselleştirmesi bir taktik senaryodur; gerçek maç takip veya pas verisi değildir. Yönlü bölge akışları Edd Webster Pass-Flow ve harshkrishna17 ggshakeR çalışmalarının yöntemsel yaklaşımı incelenerek yeni SVG koduyla hazırlanmıştır.</p></section>
<section class="essay"><p class="kicker">KARAR</p><h2>Risk mi, ödül mü?</h2><p>Bir modelin ödülü, onu taşıyacak koşullardan bağımsız değildir. Taraftar anketi gerçek oy kaydı ve manipülasyon kontrolleri hazır olana kadar açılmamıştır.</p></section></main>
<style>
.five{background:#08090b;color:#f2eee6;padding:0 max(1.2rem,calc((100vw - 1080px)/2)) 6rem}.five header{padding:8rem 0 5rem}.five h1{font:700 clamp(3.5rem,9vw,7.8rem)/.98 'Inter Tight',Arial,sans-serif;letter-spacing:-.06em}.five h1 em{color:#f2a33a;font-family:'Bodoni Moda',Georgia,serif;font-weight:400}.five header>p:last-child{font:clamp(1.3rem,2.8vw,2rem)/1.5 'Source Serif 4',Georgia,serif;max-width:770px}.kicker{letter-spacing:.13em;color:#f2a33a;font:700 .75rem Arial,sans-serif}.essay,.lab{padding:4rem 0;border-top:1px solid #383c42}.essay h2,.lab h2{font:600 clamp(2rem,4vw,3.5rem)/1.1 'Inter Tight',Arial,sans-serif;max-width:780px}.essay>p:not(.kicker){max-width:740px;font:1.18rem/1.72 'Source Serif 4',Georgia,serif}.alt{background:#15171b;padding:4rem 2rem;margin:0 -1rem}.controls{display:flex;flex-wrap:wrap;align-items:center;gap:1rem;margin:2rem 0}.controls select,.controls button,.controls fieldset{background:#191c21;color:#f2eee6;border:1px solid #51565c;border-radius:6px;padding:.7rem}.controls button{cursor:pointer}.controls :focus-visible{outline:3px solid #f2a33a}.lab svg{display:block;width:100%;height:auto;border:1px solid #52645d}.note{color:#b8b5ad;font: .9rem/1.6 Arial,sans-serif;max-width:780px}@media(prefers-reduced-motion:reduce){.five *{animation:none!important;transition:none!important}}
</style>
<script is:inline>
(()=>{const names=['Conte','Mendilibar','Lucescu','Croci-Torti','Nagelsmann'],attack=[[[17,42,36,24],[36,24,60,17],[60,17,88,42],[40,58,70,48]],[[20,48,47,46],[47,46,78,30],[78,30,90,49],[35,76,69,53]],[[20,52,41,45],[41,45,58,62],[58,62,79,47],[79,47,90,53]],[[20,28,44,37],[44,37,67,23],[67,23,81,49],[35,75,63,54]],[[18,41,46,26],[46,26,68,17],[68,17,89,50],[40,65,67,52]]],defence=[[[79,20,56,35],[77,77,55,64],[59,48,38,50]],[[80,29,58,36],[80,70,58,58],[60,52,36,50]],[[79,22,58,37],[78,74,58,63],[58,37,42,49]],[[80,26,60,37],[80,76,59,64],[61,38,41,50]],[[78,21,56,30],[77,76,56,62],[57,31,39,50]]];
const c=document.getElementById('coach'),dots=document.getElementById('dots'),routes=document.getElementById('routes');if(!c)return;const phase=()=>document.querySelector('input[name="phase"]:checked').value;const pos=(x,y)=>[18+x*8.04,18+y*4.84];const make=(tag,attr,parent)=>{let n=document.createElementNS('http://www.w3.org/2000/svg',tag);for(const[k,v]of Object.entries(attr))n.setAttribute(k,v);parent.append(n);return n};function draw(){dots.replaceChildren();routes.replaceChildren();const id=+c.value,att=phase()==='attack';[[20,50],[40,25],[40,75],[54,47],[68,21],[68,79],[80,49]].forEach(a=>{let p=pos(...a);make('circle',{cx:p[0],cy:p[1],r:11,fill:'#f2a33a',stroke:'#fff2ce'},dots)});[[38,16],[38,84],[60,50],[80,27],[80,75]].forEach(a=>{let p=pos(...a);make('circle',{cx:p[0],cy:p[1],r:10,fill:'#ac6063'},dots)});(att?attack:defence)[id].forEach((a,i)=>{let p=pos(a[0],a[1]),q=pos(a[2],a[3]);let n=make('path',{d:'M'+p.join(' ')+' L'+q.join(' '),stroke:'#f2a33a','stroke-width':5,fill:'none','stroke-linecap':'round'},routes);let len=Math.hypot(q[0]-p[0],q[1]-p[1]);n.style.strokeDasharray=len;n.style.strokeDashoffset=len;if(!matchMedia('(prefers-reduced-motion: reduce)').matches){n.style.transition='stroke-dashoffset .8s ease '+(i*.5)+'s';requestAnimationFrame(()=>n.style.strokeDashoffset='0')}else n.style.strokeDashoffset='0'});document.getElementById('readout').textContent=names[id]+' / '+(att?'Hücum':'Savunma')};c.addEventListener('change',draw);document.querySelectorAll('input[name="phase"]').forEach(x=>x.addEventListener('change',draw));document.getElementById('again').addEventListener('click',draw);draw()})();
</script>
</BaseLayout>