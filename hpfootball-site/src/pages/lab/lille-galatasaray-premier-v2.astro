---
import BaseLayout from '../../layouts/BaseLayout.astro';
import dataset from '../../data/lille-premier-v2-observations.json';
import points from '../../data/lille-premier-v2-event-points.json';
import aggregates from '../../data/lille-premier-v2-aggregates.json';
export const prerender=true;
const matches=dataset.matches;
const pass=(m)=>m.counts['Passes accurate'];
const incorrect=(m)=>m.counts['Inaccurate passes'];
const progressive=(m)=>m.counts['Progressive passes accurate'];
const maxPass=Math.max(...matches.map(pass));
const sourceUrl=(id)=>'https://drive.google.com/file/d/'+id+'/view';
---
<BaseLayout title="Lille – Galatasaray | Premier V2 kanıt laboratuvarı" description="Lille ve Galatasaray'ın rakip bağımlı olay profili: kaynaklı, doğrulanabilir dört maçlık CSV ön analizi." club="galatasaray" noindex={true}>
<main class="p2">
  <div class="wrap">
    <p class="eyebrow">HPANALYTIC / PREMIER V2 · EVIDENCE LAB</p>
    <h1>Lille × Galatasaray <span>Oyun, rakibe göre nasıl değişiyor?</span></h1>
    <p class="deck">Dört gerçek maçın olay kayıtlarına dayalı ilk analitik okuma. Aynı takımın farklı rakibe karşı nereden pas ürettiğini, ne kadar ilerleyebildiğini ve hangi soruları henüz cevaplayamadığımızı karşılaştırıyoruz.</p>
    <div class="notice" role="note"><strong>CSV-only · PROVISIONAL</strong> — Bu ön analiz henüz altı dosya ailesiyle kanonikleştirilmedi. Sayılar olay etiketi gözlemleridir; topa sahip olma, pres mesafesi veya takım niyeti değildir. Yayın kabulü verilmedi.</div>
    <section aria-labelledby="pass-h">
      <p class="eyebrow">01 / Karşılaştırmalı olay sayımı</p><h2 id="pass-h">Topun dolaşım hacmi aynı kalıyor mu?</h2>
      <p>Her çubuk, hedef takımın ilgili maçtaki “Passes accurate” CSV etiketini sayar. Maç içindeki topa sahip olma süresi ve rakip etkisi için düzeltme yapılmadı.</p>
      <div class="plot" role="img" aria-label="Takım ve maç karşılaştırma grafikleri">
      {matches.map(m=><div class="barrow"><div class="barname">{m.key.replaceAll('_',' · ')}</div><div class="track"><div class="fill" style={`width:${(pass(m)/maxPass*100).toFixed(2)}%`}></div></div><strong>{pass(m)}</strong></div>)}
      </div>
      <p class="small">Kaynakta “isabetli progresif pas” ayrı, örtüşen bir etiket; toplam paslara eklenmez.</p>
    </section>
    <section aria-labelledby="zone-h">
      <p class="eyebrow">02 / Konum profili</p><h2 id="zone-h">İsabetli pas etiketleri hangi x bölgesinde başlıyor?</h2>
      <p>Her maç için üç sabit x bandı: 0–35, 35–70, 70 ve üstü. Bu, doğrulanmış hücum yönü veya saha üçüncüsü tanımı değildir; kaynak koordinatının doğrudan bölünmesidir.</p>
      <div class="zones">{matches.map(m=><article class="zonebox"><h3>{m.key.replaceAll('_',' · ')}</h3><div class="zonegrid" role="img" aria-label={`${m.key}: ${m.pass_start_x_bins.map(z=>z.count).join(', ')}`}>{m.pass_start_x_bins.map((b,i)=><div class={'z z'+i}><strong>{b.count}</strong><span>x {b.range}</span></div>)}</div><p class="small">Payda: {pass(m)} isabetli pas etiketi</p></article>)}</div>
    </section>
    <section aria-labelledby="succ-h">
      <p class="eyebrow">03 / Başarılı ve başarısız eylem</p><h2 id="succ-h">Pas profilinde başarısızlık nasıl değişiyor?</h2>
      <p>Yalnızca Passes accurate ve Inaccurate passes etiketleri için sınırlı karşılaştırma. Diğer pas kategorileriyle örtüşme çözümlenmediğinden resmî pas isabet yüzdesi değildir.</p>
      <div class="summary">{matches.map(m=><article><h3>{m.key.replaceAll('_',' · ')}</h3><p><strong>{pass(m)}</strong> isabetli etiket · <strong>{incorrect(m)}</strong> isabetsiz etiket</p><p><strong>{progressive(m)}</strong> progresif isabetli etiket (alt küme olabilir)</p></article>)}</div>
    </section>

    <section aria-labelledby="eight-head" id="eight-graphs">
      <p class="eyebrow">PREMIER / 08 VISUAL ANALYTICS</p>
      <h2 id="eight-head">Sekiz grafik · kaynak ve örneklem ayrıştırılmıştır</h2>
      <p>Saha görünümleri: yalnız Arsenal–Lille ve Galatasaray–Barcelona oyuncu CSV koordinatları. Metrik görünümleri: takım başına iki UCL maçından verilen aggregate sayılar. Farklı örneklemler birbirine eklenmedi.</p>
      <div class="viztoolbar" role="group" aria-label="Grafikleri takım bazında filtrele"><button type="button" class="chosen" data-team-filter="ALL" aria-pressed="true">İki takım</button><button type="button" data-team-filter="LIL" aria-pressed="false">Lille</button><button type="button" data-team-filter="GS" aria-pressed="false">Galatasaray</button></div>
      <div class="vizgrid">
        <article class="vizcard" data-viz="1"><p class="eyebrow">#1 · P0 · SAHA</p><h3>Top kaybının gerçek konumu</h3><p>Tek maçlık nokta verisi. İşaretler doğrulanmış CSV kayıtlarından; yoğunluk çıkarımı veya pres iddiası yok.</p>
          <div class="pitchsets">
          {points.matches.map(m=><figure class="pitchfig" data-team={m.key.startsWith('lille')?'LIL':'GS'}><figcaption>{m.key.replaceAll('_',' · ')} · {m.points.filter(p=>p.kind==='Lost balls'||p.kind==='Ball losses').length} kayıt</figcaption>
            <svg viewBox="0 0 105 68" role="img" aria-label={m.key+' gerçek top kaybı saha koordinatları'}><rect x="0.5" y=".5" width="104" height="67" fill="#143d36" stroke="#bad3c6" stroke-width=".5"/><path d="M52.5 0 V68 M0 13 H16 V55 H0 M105 13 H89 V55 H105 M0 23 H5 V45 H0 M105 23 H100 V45 H105" fill="none" stroke="#bad3c6" stroke-width=".4"/><circle cx="52.5" cy="34" r="9.15" fill="none" stroke="#bad3c6" stroke-width=".4"/><g stroke="#bad3c6" stroke-width=".2" stroke-dasharray="1 2"><path d="M35 0 V68 M70 0 V68 M0 13.6 H105 M0 27.2 H105 M0 40.8 H105 M0 54.4 H105"/></g>
            {m.points.filter(p=>p.kind==='Lost balls'||p.kind==='Ball losses').map(p=><circle cx={p.x} cy={p.y} r="1.15" fill="#ffbe55" fill-opacity=".75" stroke="#091b1a" stroke-width=".19"><title>{p.actor} · {p.kind} · {p.t}s · x {p.x}, y {p.y} · kaynak ID {p.source_id}</title></circle>)}</svg><p class="small">X: 0–105 · Y: 0–68; yön normalize edilmedi.</p></figure>)}
          </div>
        </article>
        <article class="vizcard" data-viz="2"><p class="eyebrow">#2 · SAHA</p><h3>Kazanım–kayıp noktaları</h3><p>Altın: kayıp · Turkuaz: kazanım. Noktalar arasında ilişki veya nedensellik çizilmez.</p><div class="pitchsets">{points.matches.map(m=><figure class="pitchfig" data-team={m.key.startsWith('lille')?'LIL':'GS'}><figcaption>{m.key.replaceAll('_',' · ')}</figcaption><svg viewBox="0 0 105 68" role="img" aria-label={m.key+' kazanım ve kayıp dağılımı'}><rect x=".5" y=".5" width="104" height="67" fill="#143d36" stroke="#bad3c6" stroke-width=".5"/><path d="M52.5 0 V68 M0 13 H16 V55 H0 M105 13 H89 V55 H105" fill="none" stroke="#bad3c6" stroke-width=".4"/><circle cx="52.5" cy="34" r="9.15" fill="none" stroke="#bad3c6" stroke-width=".4"/>{m.points.map(p=><circle cx={p.x} cy={p.y} r="1.1" fill={p.kind==='Ball recoveries'?'#60e5da':'#ffbe55'} fill-opacity=".76"><title>{p.actor} · {p.kind} · {p.t}s · ID {p.source_id}</title></circle>)}</svg><p class="small">Koordinatlar aynı maç içindeki ayrı olay etiketleridir.</p></figure>)}</div></article>
        <article class="vizcard" data-viz="3"><p class="eyebrow">#3 · EŞLEŞME</p><h3>İki yönlü saha hipotezi</h3><p>Bu panel gözlenen iki ayrı maçın saha alan dağılımını karşılaştırır; Lille–Galatasaray maçındaki oyuncu yerleşimi değildir. Bağlantı okları kapalı.</p><div class="pitchsets">{points.matches.map(m=><figure class="pitchfig" data-team={m.key.startsWith('lille')?'LIL':'GS'}><figcaption>{m.key.replaceAll('_',' · ')} · kayıpların x bölgeleri</figcaption><svg viewBox="0 0 105 68" role="img" aria-label={m.key+' üç koordinat bandı'}><rect x="0" y="0" width="35" height="68" fill="#2a5557"/><rect x="35" y="0" width="35" height="68" fill="#194141"/><rect x="70" y="0" width="35" height="68" fill="#2a5557"/><path d="M35 0 V68 M70 0 V68" stroke="#bedbd4" stroke-dasharray="2 1" stroke-width=".5"/>{[0,1,2].map((z)=><text x={17.5+35*z} y="36" text-anchor="middle" fill="#fff" font-size="8" font-weight="bold">{m.points.filter(p=>(p.kind==='Lost balls'||p.kind==='Ball losses')&&Math.min(2,Math.floor(p.x/35))===z).length}</text>)}</svg><p class="small">Kaynak koordinat bandı; şematik yön veya gerçek pres rotası değildir.</p></figure>)}</div></article>
        <article class="vizcard" data-viz="4"><p class="eyebrow">#4 · P0 · UCL / 2 MAÇ</p><h3>xG üretimi ve verilen xG</h3><p>İki farklı rakibe karşı toplamlar. Doğrudan üstünlük sonucu çıkarılamaz.</p>{aggregates.teams.map(t=><div class="aggrow" data-team={t.id}><strong>{t.id}</strong><div><div class="minibar" style={`width:${t.xG/4*100}%`} title={'xG '+t.xG}></div><span> xG {t.xG.toFixed(2)}</span><div class="minibar against" style={`width:${t.xGA/4*100}%`} title={'xGA '+t.xGA}></div><span> xGA {t.xGA.toFixed(2)} · net {t.netXG.toFixed(2)}</span></div></div>)}</article>
        <article class="vizcard" data-viz="5"><p class="eyebrow">#5 · UCL / 2 MAÇ</p><h3>PPDA × top kazanımı</h3><p>Yalnız iki takım noktası: korelasyon veya pres gücü kanıtı değildir. Düşük PPDA daha az rakip pasa izin verildiği anlamına gelir.</p><svg viewBox="0 0 360 235" class="metricplot" role="img" aria-label="PPDA yatay eksen top kazanımı dikey eksen"><path d="M45 15 V195 H344" stroke="#b5c6d0" stroke-width="1.2" fill="none"/>{[5,10,15].map(n=><g><text x={45+(n-4)/13*285} y="215" font-size="11" fill="#cbd7df" text-anchor="middle">{n}</text></g>)}{aggregates.teams.map(t=><g data-team={t.id}><circle cx={45+(t.ppda-4)/13*285} cy={195-(t.recoveries-75)/15*155} r="11" fill={t.id==='GS'?'#e7bf4b':'#6ac7d1'}><title>{t.id} PPDA {t.ppda}, kazanım {t.recoveries}</title></circle><text x={45+(t.ppda-4)/13*285+15} y={190-(t.recoveries-75)/15*155} fill="#fff" font-size="12">{t.id}</text></g>)}<text x="200" y="233" fill="#fff" font-size="11">PPDA →</text><text x="8" y="12" fill="#fff" font-size="10">Kazanım ↑</text></svg></article>
        <article class="vizcard" data-viz="6"><p class="eyebrow">#6 · UCL / 2 MAÇ</p><h3>xG / şut — dumbbell</h3><p>İki nokta aynı ölçek üzerinde: iki rakibe karşı elde edilen şut başına ortalama xG.</p><svg viewBox="0 0 360 130" class="metricplot" role="img" aria-label="Lille ve Galatasaray xG bölü şut karşılaştırması"><line x1="36" y1="65" x2="324" y2="65" stroke="#96a9b5" stroke-width="2"/>{aggregates.teams.map(t=><g data-team={t.id}><circle cx={36+(t.xG/t.shots)/.2*288} cy="65" r="10" fill={t.id==='GS'?'#e7bf4b':'#6ac7d1'}><title>{t.id} xG/şut {(t.xG/t.shots).toFixed(3)}</title></circle><text x={36+(t.xG/t.shots)/.2*288} y={t.id==='GS'?'43':'96'} text-anchor="middle" fill="#fff" font-size="12">{t.id} {(t.xG/t.shots).toFixed(3)}</text></g>)}<text x="36" y="123" fill="#b5c6d0" font-size="9">0</text><text x="324" y="123" fill="#b5c6d0" font-size="9">0.20</text></svg></article>
        <article class="vizcard" data-viz="7"><p class="eyebrow">#7 · DÖRT UCL MAÇI</p><h3>Maç bazlı performans matrisi</h3><div class="scrolltable"><table><thead><tr><th>Maç</th><th>Şut</th><th>xG</th><th>xGA</th><th>PPDA</th><th>Kendi yarısı kaybı</th></tr></thead><tbody>{aggregates.fixtures.map(m=><tr data-team={m.team}><th>{m.id}</th><td>{m.shots}</td><td>{m.xG.toFixed(2)}</td><td>{m.xGA.toFixed(2)}</td><td>{m.ppda.toFixed(2)}</td><td>{m.ownHalfLosses}</td></tr>)}</tbody></table></div></article>
        <article class="vizcard" data-viz="8"><p class="eyebrow">#8 · P0 · PREMIUM COMPARE</p><h3>İki maçlık profil panosu</h3><p>Dört ayrı sinyal: hücum, savunma riski, pres göstergesi ve kayıp bölgesi.</p><div class="metriccards">{aggregates.teams.map(t=><div class="teammetric" data-team={t.id}><h3>{t.id}</h3><dl><div><dt>xG</dt><dd>{t.xG.toFixed(2)}</dd></div><div><dt>xGA</dt><dd>{t.xGA.toFixed(2)}</dd></div><div><dt>PPDA</dt><dd>{t.ppda.toFixed(2)}</dd></div><div><dt>Kendi yarısında kayıp</dt><dd>{t.ownHalfLosses}/{t.losses}</dd></div><div><dt>Kazanım</dt><dd>{t.recoveries}</dd></div></dl></div>)}</div></article>
      </div>
      <p class="small"><strong>Kaynak ve örneklem:</strong> <a href={aggregates.source_sheet} target="_blank" rel="noopener noreferrer">UCL maç istatistikleri XLSX</a> · takım başına iki maç. Aggregate sayılar kullanıcı tarafından sağlandı; kaynak satırıyla bağımsız mutabakat henüz PASS değil. Saha olayları Google Drive CSV oyuncu kayıtlarıdır. Hover: nokta/çubuk ayrıntısı; click: takım filtresi.</p>
    </section>
    <section aria-labelledby="limits-h"><p class="eyebrow">VERI SINIRI / AUDIT</p><h2 id="limits-h">Veri sınırı ve araştırma soruları</h2><p>Bu verilerden pres mesafesi, gerçek oyuncu koşuları, pas alıcısı veya gözlenmeyen saha yerleşimi çıkarılmadı. Lille'in Brest ve Arsenal; Galatasaray'ın Sporting ve Barcelona karşısındaki farkları rakip gücü, skor durumu, tempo ve oyun süresi etkilerini birlikte taşıyor.</p><p>Sonraki kabul kapısı: CSV/XML oyuncu, takım ve kaleci katmanlarının eşleştirilmesi; XLSX tüm maçlar/lig/Avrupa referans kontrolleri; koordinat yönü ve gerçek tarayıcı testi.</p><details><summary>Kaynak dosyalarını ve örneklem büyüklüğünü göster</summary><ul>{matches.map(m=><li>{m.key}: {m.source.rows} satır — <a href={sourceUrl(m.source.drive_id)} target="_blank" rel="noopener noreferrer">Google Drive CSV kaynağı</a></li>)}</ul></details></section>
  </div>
</main>
<script is:inline>document.querySelectorAll("[data-team-filter]").forEach(b=>b.addEventListener("click",()=>{let team=b.dataset.teamFilter;document.querySelectorAll("[data-team-filter]").forEach(x=>{x.classList.toggle("chosen",x===b);x.setAttribute("aria-pressed",String(x===b))});document.querySelectorAll("#eight-graphs [data-team]").forEach(x=>{x.style.display=team==="ALL"||x.dataset.team===team?"":"none"})}))</script>
<style>
.p2{background:#0a111b;color:#eef3f7;min-height:100vh;padding:clamp(3rem,7vw,7rem) 1.1rem;font-family:inherit}.wrap{max-width:1100px;margin:auto}.eyebrow{font:700 .74rem/1.4 monospace;letter-spacing:.15em;color:#a0c4c6;text-transform:uppercase}h1{font-size:clamp(2.4rem,7vw,5.8rem);letter-spacing:-.06em;line-height:1.06;max-width:1000px;margin:.75rem 0}h1 span{display:block;color:#f2bd4f}h2{font-size:clamp(1.5rem,3vw,2.3rem);letter-spacing:-.03em}h3{font-size:1rem}p{line-height:1.7;color:#c4d1de;max-width:850px}.deck{font-size:clamp(1rem,2vw,1.3rem)}.notice{border-left:4px solid #f2bd4f;padding:1.1rem 1.3rem;background:#162131;line-height:1.6;margin:2rem 0 3rem}section{margin:4rem 0;border-top:1px solid #324255;padding-top:2rem}.plot,.zonebox,.summary article{background:#111e2e;border:1px solid #314354;border-radius:12px;padding:1.1rem}.barrow{display:grid;grid-template-columns:minmax(145px,220px) 1fr 55px;align-items:center;gap:14px;margin:17px 0}.barname{font-size:.9rem}.track{background:#2b3645;height:24px;border-radius:3px;overflow:hidden}.fill{height:100%;background:linear-gradient(90deg,#c5a35b,#f6d26a)}.small{font-size:.79rem;color:#a8bac8}.zones{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.zonegrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:3px;margin:1rem 0}.z{min-height:90px;display:flex;flex-direction:column;justify-content:center;align-items:center;background:#224052}.z1{background:#305b69}.z2{background:#3e7482}.z strong{font-size:1.6rem}.z span{font-size:.72rem}.summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.summary strong{color:#f2bd4f}a{color:#f2bd4f}details{margin:2rem 0;padding:1rem;border:1px solid #314354}summary{cursor:pointer}li{margin:.8rem 0}@media(max-width:700px){.barrow{grid-template-columns:1fr 46px;gap:6px}.barname{grid-column:1/-1}.zones,.summary{grid-template-columns:1fr}.z{min-height:76px}.p2{padding:2.5rem .7rem}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}
.viztoolbar{display:flex;flex-wrap:wrap;gap:8px;margin:1rem 0}.viztoolbar button{background:#182d3e;border:1px solid #527485;border-radius:7px;color:#fff;padding:.65rem 1rem;cursor:pointer}.viztoolbar button.chosen{background:#b89037;color:#0b1724}.vizgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.vizcard{background:#111f30;border:1px solid #2c5060;padding:1.1rem;border-radius:14px;min-width:0}.vizcard h3{font-size:1.35rem}.vizcard p{font-size:.9rem}.pitchsets{display:grid;grid-template-columns:1fr;gap:14px}.pitchfig{margin:0;padding:.5rem;background:#071923;border-radius:6px}.pitchfig svg,.metricplot{display:block;width:100%;height:auto;max-height:280px}.pitchfig figcaption{padding:.35rem;color:#e7dba7}.aggrow{display:flex;gap:12px;margin:1rem 0}.aggrow>strong{width:40px}.aggrow>div{flex:1}.minibar{display:inline-block;height:12px;background:#58c5cb;max-width:100%;vertical-align:middle}.minibar.against{background:#df9268}.metriccards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.teammetric{background:#182c3f;border:1px solid #345468;border-radius:8px;padding:1rem}.teammetric dl div{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid #345468;padding:.3rem 0}.teammetric dt{color:#c4d1de}.teammetric dd{margin:0;font-weight:700}.scrolltable{overflow-x:auto}.scrolltable table{width:100%;border-collapse:collapse;font-size:.85rem}.scrolltable th,.scrolltable td{border-bottom:1px solid #345468;padding:.6rem;text-align:left;white-space:nowrap}#eight-graphs{scroll-margin-top:120px}@media(max-width:850px){.vizgrid{grid-template-columns:1fr}}@media(max-width:700px){.metriccards{grid-template-columns:1fr}.vizcard{padding:.8rem}}
</style>
</BaseLayout>
