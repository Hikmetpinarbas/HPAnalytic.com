---
import BaseLayout from '../layouts/BaseLayout.astro';
import TacticalCanvas from '../components/TacticalCanvas.astro';
export const prerender = true;
const kinds = [
  ['TACTICAL BOARD', 'Açıklayıcı soyutlama. Tracking veya gerçek fiziksel konum iddiası değildir.'],
  ['DATA VISUAL', 'Kaynak-bağlı sayısal destek. En fazla birkaç ana metric; tek futbol sorusu.'],
  ['FRAME EVIDENCE', 'Gerçek source-bound kare. Raw frame korunur, annotation ayrı yüzeydir.'],
];
---
<BaseLayout title="Visual Lab — HPAnalytic" description="Saha geometrisi ve kanıt sınırları için responsive SVG yüzeyleri.">
<div class="listing">
  <header class="page-head">
    <p class="kicker">VISUAL LAB</p>
    <h1 class="page-title">Oyunu gör.<br/>İlişkiyi çöz.</h1>
    <p class="lead">Saha geometrisi, süreç akışı, event dağılımı, rol-fonksiyon ve evidence sınırları için responsive SVG yüzeyleri. Saha üzerindeki ilişkileri açıklayan görsel çalışmalar.</p>
  </header>
  <section class="subsection" aria-labelledby="visual-lab-schematic-title">
    <h2 id="visual-lab-schematic-title">Şematik saha anlatımı</h2>
    <p>Oyunun yapısını, aksiyon bağlantılarını ve süreçleri görsel olarak incele.</p>
    <TacticalCanvas />
    <a href="/analysis">Kanıta bağlı analizleri incele →</a>
  </section>
  <ul class="frame-grid subsection">
    {kinds.map(([name, text]) => <li><b>{name}</b><p>{text}</p></li>)}
  </ul>
</div>
</BaseLayout>
