    lost_own:{t:"Kendi yarıda top kaybı",d:0,note:"İki maçta kendi yarıda kaybedilen top. Yüksek değer = risk."},
    counter:{t:"Kontratak",d:0,note:"Sağlayıcının kontratak olarak sınıflandırdığı hücumlar."},
    xg:{t:"Üretilen xG",d:2,note:"İki maç toplam beklenen gol."},
    oxg:{t:"Verilen xG",d:2,note:"Rakibe izin verilen toplam beklenen gol."}
  };
  const teams = Object.keys(AGG);
  const svg = document.getElementById('swarm');
  let W=960, H=300, L=40, R=40, cy=150, small=false, cur='ppda';
  function size(){ W=Math.max(300,Math.round(svg.parentNode.clientWidth-28)); small=W<600; H=small?260:300; cy=small?128:150; L=small?14:40; R=small?14:40; svg.setAttribute('viewBox',`0 0 ${W} ${H}`); }
  size();
  const axis = el('g',{},svg), medG = el('g',{},svg);
  const dots = {}, labs = {};
  teams.forEach(k=>{
    const hi = k==='FEN'?'fen':k==='SLA'?'sla':null;
    dots[k] = el('circle',{class:'dot',r:hi?(small?9:11):(small?5:7),cx:W/2,cy,fill:hi?`var(--${hi})`:'var(--grey)',stroke:'var(--night)','stroke-width':2,opacity:hi?1:.85},svg);
    const tt = el('title',{},dots[k]); tt.textContent=k;
  });
  ['FEN','SLA'].forEach(k=>{ dots[k].parentNode.appendChild(dots[k]); labs[k]=el('text',{class:'lab','text-anchor':'middle',fill:k==='FEN'?'var(--fen)':'var(--sla)'},svg); });
  const tabs = document.getElementById('tabs');
  Object.entries(M).forEach(([k,m],i)=>{ const b=document.createElement('button'); b.type='button'; b.textContent=m.t; b.dataset.m=k; b.setAttribute('aria-pressed', i===0?'true':'false'); tabs.appendChild(b); });
  tabs.addEventListener('click',e=>{ const b=e.target.closest('button'); if(!b) return; tabs.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed', x===b?'true':'false')); draw(b.dataset.m); });
  function draw(key){
    cur=key; const m=M[key]; const vals=teams.map(t=>AGG[t][key]);
    let lo=Math.min(...vals), hi=Math.max(...vals); const pad=(hi-lo)*.06; lo-=pad; hi+=pad;
    const x = v => m.rev ? L+(hi-v)/(hi-lo)*(W-L-R) : L+(v-lo)/(hi-lo)*(W-L-R);
    // dodge
    const order = teams.slice().sort((a,b)=>AGG[a][key]-AGG[b][key]);
    const placed=[];
    order.forEach(t=>{
      const px=x(AGG[t][key]); const r=(t==='FEN'||t==='SLA')?(small?9:11):(small?5:7);
      let y=cy, step=0;
      for(;;){ const ok=placed.every(p=>Math.hypot(p.x-px,p.y-y)>=p.r+r+2); if(ok) break; step++; y = cy + (step%2?1:-1)*Math.ceil(step/2)*(small?5:7); }
      placed.push({x:px,y,r,t});
      dots[t].setAttribute('cx',px); dots[t].setAttribute('cy',y);
    });
    axis.innerHTML='';
    el('line',{x1:L,x2:W-R,y1:H-32,y2:H-32,stroke:'var(--line-2)'},axis);
    const ticks=small?3:5; for(let i=0;i<=ticks;i++){ const v=lo+pad+(hi-lo-2*pad)*i/ticks; const tx=x(v); el('line',{x1:tx,x2:tx,y1:H-36,y2:H-28,stroke:'var(--line-2)'},axis); const tl=el('text',{x:tx,y:H-12,class:'ax','text-anchor':i===0?'start':i===ticks?'end':'middle'},axis); tl.textContent=fmt(v,m.d); }
    const lt=el('text',{x:L,y:22,class:'ax'},axis); lt.textContent = m.rev ? '← daha az pres' : '← düşük';
    const rt=el('text',{x:W-R,y:22,class:'ax','text-anchor':'end'},axis); rt.textContent = m.rev ? 'daha yoğun pres →' : 'yüksek →';
    const sorted=vals.slice().sort((a,b)=>a-b); const med=(sorted[17]+sorted[18])/2;
    medG.innerHTML=''; el('line',{x1:x(med),x2:x(med),y1:40,y2:H-38,stroke:'var(--chalk)','stroke-dasharray':'3 5',opacity:.45},medG);
    const mt=el('text',{x:x(med)+6,y:52,class:'ax'},medG); mt.textContent='medyan '+fmt(med,m.d);
    ['FEN','SLA'].forEach(t=>{ const p=placed.find(q=>q.t===t); labs[t].setAttribute('x',p.x); labs[t].setAttribute('y', p.y<cy? p.y-18 : p.y+30); labs[t].textContent = (t==='FEN'?'FB ':'SLA ')+fmt(AGG[t][key],m.d); });
    const rank = t => { const s=teams.slice().sort((a,b)=> m.rev ? AGG[a][key]-AGG[b][key] : AGG[b][key]-AGG[a][key]); return s.findIndex(q=>AGG[q][key]===AGG[t][key])+1; };
    const word = m.rev ? 'en yoğun' : 'en yüksek';
    document.getElementById('readout').innerHTML = `<b>${m.t}.</b> ${m.note} Fenerbahçe <b class="fen num">${fmt(AGG.FEN[key],m.d)}</b> ile ${word} ${rank('FEN')}. sırada; Slavia <b class="sla num">${fmt(AGG.SLA[key],m.d)}</b> ile ${rank('SLA')}. sırada (36 takım, eşitlikte aynı sıra).`;
  }
  draw('ppda');
  let rt; addEventListener('resize',()=>{ clearTimeout(rt); rt=setTimeout(()=>{ const was=small; size(); if(was!==small){ teams.forEach(k=>{const hi=k==='FEN'||k==='SLA'; dots[k].setAttribute('r',hi?(small?9:11):(small?5:7));}); } draw(cur); },150); });
})();

