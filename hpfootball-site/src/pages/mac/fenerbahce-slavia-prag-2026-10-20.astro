(function(){
  const svg=document.getElementById('cpitch'); drawPitch(svg,false);
  const z=el('g',{},svg);
  [35,70].forEach(v=>el('line',{x1:v,x2:v,y1:0,y2:68,stroke:'var(--chalk)','stroke-width':.25,'stroke-dasharray':'1 1.2',opacity:.5},z));
  [['1. bölge',17.5],['2. bölge',52.5],['3. bölge',87.5]].forEach(([t,xx])=>{ const tx=el('text',{x:xx,y:-2,'text-anchor':'middle',class:'ax',style:'font-size:2.8px'},z); tx.textContent=t; });
  const dir=el('text',{x:104,y:72,'text-anchor':'end',class:'ax',style:'font-size:2.4px'},z);
  const g=el('g',{},svg);
  const C={avl:{d:TEAM.avl_counters,c:'var(--chalk-2)',who:'Aston Villa',vs:'Fenerbahçe kalesi',txt:(a,b,c)=>`Villa'nın 11 kontratağından <b>${a}</b>'ü kendi ilk 35 metresinden, <b>${b}</b>'ü orta bölgeden, <b>${c}</b>'ü son bölgeden başladı. Yüksekte başlayan kontratak, topun Fenerbahçe'nin hücum kurulumu sırasında kaybedildiğine işaret eder; savunmanın geride dengede olmadığı anlar burada aranmalı.`},
           sla:{d:TEAM.sla_counters,c:'var(--sla)',who:'Slavia Prag',vs:'Sabah kalesi',txt:(a,b,c)=>`Slavia'nın 18 kontratağından <b>${a}</b>'si kendi ilk 35 metresinden başladı. Yani Slavia yalnız önde baskıyla değil, derinden çıkan geçişlerle de hücum ediyor. Fenerbahçe'nin hücumda topu kaybettiği anlar bu takım için iki ayrı kapı açabilir.`}};
  function set(k){
    const o=C[k]; g.innerHTML=''; dir.textContent=`${o.who} hücum yönü → (${o.vs})`;
    o.d.forEach(([x,y,h],i)=>{ const Y=68-y; const n=el('g',{style:`animation:pop .45s ${i*35}ms both;transform-origin:${x}px ${Y}px`},g);
      el('line',{x1:x,y1:Y,x2:Math.min(x+9,104),y2:Y,stroke:o.c,'stroke-width':.5,opacity:.55},n);
      el('circle',{cx:x,cy:Y,r:1.5,fill:o.c},n); el('title',{},n).textContent=`${o.who} kontratağı · ${h}. devre · ${Math.round(105-x)} m kaleye`; });
    const a=o.d.filter(d=>d[0]<=35).length, b=o.d.filter(d=>d[0]>35&&d[0]<=70).length, c=o.d.length-a-b;
    document.getElementById('czones').innerHTML=`<div class="row"><span class="mono"><span lang="en">${o.who}</span> · kontratak başlangıcı, bölgelere göre</span><div class="stack">
      <div style="flex:${a||.001} 1 0;background:var(--line-2);color:var(--chalk)">1. bölge ${a}</div><div style="flex:${b||.001} 1 0;background:var(--grey);color:var(--chalk)">2. bölge ${b}</div><div style="flex:${c||.001} 1 0;background:${k==='avl'?'var(--fen)':'var(--sla)'};color:var(--fen-ink)">3. bölge ${c}</div></div></div>`;
    document.getElementById('cread').innerHTML=o.txt(a,b,c);
  }
  document.getElementById('ctabs').addEventListener('click',e=>{ const b=e.target.closest('button'); if(!b) return; document.querySelectorAll('#ctabs button').forEach(x=>x.setAttribute('aria-pressed',x===b?'true':'false')); set(b.dataset.c); });
  set('avl');
})();

