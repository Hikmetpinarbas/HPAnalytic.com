  const rec=el('g',{},svg), loss=el('g',{},svg);
  EV.sla_rec.forEach(([x,y,p,h],i)=>{ const r=el('rect',{x:x-1.3,y:68-y-1.3,width:2.6,height:2.6,fill:'var(--sla)',opacity:.92,style:`transform-origin:${x}px ${68-y}px;animation:pop .5s ${i*40}ms both`},rec); el('title',{},r).textContent=`Slavia kazanımı · ${p} · ${h}. devre`; });
  EV.fen_loss.forEach(([x,y,p,h],i)=>{ const X=105-x, Y=68-(68-y); const g=el('g',{stroke:'var(--fen)','stroke-width':.7,style:`transform-origin:${X}px ${Y}px;animation:pop .5s ${300+i*40}ms both`},loss); el('path',{d:`M${X-1.3} ${Y-1.3}L${X+1.3} ${Y+1.3}M${X+1.3} ${Y-1.3}L${X-1.3} ${Y+1.3}`},g); el('title',{},g).textContent=`FB kaybı · ${p} · ${h}. devre`; });
  const st=document.createElement('style'); st.textContent='@keyframes pop{from{transform:scale(0)}to{transform:scale(1)}}@media (prefers-reduced-motion:reduce){#pitch *{animation:none!important}}'; document.head.appendChild(st);
  const read=document.getElementById('pread');
  const z2r=EV.sla_rec.filter(d=>d[0]<=70).length, z2l=EV.fen_loss.filter(d=>105-d[0]<=70).length;
  const texts={
    both:`Slavia'nın 13 rakip yarı kazanımının <b class="sla">${z2r}</b>'i 2. bölgede, yani orta sahanın hemen ilerisinde. Fenerbahçe'nin 11 kaybının <b class="fen">${z2l}</b>'i Slavia'nın hücum yönünden bakınca aynı bantta kalıyor. İki dağılımın üst üste binmesi, Slavia'nın topu kazanmak istediği yer ile Fenerbahçe'nin topu bıraktığı yerin aynı olabileceğini gösteriyor.`,
    rec:`Slavia'nın 13 kazanımından 12'si 2. bölgede, biri 3. bölgenin hemen başında; kaleye en yakın kazanım 32 metre. Bunların 4'ü Wiktor Nowak'ın, hepsi ikinci yarıda.`,
    loss:`Fenerbahçe'nin 11 kaybından 4'ü Vedat Muriqi'de; hedef oyuncuya oynanan topların geri dönmemesiyle tutarlı, ama bu dosya pasın türünü göstermiyor.`
  };
  function set(l){ rec.style.opacity = l==='loss'?.12:1; loss.style.opacity = l==='rec'?.12:1; read.innerHTML=texts[l]; }
  document.getElementById('ptabs').addEventListener('click',e=>{ const b=e.target.closest('button'); if(!b) return; document.querySelectorAll('#ptabs button').forEach(x=>x.setAttribute('aria-pressed',x===b?'true':'false')); set(b.dataset.l); });
  [rec,loss].forEach(g=>g.style.transition='opacity .4s');
  set('both');
})();

/* shot maps */
function shotMap(id, data, ring){
  const svg=document.getElementById(id); drawPitch(svg,true);
  const g=el('g',{},svg);
  data.forEach(([x,y,k,h])=>{
    const Y=68-y; let n;
    if(k==='goal'){ n=el('g',{},g); el('circle',{cx:x,cy:Y,r:1.6,fill:'var(--chalk)'},n); el('circle',{cx:x,cy:Y,r:2.4,fill:'none',stroke:ring,'stroke-width':.5},n); }
    else if(k==='on'){ n=el('g',{},g); el('circle',{cx:x,cy:Y,r:1.6,fill:'var(--band)',stroke:'var(--chalk)','stroke-width':.45},n); el('circle',{cx:x,cy:Y,r:.5,fill:'var(--chalk)'},n); }
    else if(k==='blk'){ n=el('rect',{x:x-1.3,y:Y-1.3,width:2.6,height:2.6,fill:'var(--band)',stroke:'var(--chalk-2)','stroke-width':.45,transform:`rotate(45 ${x} ${Y})`},g); }
    else { n=el('circle',{cx:x,cy:Y,r:1.6,fill:'none',stroke:'var(--mute)','stroke-width':.45,'stroke-dasharray':'.6 .6'},g); }
    el('title',{},n).textContent=`${({goal:'Gol',on:'İsabetli',blk:'Bloklandı',off:'İsabetsiz',post:'Direk'})[k]||k} · ${h}. devre`;
  });
}
shotMap('shot-sla', TEAM.sla_shots, 'var(--sla)');
shotMap('shot-avl', TEAM.avl_shots, 'var(--fen)');

/* counterattack origins */
(function(){
  const svg=document.getElementById('cpitch'); drawPitch(svg,false);
  const z=el('g',{},svg);
  [35,70].forEach(v=>el('line',{x1:v,x2:v,y1:0,y2:68,stroke:'var(--chalk)','stroke-width':.25,'stroke-dasharray':'1 1.2',opacity:.5},z));
  [['1. bölge',17.5],['2. bölge',52.5],['3. bölge',87.5]].forEach(([t,xx])=>{ const tx=el('text',{x:xx,y:-2,'text-anchor':'middle',class:'ax',style:'font-size:2.8px'},z); tx.textContent=t; });
  const dir=el('text',{x:104,y:72,'text-anchor':'end',class:'ax',style:'font-size:2.4px'},z);
  const g=el('g',{},svg);
  const C={avl:{d:TEAM.avl_counters,c:'var(--chalk-2)',who:'Aston Villa',vs:'Fenerbahçe kalesi',txt:(a,b,c)=>`Villa'nın 11 kontratağından <b>${a}</b>'ü kendi ilk 35 metresinden, <b>${b}</b>'ü orta bölgeden, <b>${c}</b>'ü son bölgeden başladı. Yüksekte başlayan kontratak, topun Fenerbahçe'nin hücum kurulumu sırasında kaybedildiğine işaret eder; savunmanın geride dengede olmadığı anlar burada aranmalı.`},
           sla:{d:TEAM.sla_counters,c:'var(--sla)',who:'Slavia Prag',vs:'Sabah kalesi',txt:(a,b,c)=>`Slavia'nın 18 kontratağından <b>${a}</b>'si kendi ilk 35 metresinden başladı. Yani Slavia yalnız önde baskıyla değil, derinden çıkan geçişlerle de hücum ediyor. Fenerbahçe'nin hücumda topu kaybettiği anlar bu takım için iki ayrı kapı açabilir.`}};
  function set(k){
    const o=C[k]; g.innerHTML=''; dir.textContent=`${o.who} hücum yönü → (${o.vs})`;
    o.d.forEach(([x,y,h],i)=>{ const Y=68-y; const n=el('g',{style:`animation:pop .45s ${i*35}ms both;transform-origin:${x}px ${Y}px`},g);
      el('line',{x1:x,y1:Y,x2:Math.min(x+9,104),y2:Y,stroke:o.c,'stroke-width':.5,opacity:.55},n);
      el('circle',{cx:x,cy:Y,r:1.5,fill:o.c},n); el('title',{},n).textContent=`${o.who} kontratağı · ${h}. devre · ${Math.round(105-x)} m kaleye`; });
    const a=o.d.filter(d=>d[0]<=35).length, b=o.d.filter(d=>d[0]>35&&d[0]<=70).length, c=o.d.length-a-b;
    document.getElementById('czones').innerHTML=`<div class="row"><span class="mono"><span lang="en">${o.who}</span> · kontratak başlangıcı, bölgelere göre</span><div class="stack">
      <div style="flex:${a||.001} 1 0;background:var(--line-2);color:var(--chalk)">1. bölge ${a}</div><div style="flex:${b||.001} 1 0;background:var(--grey);color:var(--chalk)">2. bölge ${b}</div><div style="flex:${c||.001} 1 0;background:${k==='avl'?'var(--fen)':'var(--sla)'};color:var(--fen-ink)">3. bölge ${c}</div></div></div>`;
    document.getElementById('cread').innerHTML=o.txt(a,b,c);
  }
  document.getElementById('ctabs').addEventListener('click',e=>{ const b=e.target.closest('button'); if(!b) return; document.querySelectorAll('#ctabs button').forEach(x=>x.setAttribute('aria-pressed',x===b?'true':'false')); set(b.dataset.c); });
  set('avl');
})();

/* xG gaps */
(function(){
  const rows=[
    {who:'Slavia Prag',sub:'Hücum · xG → gol',c:'sla',xg:5.06,g:2},
    {who:'Fenerbahçe',sub:'Hücum · xG → gol',c:'fen',xg:2.73,g:1},
    {who:'Slavia Prag',sub:'Savunma · verilen xG → yenen',c:'sla',xg:3.23,g:5},
    {who:'Fenerbahçe',sub:'Savunma · verilen xG → yenen',c:'fen',xg:3.86,g:7}
  ];
  const max=8, box=document.getElementById('gaps');
  box.innerHTML=rows.map(r=>{
    const a=r.xg/max*100, b=r.g/max*100, lo=Math.min(a,b), w=Math.abs(a-b), d=r.g-r.xg;
    return `<div class="gap-row"><div class="who ${r.c}">${r.who}<small>${r.sub}</small></div>
      <div><div class="db" role="img" aria-label="${r.who}, ${r.sub}: xG ${fmt(r.xg)}, gol ${r.g}">
        <span class="db-bar" style="left:${lo}%;width:${w}%;background:var(--${r.c})"></span>
        <span class="db-x" style="left:${a}%"></span><span class="db-g" style="left:${b}%"></span>
      </div><span class="mono num db-t">xG ${fmt(r.xg)} · gol ${r.g} · fark ${d>0?'+':''}${fmt(d)}</span></div></div>`;
  }).join('') + `<div class="gap-row"><span></span><div class="db-axis mono num"><span>0</span><span>2</span><span>4</span><span>6</span><span>8</span></div></div>`;
})();

/* corridors */
(function(){
  const C={FEN:{l:[41,6],c:[37,8],r:[38,6]},SLA:{l:[61,8],c:[32,7],r:[55,4]}};
  const box=document.getElementById('corr');
  box.innerHTML=Object.entries(C).map(([t,v])=>{
    const tot=v.l[0]+v.c[0]+v.r[0], c=t==='FEN'?'fen':'sla';
    const seg=(k,name,op)=>`<div style="flex:${v[k][0]} 1 0;background:var(--${c});color:var(--${c}-ink);opacity:${op}" title="${name}: ${v[k][0]} hücum, ${v[k][1]} şutla">${name} ${v[k][0]}·${v[k][1]}</div>`;
    return `<div class="row"><span class="mono ${c}">${t==='FEN'?'Fenerbahçe':'Slavia Prag'} · ${tot} hücum · kanat payı %${Math.round((v.l[0]+v.r[0])/tot*100)}</span>
    <div class="stack">${seg('l','Sol',1)}${seg('c','Orta',.55)}${seg('r','Sağ',1)}</div></div>`;
  }).join('');
})();

</script>
<style is:global>
.mp{
  --night:var(--bg); --band:var(--bg-2); --raise:var(--panel); --line:var(--line); --line-2:var(--line-2);
  --chalk:var(--ink); --chalk-2:var(--ink-2); --mute:var(--muted);
  --fen:var(--amber); --fen-ink:var(--amber-ink); --sla:#E8EDF6; --sla-ink:#071233; --grey:#3A5590; --sage:var(--amber);
  --f-display:var(--display); --f-body:var(--reading); --f-mono:var(--mono);
  background:var(--night); color:var(--chalk); font:400 1.0625rem/1.6 var(--f-body);
}

.mp /* Layout: FT-style reading column (64ch) broken by full-bleed "floodlit" chart bands; scoreboard type for numbers,.mp editorial serif for argument. */

a{color:var(--chalk);text-decoration-color:var(--sage);text-underline-offset:3px}
.mp :focus-visible{outline:2px solid var(--focus);outline-offset:3px;border-radius:2px}
.mp .wrap{max-width:1180px;margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.mp .col{max-width:64ch}
.mp .eyebrow,.mp .mono{font-family:var(--f-mono);font-size:.75rem;letter-spacing:.12em;color:var(--mute)}
.mp h1,.mp h2,.mp h3{font-family:var(--f-display);font-weight:700;letter-spacing:.01em;line-height:.95;text-wrap:balance;margin:0}
.mp h2{font-size:clamp(2rem,5.2vw,3.4rem)}
.mp h3{font-size:1.35rem;letter-spacing:.03em}
.mp p{margin:0}
.mp .num{font-variant-numeric:tabular-nums}
.mp .fen{color:var(--fen)} .mp .sla{color:var(--sla)}

.mp /* hero */
.hero{padding-block:clamp(36px,7vw,84px) 28px;position:relative;overflow:hidden;border-bottom:6px solid var(--fen)}
.mp .hero::before{content:"";position:absolute;inset:-30% -10% auto;height:120%;background:radial-gradient(ellipse 55% 60% at 15% 25%,color-mix(in srgb,var(--fen) 22%,transparent),transparent 70%),radial-gradient(ellipse 60% 45% at 90% 0%,color-mix(in srgb,#1C4DB8 55%,transparent),transparent 70%);pointer-events:none;animation:flood 9s ease-in-out infinite alternate}
@keyframes flood{to{transform:translateY(4%) scale(1.04)}}
.mp .hero .wrap{position:relative;display:grid;gap:22px;grid-template-columns:minmax(0,1fr)}
.mp .hero .wrap>*{min-width:0}
.mp .versus span{overflow-wrap:break-word}
.mp .versus{display:grid;grid-template-columns:1fr;gap:2px;font-family:var(--f-display);font-weight:900;font-size:clamp(2.9rem,11.5vw,8.6rem);line-height:.86;letter-spacing:-.005em}
.mp .versus .v{font-size:.32em;color:var(--mute);font-weight:500;letter-spacing:.2em;padding-block:.15em}
.mp .thesis{font-size:clamp(1.2rem,2.6vw,1.6rem);line-height:1.35;max-width:36ch;color:var(--chalk)}
.mp .thesis em{font-style:italic;color:var(--chalk-2)}
.mp .meta{display:flex;flex-wrap:wrap;gap:8px 18px}
.mp .meta div{display:grid;gap:2px}
.mp .meta b{font-family:var(--f-display);font-weight:700;font-size:1.25rem;letter-spacing:.02em}
.mp .count{display:flex;gap:10px;align-items:baseline;flex-wrap:wrap}
.mp .count .n{font-family:var(--f-display);font-weight:900;font-size:2.4rem;line-height:1}
.mp .count .u{font-family:var(--f-mono);font-size:.7rem;color:var(--mute);margin-right:8px}

.mp /* ticker */
.ticker{border-block:1px solid var(--line);overflow:hidden;background:var(--band)}
.mp .ticker-track{display:flex;width:max-content;animation:tick 48s linear infinite}
.mp .ticker:hover .ticker-track{animation-play-state:paused}
.mp .ticker-item{display:flex;align-items:baseline;gap:10px;padding:12px 28px;border-right:1px solid var(--line);white-space:nowrap}
.mp .ticker-item b{font-family:var(--f-display);font-size:1.5rem;font-weight:700}
.mp .ticker-item span{font-family:var(--f-mono);font-size:.75rem;color:var(--chalk-2);letter-spacing:.04em}
@keyframes tick{to{transform:translateX(-50%)}}

.mp /* sections */
section.block{padding-block:clamp(44px,7vw,88px);border-bottom:1px solid var(--line)}
.mp section.band{background:var(--band)}
.mp .head{display:grid;gap:12px;margin-bottom:28px;grid-template-columns:minmax(0,1fr)}
.mp h1,.mp h2,.mp h3,.mp .lede,.mp .eyebrow,.mp .readout,.mp .claim span{overflow-wrap:break-word;hyphens:auto}
.mp .lede{color:var(--chalk-2);font-size:1.075rem}
.mp .claim{display:flex;gap:10px;align-items:flex-start;margin-top:18px;padding:12px 14px;border:1px solid var(--line);border-radius:4px;background:var(--raise);font-size:.95rem;color:var(--chalk-2)}
.mp .claim>span:last-child{min-width:0}
.mp .meta-table td{overflow-wrap:anywhere}
.mp .legend span,.mp .figcap span,.mp .qs li *{min-width:0;overflow-wrap:break-word}
.mp .ev{flex:none;font-family:var(--f-mono);font-size:.75rem;letter-spacing:.1em;padding:3px 6px;border-radius:3px;border:1px solid currentColor;margin-top:3px}
.mp .ev.obs{color:#9FE3BC}.mp .ev.mod{color:#9EC3FF}.mp .ev.der{color:#FFD31A}.mp .ev.hyp{color:#F2B8DC}

.mp /* match rail */
.rail{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(260px,1fr);gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:10px;scrollbar-color:var(--line-2) transparent}
.mp .mcard{scroll-snap-align:start;border:1px solid var(--line);border-radius:4px;background:var(--raise);padding:16px;display:grid;gap:14px;transition:transform .25s ease,border-color .25s ease}
.mp .mcard:hover{transform:translateY(-3px);border-color:var(--line-2)}
.mp .mcard .top{display:flex;justify-content:space-between;gap:8px}
.mp .score{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px;font-family:var(--f-display)}
.mp .score .t{font-weight:700;font-size:1.05rem;line-height:1;min-width:0;overflow-wrap:anywhere}
.mp .score .t:last-child{text-align:right}
.mp .score .g{font-weight:900;font-size:2.3rem;white-space:nowrap;line-height:1;font-variant-numeric:tabular-nums}
.mp .xgbar{display:grid;gap:6px}
.mp .xgbar .row{display:grid;grid-template-columns:40px 1fr 40px;align-items:center;gap:8px;font-family:var(--f-mono);font-size:.75rem}
.mp .xgbar .row span:last-child{text-align:right}
.mp .track{height:8px;border-radius:2px;background:var(--line);display:flex;overflow:hidden}
.mp .track i{display:block;height:100%}
.mp .mstats{display:flex;justify-content:space-between;gap:8px;font-family:var(--f-mono);font-size:.75rem;color:var(--mute);border-top:1px solid var(--line);padding-top:10px}
.mp .mstats b{display:block;color:var(--chalk);font-size:.85rem;font-weight:500}

.mp /* tabs */
.tabs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
.mp .tabs button{font:500 .74rem var(--f-mono);letter-spacing:.06em;color:var(--chalk-2);background:transparent;border:1px solid var(--line-2);border-radius:999px;padding:9px 13px;min-height:40px;cursor:pointer;transition:background .2s,color .2s}
.mp .tabs button[aria-pressed="true"]{background:var(--chalk);color:var(--night);border-color:var(--chalk)}
.mp .figure{border:1px solid var(--line);border-radius:4px;background:var(--night);padding:14px;overflow-x:auto}
.mp .figure svg{display:block;width:100%;height:auto}
.mp .figcap{display:flex;flex-wrap:wrap;gap:6px 18px;justify-content:space-between;margin-top:10px;font-family:var(--f-mono);font-size:.75rem;color:var(--mute)}
.mp .readout{font-size:1.05rem;margin-top:14px;min-height:3.2em;color:var(--chalk-2)}
.mp .readout b{color:var(--chalk)}
.mp .ax{font-family:var(--f-mono);font-size:11px;fill:var(--mute)}
.mp .lab{font-family:var(--f-display);font-weight:700;font-size:16px;letter-spacing:.03em}
.mp .dot{transition:cx .7s cubic-bezier(.2,.8,.2,1),cy .7s cubic-bezier(.2,.8,.2,1)}

.mp /* two-col */
.duo{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:16px}
.mp .duo > *{min-width:0}
.mp .legend{display:flex;flex-wrap:wrap;gap:8px 16px;font-family:var(--f-mono);font-size:.7rem;color:var(--chalk-2);margin-top:10px}
.mp .legend span{display:inline-flex;align-items:center;gap:6px}
.mp .sw{width:12px;height:12px;display:inline-block}

.mp /* dumbbell */
.gap-grid{display:grid;gap:18px}
.mp .gap-row{display:grid;grid-template-columns:minmax(0,170px) minmax(0,1fr);gap:12px;align-items:center}
.mp .gap-row .who{font-family:var(--f-display);font-weight:700;font-size:1.05rem;line-height:1.05}
.mp .gap-row .who small{display:block;font-family:var(--f-mono);font-weight:400;font-size:.75rem;color:var(--mute);letter-spacing:.06em;margin-top:3px}

.mp .db{position:relative;height:22px;margin-inline:7px}
.mp .db::before{content:"";position:absolute;left:0;right:0;top:10px;height:1px;background:var(--line-2)}
.mp .db-bar{position:absolute;top:8px;height:5px;opacity:.5}
.mp .db-x,.mp .db-g{position:absolute;top:3px;width:15px;height:15px;margin-left:-7.5px;border-radius:50%}
.mp .db-x{border:2px solid var(--chalk);background:var(--night)}
.mp .db-g{background:var(--chalk)}
.mp .db-t{display:block;margin-top:4px;letter-spacing:.03em;}
.mp .db-axis{display:flex;justify-content:space-between;margin-inline:7px;letter-spacing:0;}
.mp /* corridors */
.corr{display:grid;gap:14px}
.mp .corr .row{display:grid;gap:6px}
.mp .stack{display:flex;height:34px;border-radius:3px;overflow:hidden;gap:2px}
.mp .stack div{display:flex;align-items:center;justify-content:center;font-family:var(--f-mono);font-size:.75rem;white-space:nowrap;overflow:hidden;min-width:0;transition:flex-basis .8s ease}

.mp /* questions */
.qs{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:12px;margin:0;padding:0;list-style:none}
.mp .qs li{border-top:2px solid var(--line-2);padding-top:12px;display:grid;gap:8px}
.mp .qs li .tag{font-family:var(--f-mono);font-size:.75rem;letter-spacing:.1em;color:var(--sage)}
.mp .qs li p{font-size:1.02rem}
.mp .qs li small{font-family:var(--f-mono);font-size:.75rem;color:var(--mute)}

.mp /* sources */
.src{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:20px 32px;font-size:.92rem;color:var(--chalk-2)}
.mp .src h3{font-size:1rem;margin-bottom:8px}
.mp .src ul{margin:0;padding-left:18px;display:grid;gap:6px}
.mp .meta-table{width:100%;border-collapse:collapse;font-family:var(--f-mono);font-size:.75rem}
.mp .meta-table td{border-top:1px solid var(--line);padding:7px 8px 7px 0;vertical-align:top;color:var(--chalk-2)}
.mp .meta-table td:first-child{color:var(--mute);width:34%;letter-spacing:.08em}
@media (prefers-reduced-motion:reduce){
  .mp .hero::before,.mp .ticker-track{animation:none}
  .mp .ticker{overflow-x:auto}
  .mp .dot,.mp .stack div,.mp .mcard{transition:none}
}

.mp h2{font-weight:500;letter-spacing:-.005em;line-height:1.02}
.mp .versus{font-family:var(--display);letter-spacing:-.01em;font-weight:500}
.mp .versus .v{font-family:var(--ui)}
