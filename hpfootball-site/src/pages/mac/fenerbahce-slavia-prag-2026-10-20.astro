/* pitch helpers */
function drawPitch(svg, half){
  const g = el('g',{fill:'none',stroke:'var(--line-2)','stroke-width':.35},svg);
  el('rect',{x:0,y:0,width:105,height:68,fill:'var(--band)'},g);
  if(!half){ el('line',{x1:52.5,y1:0,x2:52.5,y2:68},g); el('circle',{cx:52.5,cy:34,r:9.15},g); el('rect',{x:0,y:13.84,width:16.5,height:40.32},g); el('rect',{x:0,y:24.84,width:5.5,height:18.32},g); el('rect',{x:-1.6,y:30.34,width:1.6,height:7.32},g); }
  else { el('path',{d:'M52.5 0 V68'},g); el('path',{d:'M52.5 24.85 A9.15 9.15 0 0 1 52.5 43.15'},g); }
  el('rect',{x:88.5,y:13.84,width:16.5,height:40.32},g); el('rect',{x:99.5,y:24.84,width:5.5,height:18.32},g); el('rect',{x:105,y:30.34,width:1.6,height:7.32},g);
  el('circle',{cx:94,cy:34,r:.45,fill:'var(--line-2)'},g);
  return g;
}

/* recovery / loss overlay */
(function(){
  const svg=document.getElementById('pitch');
