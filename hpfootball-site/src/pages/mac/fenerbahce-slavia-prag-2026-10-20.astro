/* countdown */
(function(){
  const ko = new Date("2026-10-20T19:45:00+03:00").getTime();
  const box = document.getElementById('count');
  function tick(){
    const ms = ko - Date.now();
    if (ms <= 0) { box.innerHTML = ms > -2*3600e3 ? '<span class="n">Maç oynanıyor</span>' : '<span class="n">Maç tamamlandı</span><span class="mono" style="width:100%">Bu sayfa maç öncesi analizdir</span>'; return; }
    document.getElementById('cd-h').textContent = Math.floor(ms/3600e3);
    document.getElementById('cd-m').textContent = String(Math.floor(ms%3600e3/60e3)).padStart(2,'0');
  }
  tick(); setInterval(tick, 30e3);
})();

