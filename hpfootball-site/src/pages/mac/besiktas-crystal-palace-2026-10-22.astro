<script is:inline>
(function(){
  var KICK=new Date('2026-10-22T22:00:00+03:00');
  function cd(){var ms=KICK-new Date();var h=document.getElementById('cd-h'),m=document.getElementById('cd-m');
    if(!h||!m)return; if(ms<=0){h.textContent='00';m.textContent='00';return;}
    var s=Math.floor(ms/1000);h.textContent=String(Math.floor(s/3600)).padStart(2,'0');
    m.textContent=String(Math.floor(s%3600/60)).padStart(2,'0');}
  cd(); setInterval(cd,30000);
  var cv=document.getElementById('eurocanvas'); if(!cv) return;
  var ctx=cv.getContext('2d'), w=0,h=0,t0=performance.now(),raf=null;
  var reduce=window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  var dust=[]; for(var i=0;i<60;i++)dust.push({x:Math.random(),y:Math.random(),r:Math.random()*0.9+0.2,s:Math.random()*0.4+0.1,o:Math.random()*0.35+0.1});
  function size(){var r=cv.getBoundingClientRect(),d=Math.min(window.devicePixelRatio||1,2);
    w=r.width;h=r.height;cv.width=w*d;cv.height=h*d;ctx.setTransform(d,0,0,d,0,0);}
  function frame(now){
    var e=(now-t0)/1000; ctx.clearRect(0,0,w,h);
    var cx=w/2, cy=h*0.5, rx=Math.min(w*0.42,460), ry=rx*0.30;
    var gr=ctx.createRadialGradient(cx,cy,0,cx,cy,rx*1.5);
    gr.addColorStop(0,'rgba(242,240,236,0.05)');gr.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=gr;ctx.fillRect(0,0,w,h);
    var bx=((e*0.08)%1)*w*1.6-w*0.3, lg=ctx.createLinearGradient(bx-120,0,bx+120,h);
    lg.addColorStop(0,'rgba(242,240,236,0)');lg.addColorStop(.5,'rgba(242,240,236,0.03)');lg.addColorStop(1,'rgba(242,240,236,0)');
    ctx.fillStyle=lg;ctx.fillRect(0,0,w,h);
    dust.forEach(function(d){var y=((d.y+e*d.s*0.02)%1);ctx.beginPath();ctx.arc(d.x*w,y*h,d.r,0,6.283);
      ctx.fillStyle='rgba(242,240,236,'+d.o*0.5+')';ctx.fill();});
    ctx.beginPath();ctx.ellipse(cx,cy,rx,ry,0,0,6.283);ctx.strokeStyle='rgba(242,240,236,0.09)';ctx.lineWidth=1;ctx.stroke();
    var rot=e*0.09, N=36, HOME=4, AWAY=22;
    function pos(i){var a=rot+(i/N)*6.283;return{x:cx+Math.cos(a)*rx,y:cy+Math.sin(a)*ry,d:(Math.sin(a)+1)/2};}
    var A=pos(HOME),B=pos(AWAY),pulse=0.2+0.18*Math.sin(e*1.5);
    ctx.beginPath();ctx.moveTo(A.x,A.y);ctx.quadraticCurveTo(cx,cy-ry*1.5,B.x,B.y);
    ctx.strokeStyle='rgba(194,40,30,'+pulse+')';ctx.lineWidth=1.3;ctx.stroke();
    for(var i=0;i<N;i++){var p=pos(i),lead=(i===HOME||i===AWAY),r=lead?(i===HOME?4.2:3.4):1.5+p.d*0.9;
      ctx.beginPath();ctx.arc(p.x,p.y,r,0,6.283);
      if(i===HOME){ctx.fillStyle='rgba(242,240,236,0.98)';ctx.shadowColor='rgba(242,240,236,0.9)';ctx.shadowBlur=14+6*Math.sin(e*2);}
      else if(i===AWAY){ctx.fillStyle='rgba(140,145,153,0.95)';ctx.shadowColor='rgba(140,145,153,0.7)';ctx.shadowBlur=10;}
      else{ctx.fillStyle='rgba(242,240,236,'+(0.10+p.d*0.22)+')';ctx.shadowBlur=0;}
      ctx.fill();ctx.shadowBlur=0;}
    raf=requestAnimationFrame(frame);
  }
  size(); window.addEventListener('resize',size);
  if(reduce){frame(performance.now());cancelAnimationFrame(raf);} else raf=requestAnimationFrame(frame);
})();
</script>
