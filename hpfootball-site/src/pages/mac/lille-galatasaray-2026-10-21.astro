/* swarm */
(function(){
  const M = {
    shots:{t:"Atılan şut",d:0,note:"İki maçta toplam şut."},
    xg:{t:"Üretilen xG",d:2,note:"İki maç toplam beklenen gol."},
    lost_own:{t:"Kendi yarıda top kaybı",d:0,note:"Yüksek değer, oyun kurulumunda risk demek."},
    ppda:{t:"Pres yoğunluğu (PPDA)",d:2,rev:true,note:"Düşük PPDA daha yoğun pres demek; eksen ters, sağ taraf daha agresif."},
    reco:{t:"Rakip yarıda top kazanımı",d:0,note:"İki maçta rakip yarıda kazanılan top."},
    oxg:{t:"Verilen xG",d:2,note:"Rakibe izin verilen beklenen gol."}
  };
  const teams = Object.keys(AGG); const svg = document.getElementById('swarm');
  let W=960,H=300,L=40,R=40,cy=150,small=false,cur='shots';
  function size(){ W=Math.max(300,Math.round(svg.parentNode.clientWidth-28)); small=W<600; H=small?260:300; cy=small?128:150; L=small?14:40; R=L; svg.setAttribute('viewBox',`0 0 ${W} ${H}`); }
  size();
  const axis=el('g',{},svg), medG=el('g',{},svg); const dots={}, labs={};
  const big=t=>t===HOME||t===AWAY; const rad=t=>big(t)?(small?9:11):(small?5:7);
  teams.forEach(k=>{ dots[k]=el('circle',{class:'dot',r:rad(k),cx:W/2,cy,fill:k===HOME?'var(--fen)':k===AWAY?'var(--sla)':'var(--grey)',stroke:'var(--night)','stroke-width':2},svg); el('title',{},dots[k]).textContent=k; });
  [HOME,AWAY].forEach(k=>{ svg.appendChild(dots[k]); labs[k]=el('text',{class:'lab','text-anchor':'middle',fill:k===HOME?'var(--fen)':'var(--sla)'},svg); });
  const tabs=document.getElementById('tabs');
  Object.entries(M).forEach(([k,m],i)=>{ const b=document.createElement('button'); b.type='button'; b.textContent=m.t; b.dataset.m=k; b.setAttribute('aria-pressed',i===0?'true':'false'); tabs.appendChild(b); });
  tabs.addEventListener('click',e=>{ const b=e.target.closest('button'); if(!b) return; tabs.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',x===b?'true':'false')); draw(b.dataset.m); });
  function draw(key){
    cur=key; const m=M[key]; const vals=teams.map(t=>AGG[t][key]);
    let lo=Math.min(...vals), hi=Math.max(...vals); const pad=(hi-lo)*.06; lo-=pad; hi+=pad;
    const x=v=> m.rev ? L+(hi-v)/(hi-lo)*(W-L-R) : L+(v-lo)/(hi-lo)*(W-L-R);
    const placed=[];
    teams.slice().sort((a,b)=>AGG[a][key]-AGG[b][key]).forEach(t=>{
      const px=x(AGG[t][key]), r=rad(t); let y=cy, step=0;
      while(!placed.every(p=>Math.hypot(p.x-px,p.y-y)>=p.r+r+2)){ step++; y=cy+(step%2?1:-1)*Math.ceil(step/2)*(small?5:7); }
      placed.push({x:px,y,r,t}); dots[t].setAttribute('cx',px); dots[t].setAttribute('cy',y); dots[t].setAttribute('r',r);
    });
    axis.innerHTML=''; el('line',{x1:L,x2:W-R,y1:H-32,y2:H-32,stroke:'var(--line-2)'},axis);
    const ticks=small?3:5; for(let i=0;i<=ticks;i++){ const v=lo+pad+(hi-lo-2*pad)*i/ticks, tx=x(v); el('line',{x1:tx,x2:tx,y1:H-36,y2:H-28,stroke:'var(--line-2)'},axis); el('text',{x:tx,y:H-12,class:'ax','text-anchor':i===0?'start':i===ticks?'end':'middle'},axis).textContent=fmt(v,m.d); }
    el('text',{x:L,y:22,class:'ax'},axis).textContent = m.rev?'← daha az pres':'← düşük';
    el('text',{x:W-R,y:22,class:'ax','text-anchor':'end'},axis).textContent = m.rev?'daha yoğun pres →':'yüksek →';
    const s=vals.slice().sort((a,b)=>a-b), med=(s[17]+s[18])/2;
    medG.innerHTML=''; el('line',{x1:x(med),x2:x(med),y1:40,y2:H-38,stroke:'var(--chalk)','stroke-dasharray':'3 5',opacity:.45},medG);
    el('text',{x:x(med)+6,y:52,class:'ax'},medG).textContent='medyan '+fmt(med,m.d);
    [HOME,AWAY].forEach(t=>{ const p=placed.find(q=>q.t===t); labs[t].setAttribute('x',p.x); labs[t].setAttribute('y',p.y<cy?p.y-18:p.y+30); labs[t].textContent=(t===HOME?'GS ':'LIL ')+fmt(AGG[t][key],m.d); });
    const rank=t=>{ const v=AGG[t][key]; return 1+teams.filter(q=> m.rev ? AGG[q][key]<v : AGG[q][key]>v).length; };
    const word = m.rev ? 'en yoğun' : 'en yüksek';
    document.getElementById('readout').innerHTML = `<b>${m.t}.</b> ${m.note} Galatasaray <b class="fen num">${fmt(AGG[HOME][key],m.d)}</b> ile ${word} ${rank(HOME)}. sırada; Lille <b class="sla num">${fmt(AGG[AWAY][key],m.d)}</b> ile ${rank(AWAY)}. sırada (36 takım, eşitlikte aynı sıra).`;
  }
  draw('shots');
  let rt; addEventListener('resize',()=>{ clearTimeout(rt); rt=setTimeout(()=>{ size(); draw(cur); },150); });
})();

