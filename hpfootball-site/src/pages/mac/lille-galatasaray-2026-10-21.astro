.mp .hpa-scenario-copy p{margin:16px 0;line-height:1.65}
@media(max-width:780px){.mp .hpa-scenario-grid{grid-template-columns:1fr}}

.mp .hp-phase-selector{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 10px}
.mp .hp-phase-selector button{font:inherit;font-size:.82rem;cursor:pointer;padding:10px 17px;border:1px solid var(--line-2);border-radius:999px;color:var(--chalk);background:var(--raise);min-height:44px}
.mp .hp-phase-selector button[aria-pressed="true"]{border-color:var(--fen);color:var(--fen);background:color-mix(in srgb,var(--fen) 12%,var(--raise))}
.mp .hp-phase-selector button:focus-visible{outline:3px solid var(--fen);outline-offset:3px}
.mp .hp-phase-metrics{font-family:var(--f-mono);font-size:.76rem;line-height:1.8;color:var(--chalk-2);margin:0 0 14px;font-variant-numeric:tabular-nums}
@media (prefers-reduced-motion:reduce){.mp #pitch>g{transition:none!important}}

.mp{
  --night:var(--bg); --band:var(--bg-2); --raise:var(--panel); --line:var(--line); --line-2:var(--line-2);
  --chalk:var(--ink); --chalk-2:var(--ink-2); --mute:var(--muted);
  --fen:var(--amber); --fen-ink:var(--amber-ink); --sla:#EEF1F5; --sla-ink:#0B0D10; --sage:var(--amber);
  --f-display:var(--display); --f-body:var(--reading); --f-mono:var(--mono);
  --grey:#6E3D47; --gs-red:#A90432;
  background:var(--night); color:var(--chalk); font:400 1.0625rem/1.6 var(--f-body);
}


.mp /* Layout: FT-style reading column (64ch) broken by full-bleed "floodlit" chart bands; scoreboard type for numbers,.mp editorial serif for argument. */

a{color:var(--chalk);text-decoration-color:var(--sage);text-underline-offset:3px}
.mp :focus-visible{outline:2px solid var(--focus);outline-offset:3px;border-radius:2px}
.mp .wrap{max-width:1180px;margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.mp .col{max-width:64ch}
.mp .eyebrow,.mp .mono{font-family:var(--f-mono);font-size:.72rem;letter-spacing:.12em;color:var(--mute)}
.mp h1,.mp h2,.mp h3{font-family:var(--f-display);font-weight:700;letter-spacing:.01em;line-height:.95;text-wrap:balance;margin:0}
.mp h2{font-size:clamp(2rem,5.2vw,3.4rem)}
.mp h3{font-size:1.35rem;letter-spacing:.03em}
.mp p{margin:0}
.mp .num{font-variant-numeric:tabular-nums}
.mp .fen{color:var(--fen)} .mp .sla{color:var(--sla)}

.mp /* hero */
.hero{padding-block:clamp(36px,7vw,84px) 28px;position:relative;overflow:hidden;border-bottom:0}
.mp .hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:6px;background:linear-gradient(90deg,var(--fen) 0 50%,var(--gs-red) 50% 100%)}
.mp .hero::before{content:"";position:absolute;inset:-30% -10% auto;height:120%;background:radial-gradient(ellipse 55% 60% at 15% 25%,color-mix(in srgb,var(--fen) 22%,transparent),transparent 70%),radial-gradient(ellipse 60% 50% at 92% 0%,color-mix(in srgb,var(--gs-red) 55%,transparent),transparent 70%);pointer-events:none;animation:flood 9s ease-in-out infinite alternate}
@keyframes flood{to{transform:translateY(4%) scale(1.04)}}
.mp .hero .wrap{position:relative;display:grid;gap:22px;grid-template-columns:minmax(0,1fr)}
.mp .hero .wrap>*{min-width:0}
.mp .versus span{overflow-wrap:break-word}
.mp .versus{display:grid;grid-template-columns:1fr;gap:2px;font-family:var(--f-display);font-weight:900;font-size:clamp(2.9rem,11.5vw,8.6rem);line-height:.86;letter-spacing:-.005em}
.mp .versus .v{font-size:.32em;color:var(--mute);font-weight:500;letter-spacing:.2em;padding-block:.15em}
.mp .thesis{font-size:clamp(1.2rem,2.6vw,1.6rem);line-height:1.35;max-width:36ch;color:var(--chalk)}
.mp .thesis em{font-style:italic;color:var(--chalk-2)}
.mp .meta{display:flex;flex-wrap:wrap;gap:8px 18px}
.mp .meta div{display:grid;gap:2px}
.mp .meta b{font-family:var(--f-display);font-weight:700;font-size:1.25rem;letter-spacing:.02em}
.mp .count{display:flex;gap:10px;align-items:baseline;flex-wrap:wrap}
.mp .count .n{font-family:var(--f-display);font-weight:900;font-size:2.4rem;line-height:1}
.mp .count .u{font-family:var(--f-mono);font-size:.7rem;color:var(--mute);margin-right:8px}

.mp /* ticker */
.ticker{border-block:1px solid var(--line);overflow:hidden;background:var(--band)}
.mp .ticker-track{display:flex;width:max-content;animation:tick 48s linear infinite}
.mp .ticker:hover .ticker-track{animation-play-state:paused}
.mp .ticker-item{display:flex;align-items:baseline;gap:10px;padding:12px 28px;border-right:1px solid var(--line);white-space:nowrap}
.mp .ticker-item b{font-family:var(--f-display);font-size:1.5rem;font-weight:700}
.mp .ticker-item span{font-family:var(--f-mono);font-size:.72rem;color:var(--chalk-2);letter-spacing:.04em}
@keyframes tick{to{transform:translateX(-50%)}}

.mp /* sections */
section.block{padding-block:clamp(44px,7vw,88px);border-bottom:1px solid var(--line)}
.mp section.band{background:var(--band)}
.mp .head{display:grid;gap:12px;margin-bottom:28px;grid-template-columns:minmax(0,1fr)}
.mp h1,.mp h2,.mp h3,.mp .lede,.mp .eyebrow,.mp .readout,.mp .claim span{overflow-wrap:break-word;hyphens:auto}
.mp .lede{color:var(--chalk-2);font-size:1.075rem}
.mp .claim{display:flex;gap:10px;align-items:flex-start;margin-top:18px;padding:12px 14px;border:1px solid var(--line);border-radius:4px;background:var(--raise);font-size:.95rem;color:var(--chalk-2)}
.mp .claim>span:last-child{min-width:0}
.mp .meta-table td{overflow-wrap:anywhere}
.mp .legend span,.mp .figcap span,.mp .qs li *{min-width:0;overflow-wrap:break-word}
.mp .ev{flex:none;font-family:var(--f-mono);font-size:.62rem;letter-spacing:.1em;padding:3px 6px;border-radius:3px;border:1px solid currentColor;margin-top:3px}
.mp .ev.obs{color:#9FE3BC}.mp .ev.mod{color:#9EC3FF}.mp .ev.der{color:#FFD31A}.mp .ev.hyp{color:#F2B8DC}

.mp /* match rail */
.rail{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(260px,1fr);gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:10px;scrollbar-color:var(--line-2) transparent}
.mp .mcard{scroll-snap-align:start;border:1px solid var(--line);border-radius:4px;background:var(--raise);padding:16px;display:grid;gap:14px;transition:transform .25s ease,border-color .25s ease}
.mp .mcard:hover{transform:translateY(-3px);border-color:var(--line-2)}
.mp .mcard .top{display:flex;justify-content:space-between;gap:8px}
.mp .score{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px;font-family:var(--f-display)}
.mp .score .t{font-weight:700;font-size:1.05rem;line-height:1;min-width:0;overflow-wrap:anywhere}
.mp .score .t:last-child{text-align:right}
.mp .score .g{font-weight:900;font-size:2.3rem;white-space:nowrap;line-height:1;font-variant-numeric:tabular-nums}
.mp .xgbar{display:grid;gap:6px}
.mp .xgbar .row{display:grid;grid-template-columns:40px 1fr 40px;align-items:center;gap:8px;font-family:var(--f-mono);font-size:.72rem}
.mp .xgbar .row span:last-child{text-align:right}
.mp .track{height:8px;border-radius:2px;background:var(--line);display:flex;overflow:hidden}
.mp .track i{display:block;height:100%}
.mp .mstats{display:flex;justify-content:space-between;gap:8px;font-family:var(--f-mono);font-size:.68rem;color:var(--mute);border-top:1px solid var(--line);padding-top:10px}
.mp .mstats b{display:block;color:var(--chalk);font-size:.85rem;font-weight:500}

.mp /* tabs */
.tabs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
.mp .tabs button{font:500 .74rem var(--f-mono);letter-spacing:.06em;color:var(--chalk-2);background:transparent;border:1px solid var(--line-2);border-radius:999px;padding:9px 13px;min-height:40px;cursor:pointer;transition:background .2s,color .2s}
.mp .tabs button[aria-pressed="true"]{background:var(--chalk);color:var(--night);border-color:var(--chalk)}
.mp .figure{border:1px solid var(--line);border-radius:4px;background:var(--night);padding:14px;overflow-x:auto}
.mp .figure svg{display:block;width:100%;height:auto}
.mp .figcap{display:flex;flex-wrap:wrap;gap:6px 18px;justify-content:space-between;margin-top:10px;font-family:var(--f-mono);font-size:.68rem;color:var(--mute)}
.mp .readout{font-size:1.05rem;margin-top:14px;min-height:3.2em;color:var(--chalk-2)}
.mp .readout b{color:var(--chalk)}
.mp .ax{font-family:var(--f-mono);font-size:11px;fill:var(--mute)}
.mp .lab{font-family:var(--f-display);font-weight:700;font-size:16px;letter-spacing:.03em}
.mp .dot{transition:cx .7s cubic-bezier(.2,.8,.2,1),cy .7s cubic-bezier(.2,.8,.2,1)}

.mp /* two-col */
.duo{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:16px}
.mp .duo > *{min-width:0}
.mp .legend{display:flex;flex-wrap:wrap;gap:8px 16px;font-family:var(--f-mono);font-size:.7rem;color:var(--chalk-2);margin-top:10px}
.mp .legend span{display:inline-flex;align-items:center;gap:6px}
.mp .sw{width:12px;height:12px;display:inline-block}

.mp /* dumbbell */
.gap-grid{display:grid;gap:18px}
.mp .gap-row{display:grid;grid-template-columns:minmax(0,170px) minmax(0,1fr);gap:12px;align-items:center}
.mp .gap-row .who{font-family:var(--f-display);font-weight:700;font-size:1.05rem;line-height:1.05}
.mp .gap-row .who small{display:block;font-family:var(--f-mono);font-weight:400;font-size:.66rem;color:var(--mute);letter-spacing:.06em;margin-top:3px}

.mp .db{position:relative;height:22px;margin-inline:7px}
.mp .db::before{content:"";position:absolute;left:0;right:0;top:10px;height:1px;background:var(--line-2)}
.mp .db-bar{position:absolute;top:8px;height:5px;opacity:.5}
.mp .db-x,.mp .db-g{position:absolute;top:3px;width:15px;height:15px;margin-left:-7.5px;border-radius:50%}
.mp .db-x{border:2px solid var(--chalk);background:var(--night)}
.mp .db-g{background:var(--chalk)}
.mp .db-t{display:block;margin-top:4px;letter-spacing:.03em;}
.mp .db-axis{display:flex;justify-content:space-between;margin-inline:7px;letter-spacing:0;}
.mp /* corridors */
.corr{display:grid;gap:14px}
.mp .corr .row{display:grid;gap:6px}
.mp .stack{display:flex;height:34px;border-radius:3px;overflow:hidden;gap:2px}
.mp .stack div{display:flex;align-items:center;justify-content:center;font-family:var(--f-mono);font-size:.66rem;white-space:nowrap;overflow:hidden;min-width:0;transition:flex-basis .8s ease}

.mp /* questions */
.qs{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:12px;margin:0;padding:0;list-style:none}
.mp .qs li{border-top:2px solid var(--line-2);padding-top:12px;display:grid;gap:8px}
.mp .qs li .tag{font-family:var(--f-mono);font-size:.66rem;letter-spacing:.1em;color:var(--sage)}
.mp .qs li p{font-size:1.02rem}
.mp .qs li small{font-family:var(--f-mono);font-size:.68rem;color:var(--mute)}

.mp /* sources */
.src{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:20px 32px;font-size:.92rem;color:var(--chalk-2)}
.mp .src h3{font-size:1rem;margin-bottom:8px}
.mp .src ul{margin:0;padding-left:18px;display:grid;gap:6px}
.mp .meta-table{width:100%;border-collapse:collapse;font-family:var(--f-mono);font-size:.72rem}
.mp .meta-table td{border-top:1px solid var(--line);padding:7px 8px 7px 0;vertical-align:top;color:var(--chalk-2)}
.mp .meta-table td:first-child{color:var(--mute);width:34%;letter-spacing:.08em}
@media (prefers-reduced-motion:reduce){
  .mp .hero::before,.mp .ticker-track{animation:none}
  .mp .ticker{overflow-x:auto}
  .mp .dot,.mp .stack div,.mp .mcard{transition:none}
}

.mp .pbar{position:relative;height:30px;background:var(--line);border-radius:3px;overflow:hidden}
.mp .pbar i{display:block;height:100%;transition:width .8s ease}
.mp .pbar em{position:absolute;top:-2px;bottom:-2px;width:2px;background:var(--chalk);opacity:.7}
.mp #press .row{display:grid;gap:6px;margin-bottom:14px}


.mp h2{font-weight:500;letter-spacing:-.005em;line-height:1.02}
.mp .versus{font-family:var(--display);letter-spacing:-.01em;font-weight:500}
.mp .versus .v{font-family:var(--ui)}
.mp .score,.mp .score .t{font-family:var(--ui)}
.mp .score .g,.mp .count .n,.mp .ticker-item b,.mp .meta b{font-family:var(--mono);font-weight:500}
.mp .lab{font-family:var(--mono);font-weight:500;font-size:14px}
.mp .gap-row .who{font-family:var(--ui);font-weight:600}

.mp .score .t{font-size:clamp(.8rem,3.3vw,1.05rem);overflow-wrap:normal;word-break:normal;hyphens:none}
.mp{--mute:#C9BBB4;--chalk-2:#E4DAD4;--line:#3A2222;--line-2:#5A3535;--fig:#2A1616;--btn:rgba(255,255,255,.07);--btn-h:rgba(255,255,255,.14);--acc:#F2B705;--on-acc:#2A0705}
/* readability + chart pass 2026-10-20 */
.mp h2{font-weight:600;color:var(--chalk)}
.mp .claim{display:block;margin-top:14px;padding:2px 0 2px 12px;border:0;border-left:2px solid var(--line-2);border-radius:0;background:none;font-size:.86rem;line-height:1.55;color:var(--mute);max-width:74ch}
.mp .claim>span:last-child{display:inline}
.mp .claim .ev{display:inline-block;margin:0 8px 0 0;padding:1px 6px;font-size:.62rem;letter-spacing:.08em;vertical-align:1px}
.mp .tabs button,.mp .hpc-tabs button,.mp .hpc-chips button{font:600 .86rem/1.2 var(--ui);letter-spacing:0;color:var(--chalk);background:var(--btn);border:1.5px solid var(--line-2);border-radius:6px;padding:10px 14px;min-height:44px;cursor:pointer;transition:background .15s,border-color .15s}
.mp .tabs button:hover,.mp .hpc-tabs button:hover,.mp .hpc-chips button:hover{border-color:var(--chalk-2);background:var(--btn-h)}
.mp .tabs button[aria-pressed="true"],.mp .hpc-tabs button[aria-pressed="true"],.mp .hpc-chips button[aria-pressed="true"]{background:var(--acc);color:var(--on-acc);border-color:var(--acc)}
.mp .tabs button[aria-pressed="true"]::before,.mp .hpc-tabs button[aria-pressed="true"]::before,.mp .hpc-chips button[aria-pressed="true"]::before{content:"✓ "}
.mp .hpc-pb button[aria-pressed="true"]{background:var(--sla);color:#0B0D10;border-color:var(--sla)}
.mp .hpc-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 12px}
.mp .hpc-chips{display:flex;flex-wrap:wrap;gap:6px}
.mp .hpc-chips button small{font-weight:400;opacity:.8}
.mp .figure{background:var(--fig);border:1px solid rgba(255,255,255,.2);border-radius:8px}
.mp .hpc-duo{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:28px;align-items:start}
.mp .hpc-pl{grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr)}
@media (max-width:820px){.mp .hpc-duo,.mp .hpc-pl{grid-template-columns:minmax(0,1fr)}}
.mp .hpc-step{font:600 .82rem var(--ui);color:var(--chalk);margin:16px 0 8px;display:flex;align-items:center;gap:8px}
.mp .hpc-key{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;font:500 .86rem var(--ui);color:var(--chalk);margin-top:10px}
.mp .k-a,.mp .k-b{display:inline-block;width:24px;height:0;border-top:3px solid var(--acc)}
.mp .k-b{border-top:3px dashed var(--sla)}
.mp .hpc-n{font:400 .8rem/1.5 var(--ui);color:var(--mute)}
.mp .hpc-table{width:100%;border-collapse:collapse;font:500 .92rem var(--ui);margin-bottom:10px}
.mp .hpc-table th,.mp .hpc-table td{padding:9px 6px;border-bottom:1px solid var(--line);text-align:right;color:var(--chalk);font-variant-numeric:tabular-nums}
.mp .hpc-table th[scope=row]{text-align:left;font-weight:500;color:var(--chalk-2)}
.mp .hpc-table small{color:var(--mute);font-weight:400}
.mp .hpc-none{font:400 .85rem var(--ui);color:var(--mute)}
.mp .hpc-readout{font-family:var(--ui);font-size:1rem;line-height:1.55}
.mp .hpc-readout .hpc-n{display:block;margin-top:6px}
.mp .hpc-det{border-top:1px solid var(--line);min-width:0}
.mp .hpc-det summary{cursor:pointer;font:600 .95rem var(--ui);color:var(--chalk);padding:12px 0;min-height:44px;display:flex;align-items:center;gap:8px;list-style:none}
.mp .hpc-det summary::-webkit-details-marker{display:none}
.mp .hpc-det summary::before{content:"+";display:inline-grid;place-items:center;width:22px;height:22px;border:1.5px solid var(--line-2);border-radius:4px;color:var(--acc)}
.mp .hpc-det[open] summary::before{content:"–"}
.mp .hpc-det ul,.mp .hpc-det table{font-size:.88rem;color:var(--chalk-2);margin-bottom:14px}
.mp .src{display:grid;grid-template-columns:minmax(0,1fr);gap:0}
.mp .hpc-fig svg{font-family:var(--ui)}
.mp .hpc-table td{white-space:nowrap}


/* Lille–Galatasaray: evidence-linked tactical mechanism panel */
.mp .hp-mechanism{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:22px 0}
.mp .hp-mechanism__item{min-width:0;padding:20px;border:1px solid var(--line);border-radius:8px;background:var(--fig)}
.mp .hp-mechanism__meta{display:flex;flex-direction:column;gap:5px;font:500 .85rem/1.45 var(--ui);color:var(--chalk)}
.mp .hp-mechanism__meta span{color:var(--mute)}
.mp .hp-mechanism__item p{margin:16px 0 12px;font:400 .94rem/1.5 var(--ui);color:var(--chalk)}
.mp .hp-mechanism__item p strong{font:700 1.6rem/1 var(--ui)}
.mp .hp-mechanism__track{height:11px;border:1px solid var(--line-2);background:rgba(255,255,255,.12);overflow:hidden;border-radius:6px}
.mp .hp-mechanism__track span{display:block;height:100%}
.mp .hp-mechanism__item small{display:block;margin-top:10px;font:400 .78rem/1.5 var(--ui);color:var(--chalk-2)}
.mp .hp-mechanism__reading{margin:10px 0 22px;max-width:900px}
.mp .hp-mechanism__reading h3{font:600 1.1rem/1.4 var(--ui);margin:0 0 12px}
.mp .hp-mechanism__reading details{border-top:1px solid var(--line);padding:12px 0}
.mp .hp-mechanism__reading details:last-child{border-bottom:1px solid var(--line)}
.mp .hp-mechanism__reading summary{cursor:pointer;min-height:44px;font:600 .95rem/1.5 var(--ui);color:var(--chalk)}
.mp .hp-mechanism__reading details p{margin:8px 0 12px;color:var(--chalk-2);font:400 .91rem/1.65 var(--ui)}
@media(max-width:820px){.mp .hp-mechanism{grid-template-columns:1fr}}
</style>
</BaseLayout>
