.mp .hpa-corridor-controls{display:flex;flex-wrap:wrap;gap:7px;margin:6px 0 24px}
.mp .hpa-corridor-controls button{font:inherit;font-size:.76rem;min-height:44px;padding:8px 12px;border:1px solid var(--line-2);border-radius:9px;color:var(--chalk);background:var(--raise);cursor:pointer}
.mp .hpa-corridor-controls button[aria-pressed="true"]{color:var(--fen);border-color:var(--fen)}
.mp .hpa-corridor-controls button:focus-visible{outline:3px solid var(--fen);outline-offset:2px}

.mp .hpa-carousel-bar{display:flex;align-items:center;justify-content:flex-end;gap:16px;margin:12px 0 20px}
.mp .hpa-carousel-bar button{min-height:44px;min-width:48px;border-radius:10px;border:1px solid var(--line-2);background:var(--raise);color:var(--chalk);font-size:1.4rem;cursor:pointer}
.mp .hpa-carousel-bar button:hover,.mp .hpa-carousel-bar button:focus-visible{border-color:var(--fen);outline-offset:2px}
.mp #hpa-scenario-counter{font-family:var(--f-mono);font-variant-numeric:tabular-nums;color:var(--chalk-2)}
.mp .hpa-spot-tooltip{font-size:.8rem;line-height:1.5;padding:12px 14px;border:1px solid #50606A;border-radius:8px;background:#172835;color:#E8E9E8}
.mp #hpa-scenario-svg g[role="button"]{cursor:pointer;outline:none}
.mp #hpa-scenario-svg g[role="button"]:focus circle,.mp #hpa-scenario-svg g[role="button"]:hover circle{stroke:#FFF;stroke-width:1.2}
@media(prefers-reduced-motion:reduce){.mp #hpa-scenario-svg *{animation:none!important;transition:none!important}}

.mp .hpa-scenario-lab{background:radial-gradient(ellipse at 14% 18%,rgba(242,163,58,.1),transparent 58%),var(--band)}
.mp .hpa-scenario-controls{display:flex;flex-wrap:wrap;gap:9px;margin:24px 0}
.mp .hpa-scenario-controls button{font:inherit;cursor:pointer;min-height:44px;padding:12px 18px;border-radius:999px;border:1px solid var(--line-2);background:var(--raise);color:var(--chalk)}
.mp .hpa-scenario-controls button[aria-pressed="true"]{border-color:var(--fen);color:var(--fen);background:color-mix(in srgb,var(--fen) 13%,var(--raise))}
.mp .hpa-scenario-controls button:focus-visible{outline:3px solid var(--fen);outline-offset:3px}
.mp .hpa-scenario-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(240px,.85fr);gap:clamp(18px,4vw,46px);align-items:center}
.mp .hpa-scenario-field{padding:clamp(14px,2vw,28px);border:1px solid var(--line-2);border-radius:16px;background:#0C1721}
