---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EndnoteLinks from '../../components/editorial/EndnoteLinks.astro';
import OriginalChart from '../../components/preserved-derby/OriginalChart.astro';
import FlowSurface from '../../components/editorial/FlowSurface.astro';
import OriginalRuntime from '../../components/preserved-derby/OriginalRuntime.astro';
import GoalChronology from '../../components/GoalChronology.astro';
import {serializeJsonLd} from '../../lib/json-ld.mjs';
import editorial from '../../data/derby-editorial-continuity.json';
import evidence from '../../../public/mac/galatasaray-fenerbahce-2026-10-26-mac-sonu/evidence.json';
import {actorName,actionLabel} from '../../lib/derby-labels.mjs';
import visualData from '../../data/preserved-derby-data.json';
import '../../styles/experience-tokens.css';
import '../../styles/editorial-continuity.css';
import '../../styles/match-editorial-v4.css';
import '../../styles/editorial-p0.css';
export const prerender = true;
const {title,standfirst}=editorial;
const wordCount=editorial.sections.flatMap(section=>section.paragraphs).join(' ').split(/\s+/).length;
const notes:Record<string,{scope?:string;method:string;limit:string}>={
 pulse:{method:'Mevcut üç dakikalık aksiyon dilimleri ve olay işaretleri korunur.',limit:'Aksiyon yoğunluğu, topa sahiplik veya baskı başarısı değildir.'},
 kde:{method:'8 m bant genişliği; 70 × 46 hesap ızgarası; iki panelde ortak yoğunluk ölçeği.',limit:'Yoğunluk gözlenen kazanım noktalarının yumuşatılmasıdır; tracking veya saha kontrolü ölçümü değildir.'},
 field:{method:'Kaynak sürümün takım, zaman ve katman filtreleri korunur.',limit:'Her katman farklı bir kayıt ailesini gösterir; sayılar birbirine eklenmez.'},
 atlas:{method:'Mevcut saha ızgarası, renk skalası ve kayıt kapsamı korunur.',limit:'Bir alandaki olay sıklığı, oyuncuların o alanda geçirdiği süre değildir.'},
 phases:{method:'Kaynak sürümün evre sınırları; ilgili ölçüler on dakikaya oranlanır.',limit:'Yarı karşılaştırması oyuncu kayıt ailesindedir; kaleci içeren maç toplamıyla birleştirilmez.'},
 xg:{method:'Oyuncu toplamları, kaynak sürümdeki xG değerleri ve şut sayıları korunur.',limit:'Şut başına model değeri değildir; takım toplamı noktalara dağıtılmaz.'}
};
const path='/mac/galatasaray-fenerbahce-2026-10-26-mac-sonu/';
const schema={'@context':'https://schema.org','@type':'Article',headline:title,description:standfirst,datePublished:'2026-10-27',dateModified:'2026-10-28',image:new URL('/editorial/20261028/derby-og.png',Astro.site).href,publisher:{'@type':'Organization',name:'HPAnalytic'},inLanguage:'tr',author:{'@type':'Person',name:'Hikmet Pınarbaş'},mainEntityOfPage:new URL(path,Astro.site).href};
---
<BaseLayout systemFonts title={title+' — HPAnalytic'} description={standfirst} section="analysis" ogType="article" image="/editorial/20261028/derby-og.png" imageAlt="Galatasaray 2–1 Fenerbahçe: 20–4 şut ve 2,71–0,67 sağlayıcı xG">
<script slot="head" type="application/ld+json" set:html={serializeJsonLd(schema)}/>
<article class="editorial-continuity" data-experience="continuity">
<header class="continuity-cover"><div class="continuity-cover__line"><span>MAÇ SONU / GALATASARAY × FENERBAHÇE</span><span>26 EKİM 2026 · RAMS PARK</span></div><div class="continuity-cover__grid"><div><p class="kicker">HPANALYTIC / DERBİ DOSYASI</p><h1>{title}</h1><p class="continuity-standfirst">{standfirst}</p><p class="continuity-byline">Hikmet Pınarbaş <span>{Math.ceil(wordCount/200)} dk okuma</span></p></div><aside class="continuity-score" aria-label="Maç sonucu Galatasaray 2 Fenerbahçe 1"><p>MAÇ SONU</p><b>2 <span>—</span> 1</b><div><span>Galatasaray</span><span>Fenerbahçe</span></div><p class="continuity-status">Kaynaklı maç analizi</p></aside></div><div class="continuity-keyfacts"><div><b>20–4</b><span>Şut</span></div><div><b>2,71–0,67</b><span>Sağlayıcı xG</span></div><div><b>51–10</b><span>Ceza sahası aksiyonu</span></div></div></header>

<div class="continuity-share"><a href="#source-notes">Kaynak ve yöntem ↓</a><button type="button" data-article-share>Bağlantıyı paylaş ↗</button><span role="status" data-share-status></span></div><nav class="continuity-contents" aria-label="Yazı içindekiler">{editorial.sections.map(section=><a href={'#'+section.id}><span>{section.number}</span>{section.title}</a>)}</nav>
{editorial.sections.map(section=><section class="continuity-chapter" id={section.id} aria-labelledby={'heading-'+section.id}><header><span class="continuity-chapter__number">{section.number}</span><h2 id={'heading-'+section.id}>{section.title}</h2></header><div class="continuity-reading">{section.paragraphs.map((paragraph,i)=><p class:list={{'continuity-opening':section.number==='01'&&i===0}}>{paragraph}</p>)}</div>{'chart' in section&&section.chart&&<OriginalChart chart={section.chart} {...notes[section.chart]}/>}
{section.id==='evidence-story'&&<FlowSurface/>}
{section.id==='goals'&&<div class="match-editorial"><GoalChronology/></div>}

</section>)}

<section class="continuity-method editorial-endnotes" id="source-notes"><h2>Kaynaklar ve yöntem</h2><details id="method-flow"><summary>xGrid ve akış yüzeyinin yöntemi</summary><p>Karun Singh’in yayımlanmış 12×8 xT model parametreleri genel bir saha değer yüzeyi olarak gösterilir. Bu maçın eğitilmiş modeli veya takım xT toplamı değildir. Hareket yönleri mevcut veri paketindeki Galatasaray için 398, Fenerbahçe için 229 ardışık aynı takım olayı arasındaki yer değiştirmelerden, 6,5 m mekânsal çekirdekle türetilir. Pas bitişleri ve alıcılar doğrulanmadığından bunlar ölçülmüş pas yolları değildir. Parçacıklar yön alanını görünür kılar; oyuncu veya top tracking kaydı, gerçek hareket hızı değildir.</p><a href="https://karun.in/blog/expected-threat.html">xT modelinin açıklaması</a> · <a href="https://karun.in/blog/data/open_xt_12x8_v1.json">Yayımlanmış model parametreleri</a></details><details><summary>Veri kapsamını ve grafik yöntemlerini incele</summary><p>Kaynak: SportsBase, 26 Ekim 2026 maç dosyası. Takım toplamında 24 şut (20–4), konum dizisinde 22 kayıt bulunur; konumu eksik şutlar sahaya eklenmez. Kazanım dizisi 42 Galatasaray, 24 Fenerbahçe kaydı içerir.</p>{Object.entries(notes).map(([key,note])=><section id={'method-'+key}><h3>{key==='pulse'?'Maçın nabzı':key==='kde'?'Top kazanımı yoğunluğu':key==='field'?'Bölgesel kayıtlar':key==='atlas'?'Topla aksiyon haritası':key==='phases'?'Maç evreleri':'Beklenen gol'}</h3><p>{note.method} {note.limit}</p></section>)}<p>Oyuncu ve takım kayıt aileleri ayrı değerlendirilir. Yarı örneklemleri maç toplamıyla birleştirilmez. Ceza sahasına giriş ile ceza sahası aksiyonu farklı ölçülerdir; tek bir giriş birden çok aksiyon içerebilir. PPDA, ilgili ölçüm alanındaki rakip pasları ve savunma aksiyonları arasındaki orandır; tek başına baskı başarısını veya oyuncu eşleşmelerini vermez. Grafikteki zamandaşlık nedensellik kanıtı değildir. Yoğunluk, saha kontrolü veya oyuncu konumu değildir. xG, sağlayıcının toplamıdır; şut başına model değeri bulunmadığından tekil noktalara dağıtılmaz.</p></details><details><summary>Üç golün olay kayıtları ve konumların kaynağı</summary><p>Numaralı noktalar kaynak görsel paketinin goal_seqs dizisindeki olay konumlarıdır. Olay türleri ve gole göre zaman farkları evidence.json kayıtlarıyla karşılaştırılır. Animasyon, kayıtlı olay konumları arasında doğrusal ve şematik geçiş gösterir. Ara yol ve pas alıcıları ölçülmüş değildir; oyuncu koşusu üretilmez. İkinci yarının saat referansları farklıdır: görsel paket ikinci yarıyı 45. dakikadan, kanıt dosyası ise ilk yarının 47,75 dakikasını içeren birikimli süreden okur. Aradaki 2,75 dakika ilk yarının uzatmasıdır. Gole göre saniye farkları değişmez.</p>{evidence.goals.map((g,i)=><section><h3>{i+1}. gol · tam olay dökümü</h3><ol>{g.action_chronology.map(r=><li><b>{r.offset_to_goal_s===0?'Gol':r.offset_to_goal_s+' sn'} · {actorName(r.actor)}</b> — {r.action_labels.map(actionLabel).join(' · ')}<small class="p0-source-id">{r.event_key} · kaynak: {r.source_ids.join(', ')}</small></li>)}</ol></section>)}<a href="/mac/galatasaray-fenerbahce-2026-10-26-mac-sonu/evidence.json">Olay kanıt dosyası (JSON)</a></details><p>Yazar: Hikmet Pınarbaş · Kaynak kontrolü: 28 Ekim 2026.</p></section>

</article>
<OriginalRuntime/>
<EndnoteLinks/>
</BaseLayout>

<script>
const button=document.querySelector<HTMLButtonElement>('[data-article-share]');
button?.addEventListener('click',async()=>{const url='https://www.hpanalytic.com/mac/galatasaray-fenerbahce-2026-10-26-mac-sonu/';const status=document.querySelector('[data-share-status]');try{if(navigator.share)await navigator.share({title:document.title,url});else await navigator.clipboard.writeText(url);if(status)status.textContent='Paylaşım bağlantısı hazır.';}catch(e){if(status)status.textContent=e instanceof DOMException&&e.name==='AbortError'?'':url;}});
</script>
<style>.continuity-share{display:flex;gap:8px;flex-wrap:wrap;align-items:center;max-width:1440px;margin:auto;padding:12px var(--layout-gutter)}.continuity-share a,.continuity-share button{min-height:44px;display:inline-flex;align-items:center;padding:6px 10px;color:#F3EBDD;background:#1A1D22;border:1px solid #5C6675;font:inherit}.continuity-share :focus-visible{outline:3px solid #69b5e5;outline-offset:4px}@media(max-width:600px){.continuity-share{gap:6px;padding-block:10px}.continuity-share a,.continuity-share button{font-size:13px;line-height:1.25;padding:5px 8px;white-space:normal}} </style>
