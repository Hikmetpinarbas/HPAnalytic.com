---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionListing from '../components/SectionListing.astro';
export const prerender = true;
---
<BaseLayout title="Football Culture — HPAnalytic" description="Oyunun tarihi, kültürü, insanları ve uluslararası bağlamı.">
<div class="listing">
  <header class="page-head">
    <p class="kicker">FOOTBALL CULTURE</p>
    <h1 class="page-title">Futbol yalnızca maç değildir.</h1>
    <p class="lead">Oyunun tarihi, kültürü, insanları ve uluslararası bağlamı.</p>
  </header>
  <SectionListing section="culture" />
</div>
</BaseLayout>
