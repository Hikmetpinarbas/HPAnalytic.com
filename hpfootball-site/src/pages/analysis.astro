---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionListing from '../components/SectionListing.astro';
export const prerender = true;
---
<BaseLayout title="Analysis — HPAnalytic" description="Maç, takım ve oyuncu analizi: metric değil, mekanizma.">
<div class="listing">
  <header class="page-head">
    <p class="kicker">ANALYSIS</p>
    <h1 class="page-title">Metric değil, mekanizma.</h1>
    <p class="lead">Sonuçtan geriye değil, süreçten sonuca doğru okunan postmatch analizleri.</p>
  </header>
  <SectionListing section="analysis" />
</div>
</BaseLayout>
