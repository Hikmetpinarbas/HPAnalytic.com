---
import { evidenceMeta } from '../lib/evidence.mjs';
import { displayEvidenceClass, displayClaimCeiling } from '../lib/editorial-display.mjs';
interface Props { evidenceClass?: string; claimCeiling?: string; }
const { evidenceClass = 'EDITORIAL', claimCeiling = 'EDITORIAL' } = Astro.props as Props;
const meta = evidenceMeta(evidenceClass);
---
<dl class="evidence" data-stroke={meta.stroke} title={meta.summary}>
  <dt>Kanıt sınıfı</dt><dd class="evidence-class">{displayEvidenceClass(evidenceClass)}</dd>
</dl>
