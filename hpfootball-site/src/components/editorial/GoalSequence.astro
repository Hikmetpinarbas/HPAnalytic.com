---
import model from '../../data/flow-model-v2.json';
import data from '../../data/preserved-derby-data.json';
import '../../styles/editorial-motion-v2.css';
const titles=['Son pasın açtığı kapı','İkinci bağlantı, aynı bitirici','Bir kazanımdan gole: 13 saniye'];
const descriptions=['Osimhen → Barış Alper → Osimhen. Üç kayıt, son bağlantının anatomisi.','Jakobs’un ceza sahası pası, Sánchez’in asisti ve Osimhen’in bitirişi.','Archie Brown’un kazanımından İrfan Can Kahveci’nin bitirişine.'];
const sequences=data.goal_seqs.map((g,i)=>({...g,seq:g.seq.slice(i===0?-3:i===1?-3:1)}));
const point=(event:{x:number;y:number},team:string)=>({x:team==='FB'?105-event.x:event.x,y:team==='FB'?event.y:68-event.y});
const label=(event:{lab:string},goal:number,step:number)=>goal===1&&step===0?'Ceza sahasına pas':event.lab;
---
<div class="goal-film" data-goal-film aria-label="Üç golü ardışık izleme"><p class="film-intro">Üç gol, tek akış. Oynat düğmesine basın; bir gol tamamlandığında sonraki pozisyon açılır. Çizilen ara yollar, ölçülmüş top yörüngeleri değildir.</p>
<div class="film-tabs" role="tablist" aria-label="Gol sekansı seç"><span>GOL DOSYASI</span>{sequences.map((g,i)=><button type="button" role="tab" id={'film-tab-'+i} aria-controls={'film-panel-'+i} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-film-tab={i}>{['1–0','2–0','2–1'][i]}<small>{i===2?'Fenerbahçe':'Galatasaray'}</small></button>)}</div>
{sequences.map((g,i)=><section class="goal-sequence film-panel" id={'film-panel-'+i} role="tabpanel" aria-labelledby={'film-tab-'+i} data-goal-sequence data-film-panel={i} data-duration={g.seq.at(-1)!.t-g.seq[0].t} hidden={i!==0}>
<header><p class="p0-eyebrow">{['1–0','2–0','2–1'][i]} / {Math.floor(g.goal.min)+1}′</p><h3>{titles[i]}</h3><p>{descriptions[i]}</p></header>
<div class="film-stage"><svg viewBox="-3 -3 111 74" class="film-pitch" role="group" aria-label="Kayıtlı gol olaylarının hareketli şeması; ara çizgiler ölçülmüş pas güzergâhı değildir">
<defs><filter id={'film-glow-'+i}><feGaussianBlur stdDeviation="1.2"/></filter><marker id={'film-arrow-'+i} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="4" markerHeight="4" orient="auto"><path d="M0 0L10 5L0 10Z" fill="currentColor"/></marker></defs>
<g aria-hidden="true" pointer-events="none">{model.map((row,j)=>row.map((v,i)=><rect x={i*105/12} y={j*68/8} width={105/12-.2} height={68/8-.2} fill="#b68a3d" opacity={.02+.2*Math.sqrt(v/.258)}/>))}</g>
<g class="film-field" fill="none" stroke-width=".25"><path d="M0 0H105V68H0ZM52.5 0V68M0 13.84H16.5V54.16H0M105 13.84H88.5V54.16H105M0 24.84H5.5V43.16H0M105 24.84H99.5V43.16H105"/><circle cx="52.5" cy="34" r="9.15"/><path d="M105 30H107V38H105"/></g>
<g class="film-route" fill="none">{g.seq.slice(1).map((event,j)=>{const a=point(g.seq[j],g.goal.team),b=point(event,g.goal.team);return <g><path d={`M${a.x} ${a.y}L${b.x} ${b.y}`} class="film-connection" stroke-dasharray="1.2 1.2"/><path d={`M${a.x} ${a.y}L${b.x} ${b.y}`} pathLength="1" data-film-link={j} class="film-trail" stroke-dasharray="0 1"/></g>})}</g>
{g.seq.map((event,j)=>{const p=point(event,g.goal.team);return <g class="film-node" data-film-node={j} data-time={event.t-g.seq[0].t} data-x={p.x} data-y={p.y} data-actor={event.player} data-action={label(event,i,j)} tabindex={j===0?0:-1} role="button" aria-label={`${j+1}. ${event.player}: ${label(event,i,j)}`} aria-pressed={j===0?'true':'false'} transform={`translate(${p.x},${p.y})`}><circle r="4.4" fill="transparent"/><circle class="film-node-ring" r="2"/><text text-anchor="middle" dominant-baseline="central">{j+1}</text></g>})}
<circle class="film-ball-glow" data-film-glow r="2.6" filter={`url(#film-glow-${i})`}/><circle class="film-ball" data-film-ball r="1.15"/>
</svg><span class="film-direction">Hücum yönü →</span></div>
<div class="film-transport"><button type="button" class="film-icon-button" data-film-play aria-label="Gol sekansını oynat" aria-pressed="false"><span aria-hidden="true" data-film-play-icon>▶</span></button><button type="button" class="film-icon-button film-step" data-film-prev aria-label="Önceki aksiyon">‹</button><input type="range" min="0" max={g.seq.at(-1)!.t-g.seq[0].t} step="0.01" value="0" data-film-scrub aria-label="Gol sekansında zaman seç"/><button type="button" class="film-icon-button film-step" data-film-next aria-label="Sonraki aksiyon">›</button><button type="button" class="film-icon-button film-speed" data-film-speed aria-label="Oynatma hızı: iki kat">2×</button></div>
<div class="film-readout"><div><strong data-film-actor>{g.seq[0].player}</strong><span data-film-action>{label(g.seq[0],i,0)}</span></div><output data-film-clock aria-live="off">{g.seq[0].t-g.seq.at(-1)!.t} sn</output></div>
<p class="film-caption">SportsBase · Kayıtlı olaylar arasında şematik geçiş. <a href="#source-notes">Kaynak ve çizim notu ↗</a></p>
<details class="film-records"><summary>Olay dökümü · {g.seq.length} kayıt</summary><ol>{g.seq.map((event,j)=><li><button type="button" data-film-jump={j}><time>{event.t-g.seq.at(-1)!.t} sn</time><span>{event.player} <small>{label(event,i,j)}</small></span></button></li>)}</ol></details>
</section>)}
</div>
<script>
import '../../lib/goal-film';
</script>
