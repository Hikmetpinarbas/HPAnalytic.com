---
import data from '../../data/preserved-derby-data.json';
const titles=['Son bağlantı: Barış Alper → bitiriş','Duran topun ardından ikinci bağlantı','Kazanımdan bitirişe: 13 saniye'];
const descriptions=['Osimhen’in pası ile bitirişinin arasındaki asist kaydı.','Jakobs, Sánchez ve Osimhen’in farklı görevleri.','Kazanım, iki pas, taşıma, ceza sahasına pas ve asist.'];
// The verified event taxonomy establishes a box pass, not the restart subtype.
const eventLabel=(event:{lab:string},goal:number,step:number)=>goal===1&&step===0?'Ceza sahasına pas':event.lab;
const sequences=data.goal_seqs.map((g,i)=>({...g,seq:g.seq.slice(i===0?-3:i===1?-3:1)}));
---
<div class="goal-anatomy">
{sequences.map((g,i)=><section class="goal-sequence" data-goal-sequence aria-labelledby={'goal-mechanism-'+i}>
<header><p class="p0-eyebrow">{i===0?'1–0':i===1?'2–0':'2–1'} / GOLÜN MEKANİK ANATOMİSİ</p><h3 id={'goal-mechanism-'+i}>{titles[i]}</h3><p>{descriptions[i]}</p></header>
<div class="goal-sequence__scene"><svg viewBox="-4 -5 113 80" role="group" aria-label={(i+1)+'. gol: kayıtlı olay noktaları; çizilmiş pas yolu yok'}>
<g class="sequence-pitch" fill="none" stroke="currentColor" stroke-width=".35"><path d="M0 0H105V68H0ZM52.5 0V68M0 13.84H16.5V54.16H0M105 13.84H88.5V54.16H105M0 24.84H5.5V43.16H0M105 24.84H99.5V43.16H105"/><circle cx="52.5" cy="34" r="9.15"/><circle cx="11" cy="34" r=".4"/><circle cx="94" cy="34" r=".4"/></g>
{g.seq.map((event,j)=><g class="sequence-point" data-sequence-point={j} tabindex="0" role="button" aria-label={`${j+1}. ${event.player}: ${eventLabel(event,i,j)}`} aria-pressed={j===0?'true':'false'} transform={`translate(${event.x},${68-event.y})`}><circle r="4.8" fill="transparent"/><circle class="sequence-marker" r="2.7"/><text text-anchor="middle" dominant-baseline="central" font-size="2.8">{j+1}</text></g>)}
<text x="0" y="75" fill="currentColor" font-size="2.7">{i===2?'← Fenerbahçe hücum yönü':'Galatasaray hücum yönü →'} · Noktalar olay yeridir; top yolu değildir.</text></svg>
<ol class="sequence-actions">{g.seq.map((event,j)=><li><button type="button" data-sequence-select={j} aria-pressed={j===0?'true':'false'}><span class="sequence-number">{j+1}</span><span><b>{event.player}</b><small>{eventLabel(event,i,j)}</small></span><span class="sequence-time">{Math.round(event.t-g.seq[g.seq.length-1].t)===0?'Gol':Math.round(event.t-g.seq[g.seq.length-1].t)+' sn'}</span></button></li>)}</ol></div><div class="sequence-step-controls" role="group" aria-label={(i+1)+'. golün olayları'}><button type="button" data-sequence-prev aria-label="Önceki olay" disabled>←</button><span data-sequence-counter role="status">1 / {g.seq.length}</span><button type="button" data-sequence-next aria-label="Sonraki olay">→</button></div>
<p class="evidence-caption">SportsBase · Numaralı olay konumları. Pas alıcıları ve oyuncu koşuları doğrulanmadı. <a href="#source-notes">Kaynak kaydı ↗</a></p>

</section>)}
</div>
<script>
for(const root of document.querySelectorAll<HTMLElement>('[data-goal-sequence]')){
 const track=root.querySelector<HTMLElement>('.sequence-actions')!,buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-sequence-select]')];let current=0;
 const prev=root.querySelector<HTMLButtonElement>('[data-sequence-prev]')!,next=root.querySelector<HTMLButtonElement>('[data-sequence-next]')!,counter=root.querySelector<HTMLElement>('[data-sequence-counter]')!;
 const select=(value:number,scroll=true)=>{current=Math.max(0,Math.min(buttons.length-1,value));for(const point of root.querySelectorAll<HTMLElement>('[data-sequence-point]'))point.setAttribute('aria-pressed',String(Number(point.dataset.sequencePoint)===current));buttons.forEach((button,i)=>button.setAttribute('aria-pressed',String(i===current)));prev.disabled=current===0;next.disabled=current===buttons.length-1;counter.textContent=(current+1)+' / '+buttons.length;if(scroll&&getComputedStyle(track).display==='flex')track.scrollTo({left:current*track.clientWidth,behavior:'instant'});};
 root.querySelectorAll<HTMLElement>('[data-sequence-select],[data-sequence-point]').forEach(el=>{const value=Number(el.dataset.sequenceSelect??el.dataset.sequencePoint);el.addEventListener('click',()=>select(value));if(el.hasAttribute('data-sequence-point'))el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();select(value);}});});
 prev.addEventListener('click',()=>select(current-1));next.addEventListener('click',()=>select(current+1));track.addEventListener('scroll',()=>{if(getComputedStyle(track).display==='flex'){const value=Math.round(track.scrollLeft/track.clientWidth);if(value!==current)select(value,false)}},{passive:true});
}
</script>
