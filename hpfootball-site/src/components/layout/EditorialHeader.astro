---
/** HPAnalytic porcelain editorial masthead. Standalone component; no route mutation. */
import Logo from '../Logo.astro';
interface Props { pathname?: string }
const { pathname = Astro.url.pathname } = Astro.props;
const items = [
  {label:'Atlaslar',href:'/visual-lab'},
  {label:'Analizler',href:'/analysis'},
  {label:'Metodoloji',href:'/research'},
];
---
<header class="hp-editorial-header">
  <div class="hp-editorial-header__inner">
    <Logo />
    <nav class="hp-editorial-header__nav" aria-label="Editoryal gezinme">
      {items.map(item => <a href={item.href} aria-current={pathname === item.href || pathname.startsWith(`${item.href}/`) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <div class="hp-editorial-header__actions"><slot /></div>
  </div>
</header>
<style>
  .hp-editorial-header{--hp-porcelain:#F5F1E8;--hp-forest:#234338;--hp-sage:#8EA58B;--hp-muted:#4A554E;position:sticky;top:0;z-index:50;background:var(--hp-porcelain);border-bottom:.5px solid rgba(142,165,139,.3);font-family:Archivo,system-ui,sans-serif}
  .hp-editorial-header__inner{max-width:1440px;margin-inline:auto;min-height:74px;padding:10px clamp(16px,4vw,60px);display:flex;align-items:center;justify-content:space-between;gap:24px}
  .hp-editorial-brand{display:inline-flex;align-items:center;gap:12px;min-width:0;color:var(--hp-forest);text-decoration:none}
  .hp-editorial-brand__mark{width:52px;height:52px;flex:none}
  .hp-editorial-brand__identity{display:flex;flex-direction:column;gap:3px;min-width:0}
  .hp-editorial-brand__wordmark{font-family:Newsreader,Georgia,serif;font-size:clamp(21px,2.1vw,29px);letter-spacing:-.035em;line-height:1.05;white-space:nowrap}
  .hp-editorial-brand__smallcaps{font-variant:small-caps;letter-spacing:.015em}
  .hp-editorial-brand__notation{font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:9px;letter-spacing:.13em;line-height:1.3;color:var(--hp-muted);white-space:nowrap}
  .hp-editorial-header__nav{display:flex;align-items:center;gap:clamp(14px,2.4vw,40px)}
  .hp-editorial-header__nav a{font-size:12px;letter-spacing:.055em;color:var(--hp-forest);text-decoration:none;text-underline-offset:6px}
  .hp-editorial-header__nav a:hover,.hp-editorial-header__nav a[aria-current='page']{text-decoration:underline;text-decoration-color:#C3A469;text-decoration-thickness:2px}
  .hp-editorial-header a:focus-visible{outline:2px solid #C3A469;outline-offset:4px}
  .hp-editorial-header__actions{display:flex;align-items:center;gap:12px}
  @media(max-width:600px){.hp-editorial-header__inner{gap:12px;flex-wrap:wrap}.hp-editorial-brand__mark{width:42px;height:42px}.hp-editorial-header__nav{width:100%;justify-content:space-between;padding-bottom:3px}.hp-editorial-header__nav a{font-size:11px}}
</style>
