---
interface Props {
  height?: number | string;
  class?: string;
  variant?: 'header' | 'footer' | 'default';
  showSubtitle?: boolean;
  withWordmark?: boolean;
}
const {
  height,
  class: className = '',
  variant = 'default',
  showSubtitle = true,
  withWordmark = true,
} = Astro.props as Props;
const logoStyle = height === undefined ? undefined : `--hp-logo-height: ${typeof height === 'number' ? `${height}px` : height}`;
---
<a href="/" class:list={['brand', 'hp-wordmark', className, `hp-wordmark--${variant}`]} style={logoStyle} aria-label="HPAnalytic ana sayfa" data-testid="brand-logo">
  <svg width="38" height="38" viewBox="0 0 100 100" fill="none" class="hpa-monogram-sigil brand-sigil hp-wordmark__emblem" data-testid="brand-logo-sigil" aria-hidden="true" focusable="false">
    <rect x="6" y="6" width="88" height="88" rx="12" stroke="#24303A" stroke-width="1.5" fill="#0E1317"/>
    <line x1="26" y1="26" x2="26" y2="74" stroke="#D4AF37" stroke-width="4.5" stroke-linecap="round"/>
    <line x1="26" y1="50" x2="52" y2="50" stroke="#D4AF37" stroke-width="3.5"/>
    <line x1="52" y1="26" x2="52" y2="74" stroke="#D4AF37" stroke-width="4.5" stroke-linecap="round"/>
    <path d="M 52 26 C 72 26, 72 50, 52 50" stroke="#D4AF37" stroke-width="4" fill="none" stroke-linecap="round"/>
    <line x1="52" y1="50" x2="76" y2="74" stroke="#00E676" stroke-width="4" stroke-linecap="round"/>
    <circle cx="52" cy="50" r="3" fill="#F3F5F7"/>
  </svg>
  {withWordmark && <span class="hp-wordmark__identity">
    <span class="hp-wordmark__name"><span class="hp-wordmark__hp">HP</span><span class="hp-wordmark__small">Analytic</span></span>
    {showSubtitle && <span class="hp-wordmark__tag">HIKMET PINARBAŞ FOOTBALL LAB</span>}
  </span>}
</a>
<style>
.hp-wordmark{display:inline-flex;flex-flow:row nowrap;align-items:center;justify-content:flex-start;gap:12px;min-width:0;max-width:100%;text-decoration:none;color:#F3F5F7;line-height:1.1}
.brand-sigil{width:38px;height:38px;flex:none;display:block}
.hp-wordmark__identity{display:flex;flex-direction:column;justify-content:center;gap:4px;min-width:0}
.hp-wordmark__name{display:block;font:400 clamp(23px,2.5vw,34px)/1 Newsreader,Georgia,serif;letter-spacing:-.035em;white-space:nowrap;color:#F3F5F7}
.hp-wordmark__hp{font-style:normal;color:#F3F5F7}
.hp-wordmark__small{font-style:italic;font-variant:normal;letter-spacing:-.015em;color:#D4AF37}
.hp-wordmark__tag{display:block;font:500 8.5px/1.4 "IBM Plex Mono",ui-monospace,monospace;letter-spacing:.25em;color:#9BA8B3;max-width:38ch}
@media(max-width:420px){.hp-wordmark{gap:8px}.hp-wordmark__name{font-size:23px}.hp-wordmark__tag{font-size:8.5px;letter-spacing:.08em;max-width:24ch}}
</style>
