---
interface Props {
  height?: number | string;
  class?: string;
  variant?: 'header' | 'footer' | 'default';
  showSubtitle?: boolean;
  withWordmark?: boolean;
}
const {
  height,
  class: className = '',
  variant = 'default',
  showSubtitle = true,
  withWordmark = true,
} = Astro.props as Props;
const logoStyle = height === undefined ? undefined : `--hp-logo-height: ${typeof height === 'number' ? `${height}px` : height}`;

---
<a href="/" class:list={['brand', 'hp-wordmark', className, `hp-wordmark--${variant}`]} style={logoStyle} aria-label="HPAnalytic ana sayfa">
  <svg class="hp-wordmark__emblem" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4" stroke="#00E676"/><line x1="12" y1="3" x2="12" y2="21" stroke-dasharray="2 2"/><line x1="3" y1="12" x2="21" y2="12" stroke-dasharray="2 2"/></svg>
  <span class="hp-wordmark__name">HP<span class="hp-wordmark__small">Analytic</span></span>
  {withWordmark && showSubtitle && <span class="hp-wordmark__tag">EVIDENCE LAB · SPATIOTEMPORAL INTELLIGENCE</span>}
</a>
<style>
.hp-wordmark{display:inline-flex;flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:center;text-decoration:none;color:var(--ink-primary,#F3F5F7);gap:3px}
.hp-wordmark__emblem{flex:none;margin-right:7px}.hp-wordmark__name{font:400 clamp(23px,2.5vw,34px)/1.05 Newsreader,Georgia,serif;letter-spacing:-.035em}
.hp-wordmark__small{font-variant:small-caps;letter-spacing:.015em}
.hp-wordmark__tag{flex-basis:100%;padding-left:31px;font:400 9px/1.5 "IBM Plex Mono",monospace;letter-spacing:.1em;color:var(--ink-secondary,#9BA8B3)}
</style>
