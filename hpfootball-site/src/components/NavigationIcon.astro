---
interface Props { href: string; }
const { href } = Astro.props;
const kind = href.includes('method') || href.includes('metod') ? 'method' : href.includes('research') || href.includes('arast') ? 'research' : href.includes('visual') || href.includes('gorsel') ? 'visual' : href.includes('about') || href.includes('hakk') ? 'about' : 'analysis';
---
<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
{kind === 'analysis' && <><path d="M4 19V5M4 19h16M8 15l4-5 3 2 5-7"/><circle cx="20" cy="5" r="1.4"/></>}
{kind === 'research' && <><circle cx="6" cy="8" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="16" cy="18" r="2"/><path d="M8 7.7l8-1.2M7.3 9.8l7.4 6.5M18 8v8"/></>}
{kind === 'visual' && <><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 12h18M12 4v16M6 8l2-2 2 2M15 16l2-2 2 2"/></>}
{kind === 'method' && <><path d="M7 3h8l4 4v14H7zM15 3v5h4M10 12h6M10 16h6"/><path d="M4 7v14"/></>}
{kind === 'about' && <><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.2"/></>}
</svg>
