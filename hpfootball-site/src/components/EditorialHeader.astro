---
import Logo from './Logo.astro';
import { SITE_MENU } from '../lib/site-menu.mjs';
import { featuredMatch } from '../data/match-previews.mjs';
interface Props { navigation?: {label:string;href:string;current?:string}[] }
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
  const target = href.replace(/\/+$/, '') || '/';
  return path === target || (target !== '/' && path.startsWith(target + '/'));
};
const latest = featuredMatch();
---
<header class="site-header editorial-header">
  <div class="site-header__inner header-container">
    <div class="site-header__brand brand-col"><Logo variant="header" /></div>
    <nav class="site-header__nav nav-links desktop-nav" aria-label="Ana Navigasyon">
      <ul class="mainnav">
        {SITE_MENU.map((group, i) => group.items ? (
          <li data-menu>
            <button type="button" class:list={['mainnav__toggle', { 'is-current': group.items.some((x) => isCurrent(x.href)) }]} aria-expanded="false" aria-controls={`megamenu-${i}`}>
              {group.label}
              <svg viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
            </button>
            <a class="mainnav__link mainnav__fallback" href={group.href}>{group.label}</a>
            <div class="megamenu" id={`megamenu-${i}`} hidden>
              <div class="megamenu__intro"><b>{group.intro.title}</b><span>{group.intro.text}</span></div>
              {group.items.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}><b>{item.label}</b><small>{item.text}</small></a>)}
            </div>
          </li>
        ) : (
          <li><a class="mainnav__link nav-item" href={group.href} aria-current={isCurrent(group.href) ? 'page' : undefined}>{group.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="site-header__actions editorial-actions">
      <form class="search-form-mini" action="/search" method="get" role="search"><button type="submit" class="search-trigger" aria-label="Site içi ara" data-search-open><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7.5"/><line x1="20.5" y1="20.5" x2="16.4" y2="16.4"/></svg></button></form>
      {latest && <a class="header-cta" href={latest.href}>MAÇ ÖNÜ</a>}
      <slot />
    </div>
  </div>
</header>
<script>
  const menus = document.querySelectorAll<HTMLElement>('[data-menu]');
  const closeAll = (except?: HTMLElement) => {
    menus.forEach((m) => {
      if (m === except) return;
      m.querySelector('.mainnav__toggle')?.setAttribute('aria-expanded', 'false');
      const panel = m.querySelector<HTMLElement>('.megamenu');
      if (panel) panel.hidden = true;
    });
  };
  menus.forEach((menu) => {
    const toggle = menu.querySelector<HTMLButtonElement>('.mainnav__toggle');
    const panel = menu.querySelector<HTMLElement>('.megamenu');
    if (!toggle || !panel) return;
    let timer: number | undefined;
    const open = () => { closeAll(menu); toggle.setAttribute('aria-expanded', 'true'); panel.hidden = false; };
    const close = () => { toggle.setAttribute('aria-expanded', 'false'); panel.hidden = true; };
    toggle.addEventListener('click', () => (toggle.getAttribute('aria-expanded') === 'true' ? close() : open()));
    menu.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') { window.clearTimeout(timer); open(); } });
    menu.addEventListener('pointerleave', (e) => { if ((e as PointerEvent).pointerType === 'mouse') timer = window.setTimeout(close, 160); });
    menu.addEventListener('focusout', (e) => { const next = (e as FocusEvent).relatedTarget; if (!(next instanceof Node) || !menu.contains(next)) close(); });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openToggle = document.querySelector<HTMLButtonElement>('.mainnav__toggle[aria-expanded="true"]');
    closeAll();
    openToggle?.focus();
  });
  document.addEventListener('pointerdown', (e) => { if (!(e.target instanceof Element) || !e.target.closest('[data-menu]')) closeAll(); });
</script>
