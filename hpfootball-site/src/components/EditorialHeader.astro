---
import Logo from './Logo.astro';
interface Props { navigation?: {label:string;href:string;current?:string}[] }
const { navigation = [
 {label:'Analizler',href:'/analysis/'},
 {label:'Metodoloji',href:'/research/'},
 {label:'Hakkımda',href:'/about/'},
 {label:'Arşiv',href:'/archive/'}
] } = Astro.props;

---
<header class="editorial-header">
  <div class="header-container">
    <div class="brand-col"><Logo height={38} /></div>
    <nav class="nav-links" aria-label="Ana Navigasyon">
      {navigation.map((link,i) => <>{i > 0 && <span class="nav-sep" aria-hidden="true">·</span>}<a href={link.href} class="nav-item" aria-current={(link.current || Astro.url.pathname.replace(/\/$/,'')===link.href.replace(/\/$/,''))?'page':undefined}>{link.label}</a></>)}
    </nav>
    <div class="edition-col"><span class="edition-stamp">EST. 2026 · V2.0</span></div>
    <div class="editorial-actions"><button type="button" class="search-trigger" aria-label="Site içi ara" data-search-open onclick="window.location.assign('/search')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button><slot /></div>
  </div>
</header>
<style>
  .editorial-header{position:sticky;top:0;z-index:50;min-height:56px;background:#0B0F12ee;backdrop-filter:blur(12px);border-bottom:.5px solid #24303A;display:flex;align-items:center}
  .header-container{width:100%;max-width:1440px;margin:0 auto;padding:8px 28px;display:flex;align-items:center;justify-content:space-between;gap:18px}
  .brand-col,.edition-col,.editorial-actions{display:flex;align-items:center}
  .brand-col :global(a.hp-wordmark){line-height:0}
  .editorial-actions{gap:12px}
  .nav-links{display:flex;align-items:center;gap:14px;font-family:var(--serif,Newsreader,Georgia,serif);font-size:15px;letter-spacing:-.01em}
  .nav-item{color:var(--ink-secondary,#9BA8B3);text-decoration:none;position:relative;padding:4px 0;transition:color .15s ease}
  .nav-item:hover,.nav-item[aria-current=page]{color:var(--ink-primary,#F3F5F7);text-decoration:underline;text-decoration-color:#D4AF37;text-underline-offset:5px}
  .nav-sep{color:#657481;font-size:13px;user-select:none}
  .edition-stamp{font:600 9.5px var(--mono,monospace);letter-spacing:.15em;color:var(--accent-gold,#D4AF37);padding:3px 8px;border:.5px solid rgba(212,175,55,.35);border-radius:2px;white-space:nowrap}
  .search-trigger{border:0;background:transparent;color:var(--ink-primary,#F3F5F7);padding:10px;min-width:44px;min-height:44px;cursor:pointer}
  .search-trigger:focus-visible{outline:2px solid #00E676;outline-offset:3px}
  a:focus-visible{outline:2px solid #00E676;outline-offset:3px}
  @media(max-width:900px){.edition-col{display:none}.nav-links{display:none !important}.header-container{flex-wrap:nowrap;padding:6px 16px}.editorial-actions{margin-left:auto}}
  @media(max-width:767px){.header-container{padding:6px 16px;flex-wrap:nowrap}.nav-links{display:none !important}.editorial-actions{margin-left:auto}}
</style>
