---
interface NavigationItem {
  href: string;
  label: string;
  current?: 'page' | 'true';
}

interface Props {
  navigation?: NavigationItem[];
}

const { navigation = [] } = Astro.props as Props;
---

<div class="mobile-navigation" data-mobile-nav>
  <button
    class="mobile-nav-trigger"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-nav-panel"

  >
    <span>MENU</span>
    <span class="mobile-nav-trigger-mark" aria-hidden="true"></span>
  </button>

  <nav id="mobile-nav-panel" class="mobile-nav-panel" aria-label="Mobil ana menü" hidden>
    {navigation.map((item,index) => (
      <a href={item.href} aria-current={item.current}><span class="mobile-nav-index">{String(index+1).padStart(2,'0')}</span><span>{['Analizler & Monografiler','Spatiotemporal Metodoloji','Laboratuvar Manifestosu (Hakkımda)','Arşiv & Turnuva Atlası'][index] ?? item.label}</span></a>
    ))}
  </nav>
</div>

<script>
  import { nextMobileMenuState } from '../lib/mobile-nav-state.mjs';

  const roots = document.querySelectorAll('[data-mobile-nav]');
  const desktop = window.matchMedia('(min-width: 901px)');

  for (const root of roots) {
    const trigger = root.querySelector('.mobile-nav-trigger');
    const panel = root.querySelector('.mobile-nav-panel');

    if (!(trigger instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) continue;

    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };
    const dispatch = (event: string) => {
      if (!isOpen()) return;
      setOpen(nextMobileMenuState(true, event));
    };

    trigger.addEventListener('click', () => {
      setOpen(nextMobileMenuState(isOpen(), 'trigger'));
    });

    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) dispatch('navigate');
    });

    // Non-modal disclosure: leaving the menu closes it instead of trapping focus.
    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !root.contains(event.target)) dispatch('outside');
    });

    root.addEventListener('focusout', (event) => {
      const next = (event as FocusEvent).relatedTarget;
      if (next instanceof Node && !root.contains(next)) dispatch('focusout');
    });

    desktop.addEventListener('change', (event) => {
      if (event.matches) dispatch('desktop');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !isOpen()) return;
      setOpen(nextMobileMenuState(true, 'escape'));
      trigger.focus();
    });
  }
</script>

<style>
@media(max-width:900px){
  .mobile-nav-panel:not([hidden]){position:fixed;inset:56px 0 0 !important;width:100vw;height:calc(100dvh - 56px);background:#07090B !important;overflow:auto;animation:hp-drawer-in .25s cubic-bezier(.2,.8,.2,1) both;z-index:90}
  .mobile-nav-panel a{display:flex;align-items:center;gap:20px;border-bottom:1px solid #1E293B;color:#F3F5F7;font-size:clamp(1rem,4vw,1.35rem)}
  .mobile-nav-index{font:600 .8rem ui-monospace,monospace;color:#D4AF37}
}
@keyframes hp-drawer-in{from{transform:translateX(100%);opacity:.7}to{transform:translateX(0);opacity:1}}
@media(prefers-reduced-motion:reduce){.mobile-nav-panel:not([hidden]){animation:none}}
</style>
