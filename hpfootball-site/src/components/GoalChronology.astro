---
import {actorName,actionLabel} from '../lib/derby-labels.mjs';
import evidence from '../../public/mac/galatasaray-fenerbahce-2026-10-26-mac-sonu/evidence.json';
const goals=evidence.goals;
---
<div class="goal-chronologies">
 {goals.map((goal,i)=><details class="goal-story" id={'goal-story-'+i} open={i===0} data-goal-story>
  <summary><span class="goal-story__index">0{i+1}</span><span><b>{actorName(goal.scorer)}</b><small>{goal.team==='Galatasaray'?'Galatasaray':'Fenerbahçe'} · {i===0?'1–0':i===1?'2–0':'2–1'}</small></span><span aria-hidden="true">＋</span></summary>
  <div class="goal-story__body">
   <p class="goal-story__scope">Aşağıdaki sıra, gol çevresindeki kaynak kayıtlarını gösterir. Pas alıcısı ve kesintisiz sahiplik doğrulanmadığı için olaylar bir pas zinciriyle birleştirilmez.</p>
   <div class="goal-playback" data-goal-playback>
    <div class="goal-playback__controls">
     <button type="button" data-goal-prev aria-label={i+1+'. golün önceki kaydı'}>←</button>
     <button type="button" data-goal-play aria-pressed="false">Kayıtları oynat</button>
     <button type="button" data-goal-next aria-label={i+1+'. golün sonraki kaydı'}>→</button>
    </div>
    <label for={'goal-position-'+i}>İncelenen kayıt</label>
    <input id={'goal-position-'+i} type="range" min="0" max={goal.action_chronology.length-1} value="0" step="1" data-goal-position />
    <p class="goal-playback__status" data-goal-status role="status">Kayıtları okuyun veya incelemek istediğiniz olayı seçin.</p>
    <ol class="goal-records">
     {goal.action_chronology.map((record,j)=><li data-goal-record data-record-label={actorName(record.actor)+' · '+record.action_labels.map(actionLabel).join(' / ')} aria-current={j===0?'step':undefined}>
      <span class="goal-records__offset">{record.offset_to_goal_s===0?'Gol':record.offset_to_goal_s+' sn'}</span>
      <div><b>{actorName(record.actor)}</b><p>{record.action_labels.map(actionLabel).join(' · ')}</p><details><summary>Kaydı incele</summary><p>{record.event_key} · kaynak kimlikleri: {record.source_ids.join(', ')}</p></details></div>
     </li>)}
    </ol>
   </div>
  </div>
 </details>)}
</div>
<script>
 import {nextPlayback} from '../lib/goal-playback.mjs';
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 for(const root of document.querySelectorAll<HTMLElement>('[data-goal-playback]')){
  const records=[...root.querySelectorAll<HTMLElement>('[data-goal-record]')];
  const slider=root.querySelector<HTMLInputElement>('[data-goal-position]')!;
  const play=root.querySelector<HTMLButtonElement>('[data-goal-play]')!;
  const status=root.querySelector<HTMLElement>('[data-goal-status]')!;
  let state={index:0,playing:false};let timer:number|undefined;
  const render=()=>{
   window.clearInterval(timer);
   records.forEach((record,i)=>{if(i===state.index)record.setAttribute('aria-current','step');else record.removeAttribute('aria-current');});
   slider.value=String(state.index);
   slider.setAttribute('aria-valuetext',records[state.index].dataset.recordLabel||'');
   play.textContent=state.playing?'Durdur':'Kayıtları oynat';play.setAttribute('aria-pressed',String(state.playing));
   status.setAttribute('aria-live',state.playing?'off':'polite');
   status.textContent=(state.index+1)+' / '+records.length+' · '+records[state.index].dataset.recordLabel;
   if(state.playing)timer=window.setInterval(()=>dispatch({type:'tick'}),1200);
  };
  const dispatch=(event:{type:string;index?:number;reduced?:boolean})=>{state=nextPlayback(state,event,records.length);render();};
  play.addEventListener('click',()=>dispatch({type:state.playing?'pause':'play',reduced:reduced.matches||document.documentElement.dataset.motion==='paused'}));
  root.querySelector('[data-goal-prev]')?.addEventListener('click',()=>dispatch({type:'select',index:state.index-1}));
  root.querySelector('[data-goal-next]')?.addEventListener('click',()=>dispatch({type:'select',index:state.index+1}));
  slider.addEventListener('input',()=>dispatch({type:'select',index:Number(slider.value)}));
  document.addEventListener('hpa:motionchange',()=>dispatch({type:'pause'}));
  document.addEventListener('visibilitychange',()=>{if(document.hidden)dispatch({type:'hidden'});});
  reduced.addEventListener('change',()=>{if(reduced.matches)dispatch({type:'reduced'});});
  root.closest('details')?.addEventListener('toggle',event=>{if(!(event.currentTarget as HTMLDetailsElement).open)dispatch({type:'pause'});});
  render();
 }
</script>
