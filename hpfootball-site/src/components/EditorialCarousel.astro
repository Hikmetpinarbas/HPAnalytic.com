---
interface Item { title: string; href: string; eyebrow?: string; description?: string; }
interface Props { items: Item[]; title?: string; label?: string; }
const {items=[],title='Seçili analizler',label='Editoryal analiz seçkisi'}=Astro.props;
---
{items.length>0 && <section class="hpa-carousel" aria-label={label} data-editorial-carousel>
  <div class="hpa-carousel__head">
    <h2>{title}</h2>
    <div class="hpa-carousel__controls">
      <button type="button" aria-label="Önceki içerikler" data-carousel-prev disabled>←</button>
      <button type="button" aria-label="Sonraki içerikler" data-carousel-next disabled>→</button>
    </div>
  </div>
  <div class="hpa-carousel__track" data-carousel-track tabindex="0" aria-label={label}>
    {items.map((item,index)=> <article class="hpa-carousel__card">
      {item.eyebrow && <p class="hpa-carousel__eyebrow">{item.eyebrow}</p>}
      <h3><a href={item.href}>{item.title}<span aria-hidden="true"> ↗</span></a></h3>
      {item.description && <p class="hpa-carousel__description">{item.description}</p>}
      <span class="hpa-carousel__index" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>
    </article>)}
  </div>
</section>}
<script>
  for(const root of document.querySelectorAll<HTMLElement>('[data-editorial-carousel]')){
    const track=root.querySelector<HTMLElement>('[data-carousel-track]');
    const prev=root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next=root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if(!track||!prev||!next)continue;
    const reduce=window.matchMedia('(prefers-reduced-motion: reduce)');
    const update=()=>{
      prev.disabled=track.scrollLeft<=1;
      next.disabled=track.scrollLeft+track.clientWidth>=track.scrollWidth-2;
    };
    const move=(dir:number)=>{
      const card=track.querySelector<HTMLElement>('.hpa-carousel__card');
      const gap=parseFloat(getComputedStyle(track).columnGap)||0;
      track.scrollBy({left:dir*((card?.getBoundingClientRect().width||track.clientWidth)+gap),behavior:reduce.matches?'instant':'smooth'});
    };
    prev.addEventListener('click',()=>move(-1));
    next.addEventListener('click',()=>move(1));
    track.addEventListener('scroll',update,{passive:true});
    track.addEventListener('keydown',e=>{
      if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();move(e.key==='ArrowRight'?1:-1);}
    });
    new ResizeObserver(update).observe(track);
    requestAnimationFrame(update);
  }
</script>
<style>
.hpa-carousel{max-width:1280px;margin:clamp(24px,4vw,60px) auto;padding:0 max(16px,env(safe-area-inset-left,0px))}
.hpa-carousel__head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px}
.hpa-carousel__head h2{font:700 clamp(1.25rem,3vw,2rem)/1.2 var(--display,system-ui);color:var(--ink,#f2eee6);margin:0}
.hpa-carousel__controls{display:flex;gap:8px}
.hpa-carousel__controls button{width:44px;height:44px;border:1px solid var(--line-2,#49515a);border-radius:4px;background:var(--panel,#181c22);color:var(--ink,#f2eee6);font-size:1.25rem;cursor:pointer}
.hpa-carousel__controls button:disabled{opacity:.38;cursor:default}
.hpa-carousel__controls button:hover:not(:disabled){border-color:var(--amber,#f2a33a);background:var(--panel-2,#222832)}
.hpa-carousel :focus-visible{outline:3px solid var(--focus,#ffd08a);outline-offset:3px}
.hpa-carousel__track{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(260px,calc((100% - 36px)/3));gap:18px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scroll-padding-inline:2px;scrollbar-width:thin;padding:3px 3px 15px}
.hpa-carousel__card{scroll-snap-align:start;position:relative;display:flex;flex-direction:column;min-height:220px;padding:24px;border:1px solid var(--line,#343a42);background:var(--panel,#181c22);border-radius:5px;transition:transform .18s ease,border-color .18s ease}
.hpa-carousel__card:hover,.hpa-carousel__card:focus-within{border-color:var(--amber,#f2a33a);transform:translateY(-2px)}
.hpa-carousel__eyebrow{font:.7rem var(--mono,monospace);letter-spacing:.08em;text-transform:uppercase;color:var(--amber,#f2a33a)}
.hpa-carousel__card h3{font:700 clamp(1.15rem,2vw,1.5rem)/1.2 var(--display,system-ui);margin:14px 0}
.hpa-carousel__card h3 a{color:var(--ink,#f2eee6);text-decoration:none}
.hpa-carousel__card h3 a:after{content:"";position:absolute;inset:0}
.hpa-carousel__description{color:var(--ink-2,#d9d3c7);line-height:1.5;font-size:.91rem}
.hpa-carousel__index{margin-top:auto;align-self:end;color:var(--muted,#aba59a);font:.8rem var(--mono,monospace)}
@media(max-width:950px){.hpa-carousel__track{grid-auto-columns:minmax(240px,calc((100% - 18px)/2))}}
@media(max-width:560px){.hpa-carousel__track{grid-auto-columns:minmax(235px,84%)}}
@media(prefers-reduced-motion:reduce){.hpa-carousel__card{transition:none}.hpa-carousel__card:hover,.hpa-carousel__card:focus-within{transform:none}}
</style>
