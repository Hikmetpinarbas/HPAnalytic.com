---
import { isPublic } from '../lib/public-content.mjs';
import { isPublicEditorialItem } from '../lib/site-editorial-status.mjs';
import { getCollection } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
interface Props { section: 'analysis' | 'scouting' | 'culture' | 'method'; headingLevel?: 2 | 3; }
const { section, headingLevel = 2 } = Astro.props as Props;
const items = (await getCollection('articles', isPublic))
  .filter((a) => isPublicEditorialItem(a.data) && a.data.section === section)
  .sort((a, b) => +b.data.date - +a.data.date);
---
{items.length > 0 ? (
  <ul class="card-grid">
    {items.map((a) => <li><ArticleCard id={a.id} {...a.data} headingLevel={headingLevel} /></li>)}
  </ul>
) : (
  <p class="empty-state">Bu bölümde henüz yayımlanmış yazı yok.</p>
)}
