---
import { getCollection } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
interface Props { section: 'analysis' | 'scouting' | 'culture' | 'method'; headingLevel?: 2 | 3; }
const { section, headingLevel = 2 } = Astro.props as Props;
const items = (await getCollection('articles'))
  .filter((a) => a.data.section === section)
  .sort((a, b) => +b.data.date - +a.data.date);
---
{items.length > 0 ? (
  <ul class="card-grid">
    {items.map((a) => <li><ArticleCard id={a.id} {...a.data} headingLevel={headingLevel} /></li>)}
  </ul>
) : (
  <p class="empty-state">Bu yüzeyde henüz yayımlanmış içerik yok. Boş yüzey navigasyonda gösterilmez.</p>
)}
